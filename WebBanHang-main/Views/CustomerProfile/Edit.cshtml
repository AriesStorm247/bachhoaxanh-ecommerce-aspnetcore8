@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openOAuthPopup(url) {
            const width = 500;
            const height = 650;
            const left = (window.innerWidth - width) / 2 + window.screenX;
            const top = (window.innerHeight - height) / 2 + window.screenY;
            
            window.isRedirecting = false;
            const popup = window.open(
                url,
                'OAuthPopup',
                `width=${width},height=${height},top=${top},left=${left},resizable=yes,scrollbars=yes,status=yes`
            );
            
            const timer = setInterval(() => {
                if (!popup || popup.closed) {
                    clearInterval(timer);
                    if (!window.isRedirecting) {
                        window.location.reload();
                    }
                }
            }, 1000);
        }

        const avatarInput = document.getElementById('avatarInput');
        const avatarPreview = document.getElementById('avatarPreview');
        avatarInput?.addEventListener('input', () => {
            const url = avatarInput.value.trim();
            avatarPreview.innerHTML = url
                ? `<img src="${url}" alt="Avatar" onerror="this.parentElement.innerHTML='<i class=&quot;bi bi-person-fill&quot;></i>'" />`
                : '<i class="bi bi-person-fill"></i>';
        });

        // Toggle sections
        const btnToggleProfile = document.getElementById('btnToggleProfile');
        const btnToggleStore = document.getElementById('btnToggleStore');
        const btnToggleAchievement = document.getElementById('btnToggleAchievement');
        const btnToggleInventory = document.getElementById('btnToggleInventory');
        const btnToggleOrderHistory = document.getElementById('btnToggleOrderHistory');
        const btnToggleAiChatHistory = document.getElementById('btnToggleAiChatHistory');
        
        const profileEditSection = document.getElementById('profileEditSection');
        const voucherStoreSection = document.getElementById('voucherStoreSection');
        const achievementSection = document.getElementById('achievementSection');
        const personalInventorySection = document.getElementById('personalInventorySection');
        const orderHistorySection = document.getElementById('orderHistorySection');
        const aiChatHistorySection = document.getElementById('aiChatHistorySection');

        function setButtonActive(btn, isActive, activeClass, inactiveClass, textClass = 'text-white') {
            if (!btn) return;
            if (isActive) {
                btn.classList.remove(inactiveClass);
                btn.classList.add(activeClass);
                if (textClass) {
                    btn.classList.add(textClass);
                }
            } else {
                btn.classList.remove(activeClass);
                if (textClass) {
                    btn.classList.remove(textClass);
                }
                btn.classList.add(inactiveClass);
            }
        }

        function showMainSection(sectionName, scroll = false) {
            // Hide all first
            profileEditSection?.classList.add('d-none');
            voucherStoreSection?.classList.add('d-none');
            achievementSection?.classList.add('d-none');
            personalInventorySection?.classList.add('d-none');
            orderHistorySection?.classList.add('d-none');
            aiChatHistorySection?.classList.add('d-none');

            // Set all buttons to inactive first
            setButtonActive(btnToggleProfile, false, 'btn-secondary', 'btn-outline-secondary', 'text-white');
            setButtonActive(btnToggleStore, false, 'btn-danger', 'btn-outline-danger', 'text-white');
            setButtonActive(btnToggleAchievement, false, 'btn-warning', 'btn-outline-warning', 'text-dark');
            setButtonActive(btnToggleInventory, false, 'btn-success', 'btn-outline-success', 'text-white');
            setButtonActive(btnToggleOrderHistory, false, 'btn-info', 'btn-outline-info', 'text-white');
            setButtonActive(btnToggleAiChatHistory, false, 'btn-primary', 'btn-outline-primary', 'text-white');

            if (sectionName === 'store') {
                voucherStoreSection?.classList.remove('d-none');
                setButtonActive(btnToggleStore, true, 'btn-danger', 'btn-outline-danger', 'text-white');
                sessionStorage.setItem('activeSection', 'store');
            } else if (sectionName === 'achievement') {
                achievementSection?.classList.remove('d-none');
                setButtonActive(btnToggleAchievement, true, 'btn-warning', 'btn-outline-warning', 'text-dark');
                sessionStorage.setItem('activeSection', 'achievement');
            } else if (sectionName === 'inventory') {
                personalInventorySection?.classList.remove('d-none');
                setButtonActive(btnToggleInventory, true, 'btn-success', 'btn-outline-success', 'text-white');
                sessionStorage.setItem('activeSection', 'inventory');
            } else if (sectionName === 'history' || sectionName === 'orders') {
                orderHistorySection?.classList.remove('d-none');
                setButtonActive(btnToggleOrderHistory, true, 'btn-info', 'btn-outline-info', 'text-white');
                sessionStorage.setItem('activeSection', 'history');
            } else if (sectionName === 'aichat') {
                aiChatHistorySection?.classList.remove('d-none');
                setButtonActive(btnToggleAiChatHistory, true, 'btn-primary', 'btn-outline-primary', 'text-white');
                sessionStorage.setItem('activeSection', 'aichat');
            } else {
                profileEditSection?.classList.remove('d-none');
                setButtonActive(btnToggleProfile, true, 'btn-secondary', 'btn-outline-secondary', 'text-white');
                sessionStorage.setItem('activeSection', 'profile');
            }
        }

        btnToggleProfile?.addEventListener('click', () => showMainSection('profile'));
        btnToggleStore?.addEventListener('click', () => showMainSection('store'));
        btnToggleAchievement?.addEventListener('click', () => showMainSection('achievement'));
        btnToggleInventory?.addEventListener('click', () => showMainSection('inventory'));
        btnToggleOrderHistory?.addEventListener('click', () => showMainSection('history'));
        btnToggleAiChatHistory?.addEventListener('click', () => showMainSection('aichat'));



        window.toggleOrderDetail = function (orderId) {
            const detailBlock = document.getElementById(`detail-${orderId}`);
            const chevron = document.getElementById(`chevron-${orderId}`);
            if (detailBlock) {
                if (detailBlock.classList.contains('d-none')) {
                    detailBlock.classList.remove('d-none');
                    chevron?.classList.remove('bi-chevron-down');
                    chevron?.classList.add('bi-chevron-up');
                } else {
                    detailBlock.classList.add('d-none');
                    chevron?.classList.remove('bi-chevron-up');
                    chevron?.classList.add('bi-chevron-down');
                }
            }
        };

        // Switch store sub-panels
        window.switchStoreSub = function (tab) {
            // Hide all sub-panels
            document.querySelectorAll('.store-sub-panel').forEach(panel => {
                panel.classList.add('d-none');
            });
            // Show target sub-panel
            const targetPanel = document.getElementById(`storeSub-${tab}`);
            if (targetPanel) {
                targetPanel.classList.remove('d-none');
            }

            // Update sub-tab buttons active state
            document.querySelectorAll('.store-sub-btn').forEach(btn => {
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
            });

            let btnId = '';
            if (tab === 'tier') btnId = 'btnSubTierVoucher';
            else if (tab === 'daily') btnId = 'btnSubDailyVoucher';
            else if (tab === 'frame') btnId = 'btnSubAvatarFrame';


            const activeBtn = document.getElementById(btnId);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-success');
                activeBtn.classList.add('btn-success');
            }

            sessionStorage.setItem('activeSubStore', tab);
        };

        // Switch inventory sub-panels
        window.switchInvSub = function (tab) {
            // Hide all sub-panels
            document.querySelectorAll('.inv-sub-panel').forEach(panel => {
                panel.classList.add('d-none');
            });
            // Show target sub-panel
            const targetPanel = document.getElementById(`invSub-${tab}`);
            if (targetPanel) {
                targetPanel.classList.remove('d-none');
            }

            // Update sub-tab buttons active state
            document.querySelectorAll('.inv-sub-btn').forEach(btn => {
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
            });

            let btnId = '';
            if (tab === 'voucher') btnId = 'btnInvVoucher';
            else if (tab === 'frame') btnId = 'btnInvFrame';
            else if (tab === 'badge') btnId = 'btnInvBadge';


            const activeBtn = document.getElementById(btnId);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-success');
                activeBtn.classList.add('btn-success');
            }

            sessionStorage.setItem('activeSubInventory', tab);
        };

        // Switch frame sub-panels in store
        window.switchFrameSub = function (tab) {
            // Hide all frame panels inside storeSub-frame
            document.querySelectorAll('#storeSub-frame .frame-sub-panel').forEach(panel => {
                panel.classList.add('d-none');
            });
            // Show target panel
            const targetPanel = document.getElementById(`framePanel-${tab}`);
            if (targetPanel) {
                targetPanel.classList.remove('d-none');
            }

            // Update sub-tab buttons active state
            document.querySelectorAll('.frame-sub-btn').forEach(btn => {
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
            });

            let btnId = '';
            if (tab === 'tier') btnId = 'btnFrameSubTier';
            else if (tab === 'daily') btnId = 'btnFrameSubDaily';

            const activeBtn = document.getElementById(btnId);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-success');
                activeBtn.classList.add('btn-success');
            }

            sessionStorage.setItem('activeSubFrameStore', tab);
        };

        // Switch owned frame category panels in inventory
        window.switchOwnedFrameCategory = function (category) {
            // Hide all owned frame category panels
            document.querySelectorAll('#invSub-frame .owned-frame-sub-panel').forEach(panel => {
                panel.classList.add('d-none');
            });
            // Show target panel
            const targetPanel = document.getElementById(`ownedFramePanel-${category}`);
            if (targetPanel) {
                targetPanel.classList.remove('d-none');
            }

            // Update sub-tab buttons active state
            document.querySelectorAll('.owned-frame-sub-btn').forEach(btn => {
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
            });

            let btnId = '';
            if (category === 'tier') btnId = 'btnOwnedFrameTier';
            else if (category === 'normal') btnId = 'btnOwnedFrameNormal';
            else if (category === 'limited') btnId = 'btnOwnedFrameLimited';


            const activeBtn = document.getElementById(btnId);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline-success');
                activeBtn.classList.add('btn-success');
            }

            sessionStorage.setItem('activeOwnedFrameCategory', category);
        };

        // Restore active states on DOM load
        document.addEventListener('DOMContentLoaded', () => {
            // Priority: URL Query String > TempData (from backend redirects) > SessionStorage
            const urlParams = new URLSearchParams(window.location.search);
            const querySection = urlParams.get('activeSection');
            const querySubStore = urlParams.get('activeSubStore');
            const querySubInventory = urlParams.get('activeSubInventory');

            const tempDataSection = '@(TempData["ActiveSection"] ?? "")';
            const tempDataSubStore = '@(TempData["ActiveSubStore"] ?? "")';
            const tempDataSubInventory = '@(TempData["ActiveSubInventory"] ?? "")';
            const tempDataSubFrameStore = '@(TempData["ActiveSubFrameStore"] ?? "")';

            let activeSection = querySection || tempDataSection || sessionStorage.getItem('activeSection') || 'store';
            let activeSubStore = querySubStore || tempDataSubStore || sessionStorage.getItem('activeSubStore') || 'tier';
            let activeSubInventory = querySubInventory || tempDataSubInventory || sessionStorage.getItem('activeSubInventory') || 'voucher';
            let activeSubFrameStore = tempDataSubFrameStore || sessionStorage.getItem('activeSubFrameStore') || 'tier';
            let activeOwnedFrameCategory = sessionStorage.getItem('activeOwnedFrameCategory') || 'tier';

            showMainSection(activeSection, false);

            switchStoreSub(activeSubStore);
            switchInvSub(activeSubInventory);
            switchFrameSub(activeSubFrameStore);
            switchOwnedFrameCategory(activeOwnedFrameCategory);
        });

        function copyVoucherCode(code, btn) {
            navigator.clipboard.writeText(code).then(() => {
                const originalHTML = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg"></i> Đã chép!';
                btn.classList.remove('btn-light', 'text-success');
                btn.classList.add('btn-success', 'text-white');
                setTimeout(() => {
                    btn.innerHTML = originalHTML;
                    btn.classList.remove('btn-success', 'text-white');
                    btn.classList.add('btn-light', 'text-success');
                }, 2000);
            }).catch(err => {
                console.error('Không thể sao chép: ', err);
            });
        }

        // Real-time synchronization of display tier badge
        const displayLevelSelect = document.getElementById('DisplayMembershipLevel');
        const profileTierBadge = document.getElementById('profileTierBadge');
        const profileTierIcon = document.getElementById('profileTierIcon');
        const profileTierName = document.getElementById('profileTierName');
        const jsTierIcons = ["bi-circle-fill", "bi-hexagon-fill", "bi-shield-fill", "bi-star-fill", "bi-diamond-fill", "bi-gem", "bi-gem", "bi-trophy-fill", "bi-award-fill", "bi-brightness-high-fill", "bi-radioactive", "bi-stars"];

         displayLevelSelect?.addEventListener('change', () => {
            const selectedVal = parseInt(displayLevelSelect.value);
            if (!isNaN(selectedVal)) {
                // Remove all tier classes
                profileTierBadge.className = 'tier-badge mb-3';
                profileTierBadge.classList.add(`tier-${selectedVal}`);

                // Update icon class
                const newIcon = jsTierIcons[Math.min(selectedVal, jsTierIcons.length - 1)] || "bi-circle-fill";
                profileTierIcon.className = `bi ${newIcon}`;

                // Update text
                const selectedText = displayLevelSelect.options[displayLevelSelect.selectedIndex].text;
                profileTierName.textContent = selectedText;

                // Update profile-card border class
                const profileCardAside = document.querySelector('aside.profile-card');
                if (profileCardAside) {
                    profileCardAside.className = profileCardAside.className.replace(/\btier-card-\d+\b/g, '');
                    profileCardAside.classList.add(`tier-card-${selectedVal}`);
                }
            }
        });

        // Real-time synchronization of avatar frame preview
        const equippedAvatarFrameSelect = document.getElementById('equippedAvatarFrameSelect');
        const avatarFramePreviewContainer = document.getElementById('avatarFramePreviewContainer');

        equippedAvatarFrameSelect?.addEventListener('change', () => {
            const selectedVal = equippedAvatarFrameSelect.value;
            avatarFramePreviewContainer.innerHTML = '';
            
            if (selectedVal !== 'none') {
                // Image frames: make avatar 135px, no border, no shadow
                avatarPreview.style.width = '135px';
                avatarPreview.style.height = '135px';
                avatarPreview.style.border = 'none';
                avatarPreview.style.boxShadow = 'none';
                avatarPreview.style.margin = '0';
                
                const defaultIcon = avatarPreview.querySelector('i');
                if (defaultIcon) {
                    defaultIcon.style.fontSize = '58px';
                }
                
                let frameFile = '';
                let frameFilter = '';
                
                let isVipFrame = false;
                let isDailyNormal = selectedVal.startsWith('daily-normal-');
                let isDailyLimited = selectedVal.startsWith('daily-limited-');
                let folder = isVipFrame ? 'khung-vip' : isDailyNormal ? 'khung-theo-ngay/khung-thuong' : isDailyLimited ? 'khung-theo-ngay/khung-gioi-han' : 'khung-avatar';

                if (isDailyNormal) {
                    frameFile = selectedVal.substring(13);
                    frameFilter = '';
                } else if (isDailyLimited) {
                    frameFile = selectedVal.substring(14);
                    frameFilter = 'filter: drop-shadow(0 0 5px #ff5722);';
                } else {
                    switch (selectedVal) {
                        case 'tier-0': frameFile = 'khung-sat.webp'; break;
                        case 'tier-1': frameFile = 'khung-dong.webp'; break;
                        case 'tier-2': 
                            frameFile = 'khung-sat.webp'; 
                            frameFilter = 'filter: brightness(1.2) contrast(1.4) saturate(0) drop-shadow(0 0 4px rgba(255,255,255,0.75));'; 
                            break;
                        case 'tier-3': frameFile = 'khung-vang.webp'; break;
                        case 'tier-4': frameFile = 'khung-bach-kim.webp'; break;
                        case 'tier-5': 
                            frameFile = 'khung-luc-bao.png'; 
                            frameFilter = 'filter: drop-shadow(0 0 4px #00ffd0);'; 
                            break;
                        case 'tier-6': 
                            frameFile = 'khung-kim-cuong.webp'; 
                            frameFilter = 'filter: drop-shadow(0 0 4px #a1c4fd);'; 
                            break;
                        case 'tier-7': 
                            frameFile = 'khung-ruby.png'; 
                            frameFilter = 'filter: drop-shadow(0 0 4px #ff0844);'; 
                            break;
                        case 'tier-8': frameFile = 'khung-niken.png'; break;
                        case 'tier-9': frameFile = 'khung-titan.png'; break;
                        case 'tier-10': 
                            frameFile = 'khung-uranium.png'; 
                            frameFilter = 'filter: drop-shadow(0 0 5px #39FF14);'; 
                            break;
                        case 'tier-11': 
                            frameFile = 'khung-iridium.png'; 
                            frameFilter = 'filter: drop-shadow(0 0 6px #C77DFF) drop-shadow(0 0 8px #E040FB);'; 
                            break;

                    }
                }
                
                if (frameFile) {
                    const fSize = (selectedVal === 'tier-9' || isVipFrame || isDailyLimited) ? '180px' : '158px';
                    avatarFramePreviewContainer.innerHTML = `<img class="avatar-frame-large" src="/image/${folder}/${frameFile}?t=${new Date().getTime()}" style="width: ${fSize}; height: ${fSize}; max-width: none !important; max-height: none !important; flex-shrink: 0 !important; pointer-events: none; ${frameFilter}" />`;
                }
            } else {
                // No frame: restore default class styles
                avatarPreview.style.width = '135px';
                avatarPreview.style.height = '135px';
                avatarPreview.style.border = '4px solid #fff';
                avatarPreview.style.boxShadow = '0 4px 18px rgba(0,0,0,.12)';
                avatarPreview.style.margin = '0 auto 14px';
                
                const defaultIcon = avatarPreview.querySelector('i');
                if (defaultIcon) {
                    defaultIcon.style.fontSize = '52px';
                }
            }
        });

        // ==========================================
        // LEVEL UP CELEBRATION & FIREWORKS ANIMATION
        // ==========================================
        (function () {
            const levelUpOverlay = document.getElementById('levelUpOverlay');
            if (!levelUpOverlay) return;

            const canvas = document.getElementById('fireworksCanvas');
            const ctx = canvas.getContext('2d');
            let rockets = [];
            let particles = [];
            let animationFrameId = null;
            let lastTime = 0;
            let lastSpawnTime = 0;

            let cardRect = null;
            function updateCardRect() {
                const card = document.querySelector('.lvl-card');
                if (card) {
                    const rect = card.getBoundingClientRect();
                    cardRect = {
                        left: rect.left,
                        right: rect.right,
                        top: rect.top,
                        width: rect.width,
                        height: rect.height
                    };
                }
            }

            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
                updateCardRect();
            }
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
            
            // Re-cache card size once the popIn scale animation settles
            setTimeout(updateCardRect, 650);

            class Rocket {
                constructor(startX, startY, targetX, targetY, speed) {
                    this.x = startX;
                    this.y = startY;
                    this.targetX = targetX;
                    this.targetY = targetY;
                    this.speed = speed;

                    const dx = targetX - startX;
                    const dy = targetY - startY;
                    const dist = Math.hypot(dx, dy);
                    this.vx = (dx / dist) * speed;
                    this.vy = (dy / dist) * speed;

                    this.trail = [];
                    this.trailLength = 12;
                    this.dead = false;

                    const colors = ['#ff2a5f', '#ffcb00', '#00ffd0', '#00b4d8', '#7b2ff7', '#ffe082'];
                    this.color = colors[Math.floor(Math.random() * colors.length)];
                }

                update() {
                    this.trail.push({ x: this.x, y: this.y });
                    if (this.trail.length > this.trailLength) {
                        this.trail.shift();
                    }
                    this.x += this.vx;
                    this.y += this.vy;

                    // Trigger explosion when rocket reaches target Y or passes it
                    if (this.vy < 0 && this.y <= this.targetY) {
                        this.dead = true;
                        this.explode();
                    }
                }

                draw(c) {
                    c.beginPath();
                    c.strokeStyle = this.color;
                    c.lineWidth = 3.0;
                    c.lineCap = 'round';
                    for (let i = 0; i < this.trail.length - 1; i++) {
                        c.moveTo(this.trail[i].x, this.trail[i].y);
                        c.lineTo(this.trail[i+1].x, this.trail[i+1].y);
                    }
                    c.stroke();

                    c.beginPath();
                    c.arc(this.x, this.y, 4.0, 0, Math.PI * 2);
                    c.fillStyle = '#ffffff';
                    c.fill();
                }

                explode() {
                    const count = 55 + Math.floor(Math.random() * 15);
                    for (let i = 0; i < count; i++) {
                        const angle = Math.random() * Math.PI * 2;
                        const speed = Math.random() * 5.0 + 2.0;
                        particles.push(new Particle(this.x, this.y, angle, speed, this.color));
                    }
                }
            }

            class Particle {
                constructor(x, y, angle, speed, color) {
                    this.x = x;
                    this.y = y;
                    this.vx = Math.cos(angle) * speed;
                    this.vy = Math.sin(angle) * speed;
                    this.color = color;
                    this.alpha = 1;
                    this.decay = Math.random() * 0.015 + 0.008;
                    this.gravity = 0.08;
                    this.friction = 0.98;
                    this.radius = Math.random() * 1.5 + 1.2;
                }

                update() {
                    this.vx *= this.friction;
                    this.vy *= this.friction;
                    this.vy += this.gravity;
                    this.x += this.vx;
                    this.y += this.vy;
                    this.alpha -= this.decay;
                }

                draw(c) {
                    // Fast outer glow shell using additive color blending
                    c.globalAlpha = this.alpha * 0.22;
                    c.beginPath();
                    c.arc(this.x, this.y, this.radius * 2.5, 0, Math.PI * 2);
                    c.fillStyle = this.color;
                    c.fill();
                    
                    // Solid bright core spark
                    c.globalAlpha = this.alpha;
                    c.beginPath();
                    c.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                    c.fillStyle = '#ffffff';
                    c.fill();
                }
            }

            function spawnFireworks() {
                if (!cardRect) updateCardRect();
                if (!cardRect) return;

                const startX = canvas.width / 2;
                const startY = canvas.height;

                // Left side target (beside the banner card)
                const targetYLeft = cardRect.top + cardRect.height * 0.2 + (Math.random() * 80 - 40);
                const targetXLeft = cardRect.left - 50 - Math.random() * 80;
                rockets.push(new Rocket(startX, startY, targetXLeft, targetYLeft, Math.random() * 2 + 9.5));

                // Right side target (beside the banner card)
                const targetYRight = cardRect.top + cardRect.height * 0.2 + (Math.random() * 80 - 40);
                const targetXRight = cardRect.right + 50 + Math.random() * 80;
                rockets.push(new Rocket(startX, startY, targetXRight, targetYRight, Math.random() * 2 + 9.5));
            }

            function animate(timestamp) {
                if (!lastTime) lastTime = timestamp;
                if (!lastSpawnTime) lastSpawnTime = timestamp;

                const delta = timestamp - lastTime;
                lastTime = timestamp;

                // Only spawn and animate if document is active / tab is visible
                if (!document.hidden) {
                    if (timestamp - lastSpawnTime > 800) {
                        spawnFireworks();
                        lastSpawnTime = timestamp;
                    }

                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    ctx.globalCompositeOperation = 'lighter';
                    ctx.globalAlpha = 1.0;

                    for (let i = rockets.length - 1; i >= 0; i--) {
                        rockets[i].update();
                        if (rockets[i].dead) {
                            rockets.splice(i, 1);
                        } else {
                            rockets[i].draw(ctx);
                        }
                    }

                    for (let i = particles.length - 1; i >= 0; i--) {
                        particles[i].update();
                        if (particles[i].alpha <= 0) {
                            particles.splice(i, 1);
                        } else {
                            particles[i].draw(ctx);
                        }
                    }
                    ctx.globalAlpha = 1.0;
                } else {
                    // Reset spawn timer so it doesn't trigger immediately when coming back
                    lastSpawnTime = timestamp;
                }

                animationFrameId = requestAnimationFrame(animate);
            }

            // Start animation loop (first frame automatically invokes with timestamp)
            animationFrameId = requestAnimationFrame(animate);

            // Clean-up handler globalized to window
            window.closeLevelUpModal = function () {
                if (animationFrameId) cancelAnimationFrame(animationFrameId);
                window.removeEventListener('resize', resizeCanvas);

                levelUpOverlay.style.transition = 'opacity 0.35s ease';
                levelUpOverlay.style.opacity = '0';
                setTimeout(() => {
                    levelUpOverlay.remove();
                }, 350);
            };
        })();

        // Refresh Daily Frames Custom Modal Dialog
        window.showCustomRefreshModal = function (cost) {
            const existingModal = document.querySelector('.custom-modal-overlay');
            if (existingModal) existingModal.remove();

            const title = "Xác nhận làm mới";
            const desc = cost === 0 
                ? "Bạn có chắc chắn muốn làm mới danh sách khung hàng ngày? Lượt đổi này là hoàn toàn MIỄN PHÍ."
                : `Lượt đổi này sẽ tốn ${cost} điểm tích lũy của bạn. Bạn có chắc chắn muốn tiếp tục?`;

            const modalHtml = `
                <div class="custom-modal-overlay">
                    <div class="custom-modal-card">
                        <div class="custom-modal-icon">
                            <i class="bi bi-arrow-clockwise"></i>
                        </div>
                        <div class="custom-modal-title">${title}</div>
                        <div class="custom-modal-desc">${desc}</div>
                        <div class="custom-modal-actions">
                            <button type="button" class="custom-modal-btn custom-modal-btn-cancel" id="btnCancelCustomModal">Hủy bỏ</button>
                            <button type="button" class="custom-modal-btn custom-modal-btn-confirm" id="btnConfirmCustomModal">Đồng ý</button>
                        </div>
                    </div>
                </div>
            `;

            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = modalHtml.trim();
            const modalEl = tempDiv.firstChild;
            document.body.appendChild(modalEl);

            requestAnimationFrame(() => {
                modalEl.classList.add('active');
            });

            const closeModal = function () {
                modalEl.classList.remove('active');
                setTimeout(() => {
                    modalEl.remove();
                }, 300);
            };

            modalEl.querySelector('#btnCancelCustomModal').addEventListener('click', closeModal);
            modalEl.querySelector('#btnConfirmCustomModal').addEventListener('click', function () {
                closeModal();
                document.getElementById('refreshFramesForm')?.submit();
            });

            modalEl.addEventListener('click', function (e) {
                if (e.target === modalEl) {
                    closeModal();
                }
            });
        };

        // Countdown to Midnight Timer
        (function () {
            function updateCountdowns() {
                const now = new Date();
                const midnight = new Date();
                midnight.setHours(24, 0, 0, 0); // 00:00:00 of tomorrow
                
                const diffMs = midnight - now;
                if (diffMs <= 0) {
                    document.querySelectorAll('.daily-countdown').forEach(el => {
                        el.textContent = "00:00:00";
                    });
                    return;
                }

                const hours = Math.floor(diffMs / 3600000);
                const minutes = Math.floor((diffMs % 3600000) / 60000);
                const seconds = Math.floor((diffMs % 60000) / 1000);

                const formattedTime = [
                    hours.toString().padStart(2, '0'),
                    minutes.toString().padStart(2, '0'),
                    seconds.toString().padStart(2, '0')
                ].join(':');

                document.querySelectorAll('.daily-countdown').forEach(el => {
                    el.textContent = formattedTime;
                });
            }
            setInterval(updateCountdowns, 1000);
            updateCountdowns();
        })();

        // Avatar file upload preview
        document.getElementById('avatarFile')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            const fileSelectedName = document.getElementById('fileSelectedName');
            const avatarPreview = document.getElementById('avatarPreview');

            if (file) {
                if (fileSelectedName) {
                    fileSelectedName.textContent = "Đã chọn file: " + file.name;
                    fileSelectedName.style.display = "block";
                }

                const reader = new FileReader();
                reader.onload = function (event) {
                    if (avatarPreview) {
                        avatarPreview.innerHTML = `<img src="${event.target.result}" alt="Avatar" />`;
                    }
                };
                reader.readAsDataURL(file);
            } else {
                if (fileSelectedName) {
                    fileSelectedName.textContent = "";
                    fileSelectedName.style.display = "none";
                }
            }
        });

        // ==========================================
        // KHÁCH HÀNG ĐÁNH GIÁ SẢN PHẨM TỪ LỊCH SỬ MUA HÀNG
        // ==========================================
        let currentSelectedRating = 5;

        window.openOrderProductReviewModal = function(productId, productName) {
            document.getElementById('reviewProductId').value = productId;
            document.getElementById('reviewProductNameDisplay').textContent = productName;
            document.getElementById('reviewCommentText').value = '';
            
            const alertMsg = document.getElementById('reviewAlertMsg');
            alertMsg.className = 'alert d-none small mb-0 rounded-3';
            alertMsg.textContent = '';

            setOrderReviewRating(5);

            const modalEl = document.getElementById('orderProductReviewModal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        };

        function setOrderReviewRating(rating) {
            currentSelectedRating = rating;
            const stars = document.querySelectorAll('#starRatingContainer .review-star');
            stars.forEach((star, idx) => {
                if (idx < rating) {
                    star.classList.remove('text-secondary');
                    star.classList.add('text-warning');
                } else {
                    star.classList.remove('text-warning');
                    star.classList.add('text-secondary');
                }
            });

            const ratingLabels = {
                1: "Rất không hài lòng (1 sao)",
                2: "Không hài lòng (2 sao)",
                3: "Bình thường (3 sao)",
                4: "Hài lòng (4 sao)",
                5: "Rất hài lòng (5 sao)"
            };
            document.getElementById('starRatingLabel').textContent = ratingLabels[rating] || "";
        }

        document.addEventListener('DOMContentLoaded', function() {
            const stars = document.querySelectorAll('#starRatingContainer .review-star');
            stars.forEach(star => {
                star.addEventListener('click', function() {
                    const val = parseInt(this.getAttribute('data-value'));
                    setOrderReviewRating(val);
                });
            });
        });

        window.submitOrderProductReview = async function() {
            const productId = document.getElementById('reviewProductId').value;
            const comment = document.getElementById('reviewCommentText').value.trim();
            const alertMsg = document.getElementById('reviewAlertMsg');
            const submitBtn = document.getElementById('btnSubmitOrderReview');

            if (!comment) {
                alertMsg.className = 'alert alert-danger small mb-0 rounded-3 d-block';
                alertMsg.textContent = 'Vui lòng nhập nội dung nhận xét sản phẩm.';
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...';

            try {
                const formData = new FormData();
                formData.append('productId', productId);
                formData.append('rating', currentSelectedRating);
                formData.append('comment', comment);

                const response = await fetch('/Home/AddReview', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    alertMsg.className = 'alert alert-success small mb-0 rounded-3 d-block';
                    alertMsg.textContent = data.message || 'Gửi đánh giá thành công!';
                    setTimeout(() => {
                        const modalEl = document.getElementById('orderProductReviewModal');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    }, 1200);
                } else {
                    alertMsg.className = 'alert alert-danger small mb-0 rounded-3 d-block';
                    alertMsg.textContent = data.message || 'Đã có lỗi xảy ra khi gửi đánh giá.';
                }
            } catch (err) {
                alertMsg.className = 'alert alert-danger small mb-0 rounded-3 d-block';
                alertMsg.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-send-fill me-1"></i>Gửi đánh giá';
            }
        };
    </script>
}
