                                    OK
                                </button>
                            </div>
                            <div class="d-flex gap-2">
                                @if (Model.VoucherPage > 1)
                                {
                                    <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                                       href="@Url.Action("Edit", "CustomerProfile", new { voucherPage = Model.VoucherPage - 1, activeSection = "inventory", activeSubInventory = "voucher" })">
                                        <i class="bi bi-chevron-left"></i> Trước
                                    </a>
                                }
                                else
                                {
                                    <span class="btn btn-outline-secondary btn-sm rounded-3 disabled"><i class="bi bi-chevron-left"></i> Trước</span>
                                }

                                @if (Model.VoucherPage < Model.VoucherTotalPages)
