                                        </div>
                                    </div>
                                    <div class="fw-bold text-dark" style="font-size: 12px; margin-bottom: 8px;">Không khung</div>
                                    <div class="mt-2">
                                        @if (Model.EquippedAvatarFrame == "none" || string.IsNullOrEmpty(Model.EquippedAvatarFrame))
                                        {
                                            <button class="btn btn-success btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;" disabled>Đang trang bị</button>
                                        }
                                        else
                                        {
                                            <form asp-action="EquipAvatarFrameDirect" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="frameId" value="none" />
                                                <button type="submit" class="btn btn-primary btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;">Sử dụng</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (!limitedFrames.Any())
                            {
                                <div class="col-12 text-center py-4 text-muted w-100">
                                    <i class="bi bi-emoji-neutral fs-2 d-block mb-2 text-secondary"></i>
                                    <span>Bạn chưa sở hữu khung giới hạn nào.</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var frame in limitedFrames)
                                {
                                    <div class="col-6 col-sm-4 col-md-3">
                                        <div class="frame-store-card @(frame.IsEquipped ? "owned" : "available")"
                                             style="border-radius: 14px; border: 2px solid @(frame.IsEquipped ? "#4caf50" : "#2196f3"); padding: 14px; text-align: center; transition: all 0.25s; position: relative; background: @(frame.IsEquipped ? "#f1fff4" : "#f0f7ff");">
                                            @if (frame.IsEquipped)
                                            {
                                                <div style="position: absolute; top: 7px; right: 7px;">
                                                    <span class="badge bg-success" style="font-size: 10px;"><i class="bi bi-check-circle-fill"></i> Đang dùng</span>
                                                </div>
                                            }
                                            <div style="position: relative; width: 90px; height: 90px; margin: 0 auto 10px; display: flex; align-items: center; justify-content: center;">
                                                <div style="width: 70px; height: 70px; border-radius: 50%; background: #e8f7ec; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                                    <i class="bi bi-person-fill" style="font-size: 36px; color: #1a7a2e;"></i>
                                                </div>
                                                <img src="/image/khung-theo-ngay/khung-gioi-han/@frame.FileName" asp-append-version="true"
                                                     style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; @frame.FilterStyle" />
                                            </div>
                                            <div class="fw-bold text-dark" style="font-size: 12px; margin-bottom: 8px;">@frame.Name</div>
                                            <div class="mt-2">
                                                @if (frame.IsEquipped)
                                                {
                                                    <button class="btn btn-success btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;" disabled>Đang trang bị</button>
                                                }
                                                else
                                                {
                                                    <form asp-action="EquipAvatarFrameDirect" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="frameId" value="@frame.Key" />
                                                        <button type="submit" class="btn btn-primary btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;">Sử dụng</button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>


                }
            </div>

            <!-- Inventory sub: Badges -->
            <div id="invSub-badge" class="inv-sub-panel d-none">
                <p class="text-muted small mb-4">Chọn huy hiệu hiển thị bên dưới ảnh đại diện của bạn.</p>
                <div class="row g-3">
                    <!-- Option: No badge -->
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="frame-store-card p-3 text-center @(Model.EquippedBadge == "none" || string.IsNullOrEmpty(Model.EquippedBadge) ? "owned" : "available")"
                             style="border-radius: 14px; border: 2px solid @(Model.EquippedBadge == "none" || string.IsNullOrEmpty(Model.EquippedBadge) ? "#4caf50" : "#ddd"); background: @(Model.EquippedBadge == "none" || string.IsNullOrEmpty(Model.EquippedBadge) ? "#f1fff4" : "#fafafa"); position: relative; height: 100%;">
                            @if (Model.EquippedBadge == "none" || string.IsNullOrEmpty(Model.EquippedBadge))
                            {
                                <div style="position: absolute; top: 7px; right: 7px;">
                                    <span class="badge bg-success" style="font-size: 10px;"><i class="bi bi-check-circle-fill"></i> Đang đeo</span>
                                </div>
                            }
                            <div class="mb-3 mt-4" style="height: 60px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-slash-circle fs-1 text-muted"></i>
                            </div>
                            <div class="fw-bold text-dark mb-3" style="font-size: 12px;">Không dùng huy hiệu</div>
                            @if (Model.EquippedBadge == "none" || string.IsNullOrEmpty(Model.EquippedBadge))
                            {
                                <button class="btn btn-success btn-sm rounded-pill fw-bold w-100 mt-auto" style="font-size: 11px; font-weight: 800;" disabled>Đang đeo</button>
                            }
                            else
                            {
                                <form asp-action="EquipBadgeDirect" method="post" class="m-0 mt-auto">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="badgeId" value="none" />
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;">Sử dụng</button>
                                </form>
                            }
                        </div>
                    </div>

                    @foreach (var badge in Model.OwnedBadges)
                    {
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="frame-store-card p-3 text-center @(badge.IsEquipped ? "owned" : "available")"
                                 style="border-radius: 14px; border: 2px solid @(badge.IsEquipped ? "#4caf50" : "#2196f3"); background: @(badge.IsEquipped ? "#f1fff4" : "#f0f7ff"); position: relative; height: 100%;">
                                @if (badge.IsEquipped)
                                {
                                    <div style="position: absolute; top: 7px; right: 7px;">
                                        <span class="badge bg-success" style="font-size: 10px;"><i class="bi bi-check-circle-fill"></i> Đang đeo</span>
                                    </div>
                                }
                                <div class="mb-3 mt-4" style="height: 60px; display: flex; align-items: center; justify-content: center;">
                                    <img src="/image/huy-hieu/@badge.FileName" style="max-height: 50px; max-width: 100%; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));" />
                                </div>
                                <div class="fw-bold text-dark mb-3" style="font-size: 12px;">@badge.Name</div>
                                @if (badge.IsEquipped)
                                {
                                    <button class="btn btn-success btn-sm rounded-pill fw-bold w-100 mt-auto" style="font-size: 11px; font-weight: 800;" disabled>Đang đeo</button>
                                }
                                else
                                {
                                    <form asp-action="EquipBadgeDirect" method="post" class="m-0 mt-auto">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="badgeId" value="@badge.Key" />
                                        <button type="submit" class="btn btn-primary btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;">Sử dụng</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

    <!-- LỊCH SỬ MUA HÀNG -->
    <div id="orderHistorySection" class="d-none">
        <div class="profile-card">
            <h4 class="fw-bold mb-3 text-info" style="font-weight:900;">
                <i class="bi bi-clock-history me-2"></i>Lịch Sử Mua Hàng
            </h4>
            <p class="text-muted small mb-4">Danh sách các đơn hàng bạn đã mua trên hệ thống.</p>

            <!-- BỘ LỌC TÌM KIẾM THEO MÃ ĐƠN HÀNG -->
            <form method="get" asp-action="Edit" class="mb-4" id="orderSearchForm">
                <input type="hidden" name="activeSection" value="history" />
                <div class="input-group" style="max-width: 400px;">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="orderSearch" class="form-control border-start-0 ps-0 fw-bold" 
                           placeholder="Nhập mã đơn hàng (VD: 1078)..." value="@Model.OrderSearch" />
                    <button type="submit" class="btn btn-info text-white fw-bold px-3">
                        <i class="bi bi-search me-1"></i> Tìm
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.OrderSearch))
                    {
                        <a asp-action="Edit" asp-route-activeSection="history" class="btn btn-outline-secondary" title="Xóa bộ lọc tìm kiếm">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>

            @if (!Model.OrderHistory.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-cart-x fs-1 d-block mb-3 text-secondary"></i>
                    @if (!string.IsNullOrWhiteSpace(Model.OrderSearch))
                    {
                        <span>Không tìm thấy đơn hàng nào khớp với mã "<strong>@Model.OrderSearch</strong>".</span>
                    }
                    else
                    {
                        <span>Bạn chưa có đơn hàng nào. Hãy mua sắm ngay!</span>
                    }
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var o in Model.OrderHistory)
                    {
                        var statusText = o.Status switch
                        {
                            0 => "Chờ duyệt",
                            1 => "Đang soạn hàng",
                            2 => "Đang giao",
                            3 => "Thành công",
                            4 => "Chờ thanh toán",
                            5 => "Đã hủy",
                            _ => "Không xác định"
                        };

                        var statusClass = o.Status switch
                        {
                            0 => "bg-warning text-dark",
                            1 => "bg-info text-white",
                            2 => "bg-primary text-white",
                            3 => "bg-success text-white",
                            4 => "bg-secondary text-white",
                            5 => "bg-danger text-white",
                            _ => "bg-dark text-white"
                        };

                        <div class="card mb-2 order-card" style="border-radius: 12px; border: 1px solid #e0e0e0; overflow: hidden; transition: all 0.2s; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3" style="cursor: pointer;" onclick="toggleOrderDetail(@o.Id)">
                                <div>
                                    <span class="fw-bold text-dark">Đơn hàng #@o.Id</span>
                                    <span class="text-muted ms-2 small">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @statusClass rounded-pill" style="font-size: 11px; font-weight: 700;">@statusText</span>
                                    <span class="fw-bold text-success" style="font-size: 15px;">@o.TotalAmount.ToString("N0")đ</span>
                                    <i class="bi bi-chevron-down ms-2 text-muted" id="chevron-@o.Id"></i>
                                </div>
                            </div>
                            <div id="detail-@o.Id" class="order-detail-content d-none p-3 bg-light border-top">
                                <div class="table-responsive">
                                    <table class="table table-borderless table-sm m-0">
                                        <thead>
                                            <tr class="text-muted small border-bottom">
                                                <th style="font-weight: 700;">Sản phẩm</th>
                                                <th class="text-center" style="font-weight: 700;">Số lượng</th>
                                                <th class="text-end" style="font-weight: 700;">Đơn giá</th>
                                                <th class="text-end" style="font-weight: 700;">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var det in o.OrderDetails)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center justify-content-between py-1">
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (!string.IsNullOrEmpty(det.Product.Image))
                                                                {
                                                                    <img src="@det.Product.Image" style="width: 36px; height: 36px; object-fit: cover; border-radius: 6px; border: 1px solid #eee;" />
                                                                }
                                                                <span class="text-dark small fw-bold">@det.Product.Name</span>
                                                            </div>
                                                            <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill px-2 py-0"
                                                                    style="font-size: 11px;"
                                                                    onclick="openOrderProductReviewModal(@det.ProductId, '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(det.Product.Name)')">
                                                                <i class="bi bi-star-fill me-1"></i> Đánh giá
                                                            </button>
                                                        </div>
                                                    </td>
                                                    <td class="text-center align-middle small text-secondary">@det.Quantity.ToString("0.##")</td>
                                                    <td class="text-end align-middle small text-secondary">@det.Price.ToString("N0")đ</td>
                                                    <td class="text-end align-middle fw-bold text-dark small">@((det.Quantity * det.Price).ToString("N0"))đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="row mt-3 pt-3 border-top g-2 small text-muted">
                                    <div class="col-sm-6">
                                        <div><strong>Người nhận:</strong> @o.FullName</div>
                                        <div><strong>SĐT:</strong> @o.Phone</div>
                                        <div><strong>Địa chỉ:</strong> @o.Address</div>
                                    </div>
                                    <div class="col-sm-6 text-sm-end">
                                        <div><strong>Hình thức thanh toán:</strong> @o.PaymentMethod</div>
                                        <div><strong>Trạng thái thanh toán:</strong> @(o.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")</div>
                                        @if (o.DiscountAmount > 0)
                                        {
                                            <div><strong>Giảm giá:</strong> -@o.DiscountAmount.ToString("N0")đ</div>
                                        }
                                        @if (o.ShippingFee > 0)
                                        {
                                            <div><strong>Phí vận chuyển:</strong> +@o.ShippingFee.ToString("N0")đ</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.OrderTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 bg-white border rounded-4 shadow-sm mt-3">
                        <div class="d-flex align-items-center gap-1 text-muted fw-bold small">
                            <span>Trang</span>
                            <input type="number" class="form-control form-control-sm text-center p-0 fw-bold border-success"
                                   style="width: 48px; height: 28px; font-size: 13px;"
                                   value="@Model.OrderPage" min="1" max="@Model.OrderTotalPages"
                                   data-param="orderPage" data-section="history"
                                   onkeydown="if(event.key==='Enter'){ event.preventDefault(); window.goToPage(this); }" />
                            <span>/ @Model.OrderTotalPages</span>
                            <button type="button" class="btn btn-sm btn-success py-0 px-2 fw-bold ms-1"
                                    style="height: 28px; font-size: 12px; border-radius: 6px;"
                                    onclick="window.goToPage(this);">
                                OK
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            @if (Model.OrderPage > 1)
                            {
                                <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                                   href="@Url.Action("Edit", "CustomerProfile", new { orderSearch = Model.OrderSearch, orderPage = Model.OrderPage - 1, chatPage = Model.ChatPage, activeSection = "history" })">
                                    <i class="bi bi-chevron-left"></i> Trước
                                </a>
                            }
                            else
                            {
                                <span class="btn btn-outline-secondary btn-sm rounded-3 disabled"><i class="bi bi-chevron-left"></i> Trước</span>
                            }

                            @if (Model.OrderPage < Model.OrderTotalPages)
                            {
                                <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                                   href="@Url.Action("Edit", "CustomerProfile", new { orderSearch = Model.OrderSearch, orderPage = Model.OrderPage + 1, chatPage = Model.ChatPage, activeSection = "history" })">
                                    Sau <i class="bi bi-chevron-right"></i>
                                </a>
                            }
                            else
                            {
                                <span class="btn btn-outline-secondary btn-sm rounded-3 disabled">Sau <i class="bi bi-chevron-right"></i></span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- LỊCH SỬ CHAT AI -->
    <div id="aiChatHistorySection" class="d-none">
        <div class="profile-card">
            <h4 class="fw-bold mb-3 text-primary" style="font-weight:900;">
                <i class="bi bi-robot me-2"></i>Lịch Sử Chat AI Assistant
            </h4>
            <p class="text-muted small mb-4">Các cuộc trò chuyện của bạn với Trợ lý AI Bách Hóa Xanh.</p>

            @if (Model.ChatHistories == null || !Model.ChatHistories.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-square-text fs-1 d-block mb-3 text-secondary"></i>
                    <span>Bạn chưa có lịch sử trò chuyện AI nào. Hãy chat với AI Assistant ở góc màn hình!</span>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var chat in Model.ChatHistories)
                    {
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary rounded-pill px-3 py-1.5"><i class="bi bi-clock me-1"></i>@chat.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                                <span class="small text-muted font-monospace">Mã #@chat.Id</span>
                            </div>
                            <div class="mb-2 p-2 bg-white rounded border">
                                <div class="fw-bold text-success small mb-1"><i class="bi bi-person-fill me-1"></i>Bạn hỏi:</div>
                                <div class="text-dark small">@chat.Question</div>
                            </div>
                            <div class="p-2 bg-white rounded border border-primary-subtle">
                                <div class="fw-bold text-primary small mb-1"><i class="bi bi-robot me-1"></i>AI Phản hồi:</div>
                                <div class="text-dark small" style="white-space: pre-line;">@chat.Answer</div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.ChatTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 bg-white border rounded-4 shadow-sm">
                        <div class="d-flex align-items-center gap-1 text-muted fw-bold small">
                            <span>Trang</span>
                            <input type="number" class="form-control form-control-sm text-center p-0 fw-bold border-primary"
                                   style="width: 48px; height: 28px; font-size: 13px;"
                                   value="@Model.ChatPage" min="1" max="@Model.ChatTotalPages"
                                   data-param="chatPage" data-section="aichat"
                                   onkeydown="if(event.key==='Enter'){ event.preventDefault(); window.goToPage(this); }" />
                            <span>/ @Model.ChatTotalPages</span>
                            <button type="button" class="btn btn-sm btn-primary py-0 px-2 fw-bold ms-1"
                                    style="height: 28px; font-size: 12px; border-radius: 6px;"
                                    onclick="window.goToPage(this);">
                                OK
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            @if (Model.ChatPage > 1)
                            {
                                <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                                   asp-action="Edit"
                                   asp-route-chatPage="@(Model.ChatPage - 1)"
                                   asp-route-activeSection="aichat">
                                    <i class="bi bi-chevron-left"></i> Trước
                                </a>
                            }
                            else
                            {
                                <span class="btn btn-outline-secondary btn-sm rounded-3 disabled"><i class="bi bi-chevron-left"></i> Trước</span>
                            }

                            @if (Model.ChatPage < Model.ChatTotalPages)
                            {
                                <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                                   asp-action="Edit"
                                   asp-route-chatPage="@(Model.ChatPage + 1)"
                                   asp-route-activeSection="aichat">
                                    Sau <i class="bi bi-chevron-right"></i>
                                </a>
                            }
                            else
                            {
                                <span class="btn btn-outline-secondary btn-sm rounded-3 disabled">Sau <i class="bi bi-chevron-right"></i></span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    }
        </div>
    </div>
</div>

<!-- Modal Đánh giá sản phẩm từ Lịch sử mua hàng -->
<div class="modal fade" id="orderProductReviewModal" tabindex="-1" aria-labelledby="orderProductReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow border-0">
            <div class="modal-header bg-success text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="orderProductReviewModalLabel">
                    <i class="bi bi-star-fill text-warning me-2"></i>Đánh giá sản phẩm
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="reviewProductId" value="" />
                
                <div class="text-center mb-3">
                    <span class="text-muted small">Bạn đang đánh giá sản phẩm:</span>
                    <h6 class="fw-bold text-success mt-1" id="reviewProductNameDisplay">...</h6>
                </div>

                <!-- Bộ chọn số sao tương tác -->
                <div class="mb-3 text-center">
                    <label class="form-label d-block fw-bold mb-2">Chọn mức độ hài lòng:</label>
                    <div class="d-inline-flex gap-2 justify-content-center align-items-center bg-light px-3 py-2 rounded-pill border" id="starRatingContainer">
                        <i class="bi bi-star-fill fs-3 text-warning review-star" data-value="1" style="cursor: pointer; transition: color 0.15s;"></i>
                        <i class="bi bi-star-fill fs-3 text-warning review-star" data-value="2" style="cursor: pointer; transition: color 0.15s;"></i>
                        <i class="bi bi-star-fill fs-3 text-warning review-star" data-value="3" style="cursor: pointer; transition: color 0.15s;"></i>
                        <i class="bi bi-star-fill fs-3 text-warning review-star" data-value="4" style="cursor: pointer; transition: color 0.15s;"></i>
                        <i class="bi bi-star-fill fs-3 text-warning review-star" data-value="5" style="cursor: pointer; transition: color 0.15s;"></i>
                    </div>
                    <div class="small fw-bold text-success mt-2" id="starRatingLabel">Rất hài lòng (5 sao)</div>
                </div>

                <!-- Ô nhận xét -->
                <div class="mb-3">
                    <label for="reviewCommentText" class="form-label fw-bold small">Nhận xét của bạn:</label>
                    <textarea class="form-control rounded-3" id="reviewCommentText" rows="4" placeholder="Hãy chia sẻ trải nghiệm sử dụng sản phẩm này với những khách hàng khác..."></textarea>
                </div>

                <div id="reviewAlertMsg" class="alert d-none small mb-0 rounded-3"></div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4 border-0">
                <button type="button" class="btn btn-secondary rounded-pill fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success rounded-pill fw-bold px-4" id="btnSubmitOrderReview" onclick="submitOrderProductReview()">
                    <i class="bi bi-send-fill me-1"></i>Gửi đánh giá
                </button>
            </div>
        </div>
    </div>
</div>

