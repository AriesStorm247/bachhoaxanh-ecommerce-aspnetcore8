                                    {
                                        <span class="badge bg-success text-white small">Đã Đạt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white small">Chưa Đạt</span>
                                    }
                                </div>
                                <div class="small text-muted mt-1">@item.Requirement</div>
                                <div class="small text-muted mt-1">
                                    Phần thưởng: <strong>Voucher @item.DiscountValue%</strong> cho đơn hàng
                                </div>
                            </div>
                            <div>
                                @if (item.IsUnlocked)
                                {
                                    <div class="text-end">
                                        <span class="small text-muted d-block mb-1">Mã của bạn:</span>
                                        <code class="bg-dark text-white px-2 py-1 rounded">@item.GeneratedCode</code>
