                @foreach (var item in Model.AchievementItems)
                {
                    <div class="card border-light p-3 @(item.IsUnlocked ? "border-success-subtle bg-success-subtle bg-opacity-10" : "opacity-75")" style="border-radius:10px; border: 1.5px solid @(item.IsUnlocked ? "#c3e6cb" : "#eee");">
