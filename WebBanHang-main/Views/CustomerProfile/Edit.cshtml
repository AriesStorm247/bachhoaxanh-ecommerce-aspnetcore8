                        <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                        <span>Bạn chưa sở hữu mã giảm giá nào. Hãy tích lũy điểm và đổi mã!</span>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var item in Model.OwnedVouchers)
                        {
                            var isUsed = item.Quantity <= 0;
                            <div class="col-md-6 col-lg-4">
                                <div class="card p-3 h-100 @(isUsed ? "opacity-50 bg-light" : "border-success-subtle bg-success bg-opacity-10")"
                                     style="border-radius: 12px; border: 1.5px solid @(isUsed ? "#eee" : "#c3e6cb"); position: relative; transition: all 0.2s;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge @(isUsed ? "bg-secondary" : "bg-success") text-white">
                                            @(isUsed ? "Đã sử dụng" : "Chưa sử dụng")
                                        </span>
                                        <span class="badge bg-light text-dark border small">@item.SourceType</span>
                                    </div>
                                    <div class="fw-bold text-dark fs-5 mb-1">Giảm @item.DiscountValue%</div>
                                    <div class="small text-muted mb-2">@item.Title</div>
                                    <div class="small mb-3 text-muted">
                                        @if (item.MinOrderValue > 0)
                                        {
                                            <span>Đơn tối thiểu: <strong>@item.MinOrderValue.ToString("N0")đ</strong></span>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-bold">Không giới hạn đơn hàng</span>
                                        }
                                    </div>
                                    <div class="bg-dark text-white p-2 rounded d-flex justify-content-between align-items-center mb-2" style="gap: 8px;">
                                        <code class="text-white font-monospace" style="font-size: 13px; word-break: break-all;">@item.Code</code>
                                        @if (!isUsed)
                                        {
                                            <button type="button" class="btn btn-light btn-sm fw-bold text-success border-0 rounded"
                                                    style="white-space: nowrap; flex-shrink: 0; font-size: 11px; padding: 4px 10px; font-weight: 800;"
                                                    onclick="copyVoucherCode('@item.Code', this)">
                                                <i class="bi bi-clipboard"></i> Sao chép
                                            </button>
                                        }
                                    </div>
                                    <div class="text-muted" style="font-size: 11px;">
                                        Hạn dùng: @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                        }
