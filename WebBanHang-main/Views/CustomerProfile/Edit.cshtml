@model WebBanHang.ViewModels.CustomerProfileViewModel

@{
    var isCustomerOrAdmin = true;
    ViewData["Title"] = isCustomerOrAdmin ? "Hồ sơ khách hàng" : "Hồ sơ nhân viên";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<style>
    @@keyframes opacityPulse {
        0% { opacity: 1; }
        50% { opacity: 0.4; }
        100% { opacity: 1; }
    }

    /* Sparkling border animations and gradients for each tier */
    .profile-card {
        border-width: 3px !important;
        border-style: solid !important;
        position: relative;
        transition: all 0.3s ease;
        background-color: #fff;
    }

    @@keyframes shimmer-silver {
        0% { border-color: #cbd5e1; box-shadow: 0 0 10px rgba(203, 213, 225, 0.4); }
        50% { border-color: #94a3b8; box-shadow: 0 0 20px rgba(148, 163, 184, 0.8); }
        100% { border-color: #cbd5e1; box-shadow: 0 0 10px rgba(203, 213, 225, 0.4); }
    }
    @@keyframes shimmer-gold {
        0% { border-color: #ffd700; box-shadow: 0 0 10px rgba(255, 215, 0, 0.4); }
        50% { border-color: #ffa500; box-shadow: 0 0 20px rgba(255, 165, 0, 0.8); }
        100% { border-color: #ffd700; box-shadow: 0 0 10px rgba(255, 215, 0, 0.4); }
    }
    @@keyframes shimmer-platinum {
        0% { border-color: #e5e4e2; box-shadow: 0 0 10px rgba(229, 228, 226, 0.4); }
        50% { border-color: #b0c4de; box-shadow: 0 0 20px rgba(176, 196, 222, 0.8); }
        100% { border-color: #e5e4e2; box-shadow: 0 0 10px rgba(229, 228, 226, 0.4); }
    }
    @@keyframes shimmer-emerald {
        0% { border-color: #50c878; box-shadow: 0 0 10px rgba(80, 200, 120, 0.4); }
        50% { border-color: #00ff7f; box-shadow: 0 0 20px rgba(0, 255, 127, 0.8); }
        100% { border-color: #50c878; box-shadow: 0 0 10px rgba(80, 200, 120, 0.4); }
    }
    @@keyframes shimmer-diamond {
        0% { border-color: #b9f2ff; box-shadow: 0 0 10px rgba(185, 242, 255, 0.4); }
        50% { border-color: #00d2ff; box-shadow: 0 0 20px rgba(0, 210, 255, 0.8); }
        100% { border-color: #b9f2ff; box-shadow: 0 0 10px rgba(185, 242, 255, 0.4); }
    }
    @@keyframes shimmer-ruby {
        0% { border-color: #e0115f; box-shadow: 0 0 10px rgba(224, 17, 95, 0.4); }
        50% { border-color: #ff007f; box-shadow: 0 0 20px rgba(255, 0, 127, 0.8); }
        100% { border-color: #e0115f; box-shadow: 0 0 10px rgba(224, 17, 95, 0.4); }
    }
    @@keyframes shimmer-niken {
        0% { border-color: #3d1515; box-shadow: 0 0 10px rgba(229, 57, 53, 0.4); }
        50% { border-color: #ff1744; box-shadow: 0 0 20px rgba(255, 23, 68, 0.8); }
        100% { border-color: #3d1515; box-shadow: 0 0 10px rgba(229, 57, 53, 0.4); }
    }
    @@keyframes shimmer-titan {
        0% { border-color: #667eea; box-shadow: 0 0 10px rgba(102, 126, 234, 0.4); }
        50% { border-color: #764ba2; box-shadow: 0 0 20px rgba(118, 75, 162, 0.8); }
        100% { border-color: #667eea; box-shadow: 0 0 10px rgba(102, 126, 234, 0.4); }
    }
    @@keyframes shimmer-uranium {
        0% { border-color: #39FF14; box-shadow: 0 0 10px rgba(57, 255, 20, 0.4); }
        50% { border-color: #00FF00; box-shadow: 0 0 20px rgba(0, 255, 0, 0.8); }
        100% { border-color: #39FF14; box-shadow: 0 0 10px rgba(57, 255, 20, 0.4); }
    }
    @@keyframes shimmer-iridium {
        0% { border-color: #C77DFF; box-shadow: 0 0 10px rgba(199, 125, 255, 0.4); }
        50% { border-color: #E040FB; box-shadow: 0 0 20px rgba(224, 64, 251, 0.8); }
        100% { border-color: #C77DFF; box-shadow: 0 0 10px rgba(199, 125, 255, 0.4); }
    }

    /* Unified layout alignment for profile-grid */
    .profile-grid {
        display: grid;
        grid-template-columns: 330px 1fr;
        gap: 18px;
        align-items: start !important;
    }

    .profile-main-column > div > .profile-card {
        margin-top: 0 !important;
    }

    /* Assign shimmering to tier card borders */
    .tier-card-0 { border-color: #cccccc; }
    .tier-card-1 { border-color: #cd7f32; }
    .tier-card-2 { animation: shimmer-silver 2s infinite; }
    .tier-card-3 { animation: shimmer-gold 2s infinite; }
    .tier-card-4 { animation: shimmer-platinum 2s infinite; }
    .tier-card-5 { animation: shimmer-emerald 2s infinite; }
    .tier-card-6 { animation: shimmer-diamond 2s infinite; }
    .tier-card-7 { animation: shimmer-ruby 2s infinite; }
    .tier-card-8 { animation: shimmer-niken 2s infinite; }
    .tier-card-9 { animation: shimmer-titan 2s infinite; }
    .tier-card-10 { animation: shimmer-uranium 2s infinite; }
    .tier-card-11 { animation: shimmer-iridium 2s infinite; }

    /* Restore tier card background gradients corresponding to user tier level */
    aside.profile-card {
        margin-top: 0 !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    aside.profile-card.tier-card-0 { background-color: #ffffff !important; color: #333333 !important; }
    aside.profile-card.tier-card-1 { background-color: #fcf8f5 !important; color: #5a2e17 !important; }
    aside.profile-card.tier-card-2 { background: linear-gradient(135deg, #e2e8f0, #cbd5e1) !important; color: #334155 !important; }
    aside.profile-card.tier-card-3 { background: linear-gradient(135deg, #fffde6, #fff0b3) !important; color: #5c3d00 !important; }
    aside.profile-card.tier-card-4 { background: linear-gradient(135deg, #e5e4e2, #b0c4de) !important; color: #1c2833 !important; }
    aside.profile-card.tier-card-5 { background: linear-gradient(135deg, #a3e4d7, #2ecc71) !important; color: #0b5345 !important; }
    aside.profile-card.tier-card-6 { background: linear-gradient(135deg, #d6eaf8, #5dabfc) !important; color: #0b3c5d !important; }
    aside.profile-card.tier-card-7 { background: linear-gradient(135deg, #fadbd8, #ec7063) !important; color: #78281f !important; }
    aside.profile-card.tier-card-8 { background: linear-gradient(135deg, #b83f4d, #5c1820) !important; color: #ffffff !important; }
    aside.profile-card.tier-card-9 { background: linear-gradient(135deg, #a5c3f7, #667eea) !important; color: #ffffff !important; }
    aside.profile-card.tier-card-10 { background: linear-gradient(135deg, #d5f5e3, #39FF14) !important; color: #1e3f00 !important; }
    aside.profile-card.tier-card-11 { background: linear-gradient(135deg, #f3e5f5, #ab47bc) !important; color: #ffffff !important; }

    aside.profile-card .text-muted {
        color: inherit !important;
        opacity: 0.85;
    }
    aside.profile-card .point-num {
        color: inherit !important;
        font-weight: 900 !important;
    }

    aside.profile-card.tier-card-8 .point-num,
    aside.profile-card.tier-card-9 .point-num,
    aside.profile-card.tier-card-11 .point-num {
        color: #ffffff !important;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
    }

    /* Enforce high contrast and custom border for upgrade-box across all tiers */
    aside.profile-card .upgrade-box {
        background-color: #ffffff !important;
        border: 2px dashed #198754 !important; /* Stand-out green dashed border */
        color: #111111 !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08) !important;
        text-shadow: none !important;
    }
    aside.profile-card .upgrade-box div, 
    aside.profile-card .upgrade-box span, 
    aside.profile-card .upgrade-box p, 
    aside.profile-card .upgrade-box .small,
    aside.profile-card .upgrade-box .text-muted {
        color: #111111 !important;
        text-shadow: none !important;
        opacity: 1 !important;
    }

    /* Make avatar preview background slightly semi-transparent white so avatar pops out */
    .avatar-preview {
        background: rgba(255, 255, 255, 0.35) !important;
        border: 1px solid rgba(255, 255, 255, 0.5) !important;
    }

    /* Style for buttons inside aside.profile-card to make them highly visible and pop out */
    aside.profile-card .btn {
        border-width: 2px !important;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08) !important;
        font-weight: 800 !important;
        opacity: 1 !important;
        transition: all 0.2s ease-in-out !important;
    }

    /* Hover effect */
    aside.profile-card .btn:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.12) !important;
    }

    /* Active state styling for buttons inside sidebar */
    aside.profile-card .btn.btn-secondary {
        background-color: #6c757d !important;
        color: #ffffff !important;
        border-color: #6c757d !important;
    }
    aside.profile-card .btn.btn-primary {
        background-color: #0d6efd !important;
        color: #ffffff !important;
        border-color: #0d6efd !important;
    }
    aside.profile-card .btn.btn-danger {
        background-color: #dc3545 !important;
        color: #ffffff !important;
        border-color: #dc3545 !important;
    }
    aside.profile-card .btn.btn-warning {
        background-color: #ffc107 !important;
        color: #212529 !important;
        border-color: #ffc107 !important;
    }
    aside.profile-card .btn.btn-success {
        background-color: #198754 !important;
        color: #ffffff !important;
        border-color: #198754 !important;
    }
    aside.profile-card .btn.btn-info {
        background-color: #0dcaf0 !important;
        color: #ffffff !important;
        border-color: #0dcaf0 !important;
    }

    /* Inactive outline states - enforce crisp text and borders */
    aside.profile-card .btn.btn-outline-secondary {
        background-color: #ffffff !important;
        color: #495057 !important;
        border-color: #6c757d !important;
    }
    aside.profile-card .btn.btn-outline-primary {
        background-color: #ffffff !important;
        color: #0d6efd !important;
        border-color: #0d6efd !important;
    }
    aside.profile-card .btn.btn-outline-danger {
        background-color: #ffffff !important;
        color: #dc3545 !important;
        border-color: #dc3545 !important;
    }
    aside.profile-card .btn.btn-outline-warning {
        background-color: #ffffff !important;
        color: #b25e00 !important;
        border-color: #ffc107 !important;
    }
    aside.profile-card .btn.btn-outline-success {
        background-color: #ffffff !important;
        color: #198754 !important;
        border-color: #198754 !important;
    }
    aside.profile-card .btn.btn-outline-info {
        background-color: #ffffff !important;
        color: #0c8fa8 !important;
        border-color: #0dcaf0 !important;
    }
</style>

<div class="profile-wrap">
    <div class="profile-header-wrap d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-black mb-1" style="font-weight:900;color:#1a7a2e;">@(isCustomerOrAdmin ? "Hồ sơ khách hàng" : "Hồ sơ nhân viên")</h2>
            <div class="text-muted small">@(isCustomerOrAdmin ? "Khách đã đăng nhập được tính là khách hàng thân thiết." : "Thông tin hồ sơ nhân viên trong hệ thống.")</div>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success rounded-pill">
            <i class="bi bi-house-door me-1"></i> Trang chủ
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]?.ToString() ?? ""))', 'success');
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]?.ToString() ?? ""))', 'error');
            });
        </script>
    }

    <div class="profile-grid">
        @{
            int displayLvl = Model.DisplayMembershipLevel ?? Model.MembershipLevel;
        }
        <aside class="profile-card text-center tier-card-@displayLvl">
            @{
                var isFramed = !string.IsNullOrEmpty(Model.EquippedAvatarFrame) && Model.EquippedAvatarFrame != "none";
                var previewStyle = isFramed 
                    ? "margin: 0; position: relative; z-index: 1; width: 135px; height: 135px; border: none; box-shadow: none;"
                    : "margin: 0 auto 14px; position: relative; z-index: 1;";
            }
            <div class="avatar-preview-container" style="position: relative; width: 140px; height: 140px; margin: 50px auto 30px; display: flex; align-items: center; justify-content: center;">
                <div class="avatar-preview avatar-bg-@displayLvl" id="avatarPreview" style="@previewStyle">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" onerror="this.remove();" />
                    }
                    else
                    {
                        <i class="bi bi-person-fill" style="font-size: 58px;"></i>
                    }
                </div>
                <div id="avatarFramePreviewContainer" style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 2;">
                    @if (!string.IsNullOrEmpty(Model.EquippedAvatarFrame) && Model.EquippedAvatarFrame != "none")
                    {
                        string? frameFile = null;
                        string folder = "khung-avatar";
                        string frameFilter = "";
                        string frameSize = "width: 158px; height: 158px;";

                        if (Model.EquippedAvatarFrame.StartsWith("daily-normal-"))
                        {
                            frameFile = Model.EquippedAvatarFrame.Substring("daily-normal-".Length);
                            folder = "khung-theo-ngay/khung-thuong";
                        }
                        else if (Model.EquippedAvatarFrame.StartsWith("daily-limited-"))
                        {
                            frameFile = Model.EquippedAvatarFrame.Substring("daily-limited-".Length);
                            folder = "khung-theo-ngay/khung-gioi-han";
                            frameFilter = "filter: drop-shadow(0 0 5px #ff5722);";
                            frameSize = "width: 180px; height: 180px;";
                        }
                        else
                        {
                            frameFile = Model.EquippedAvatarFrame switch
                            {
                                "tier-0" => "khung-sat.webp",
                                "tier-1" => "khung-dong.webp",
                                "tier-2" => "khung-sat.webp",
                                "tier-3" => "khung-vang.webp",
                                "tier-4" => "khung-bach-kim.webp",
                                "tier-5" => "khung-luc-bao.png",
                                "tier-6" => "khung-kim-cuong.webp",
                                "tier-7" => "khung-ruby.png",
                                "tier-8" => "khung-niken.png",
                                "tier-9" => "khung-titan.png",
                                "tier-10" => "khung-uranium.png",
                                "tier-11" => "khung-iridium.png",
                                "vip-moc-1" => "khung-vip-moc-1.png",
                                "vip-moc-2" => "khung-vip-moc-2.webp",
                                "vip-moc-3" => "khung-vip-moc-3.webp",
                                "vip-moc-4" => "khung-vip-moc-4.webp",
                                _ => null
                            };
                            frameFilter = Model.EquippedAvatarFrame switch
                            {
                                "tier-2" => "filter: brightness(1.2) contrast(1.4) saturate(0) drop-shadow(0 0 4px rgba(255,255,255,0.75));",
                                "tier-5" => "filter: drop-shadow(0 0 4px #00ffd0);",
                                "tier-6" => "filter: drop-shadow(0 0 4px #a1c4fd);",
                                "tier-7" => "filter: drop-shadow(0 0 4px #ff0844);",
                                "tier-10" => "filter: drop-shadow(0 0 5px #39FF14);",
                                "tier-11" => "filter: drop-shadow(0 0 6px #C77DFF) drop-shadow(0 0 8px #E040FB);",
                                "vip-moc-1" => "filter: drop-shadow(0 0 5px #ffc107);",
                                "vip-moc-2" => "filter: drop-shadow(0 0 6px #ffc107);",
                                "vip-moc-3" => "filter: drop-shadow(0 0 7px #ffc107);",
                                "vip-moc-4" => "filter: drop-shadow(0 0 8px #ffc107) drop-shadow(0 0 10px #ff0000);",
                                _ => ""
                            };
                            var isVipFrame = Model.EquippedAvatarFrame.StartsWith("vip-moc-");
                            folder = isVipFrame ? "khung-vip" : "khung-avatar";
                            frameSize = (Model.EquippedAvatarFrame == "tier-9" || isVipFrame) ? "width: 180px; height: 180px;" : "width: 158px; height: 158px;";
                        }

                        if (frameFile != null)
                        {
                            <img class="avatar-frame-large" src="/image/@folder/@frameFile" asp-append-version="true" style="@(frameSize) max-width: none !important; max-height: none !important; flex-shrink: 0 !important; @frameFilter" />
                        }
                    }
                </div>

                <!-- Equipped Badge at the bottom of Avatar -->
                @if (!string.IsNullOrEmpty(Model.EquippedBadge) && Model.EquippedBadge != "none")
                {
                    var badgeFile = Model.EquippedBadge switch
                    {
                        "vip-badge-1" => "thich-thi-nap.png",
                        "vip-badge-2" => "giau-nut-vach.png",
                        "vip-badge-3" => "vung-tien-nhu-nuoc.png",
                        "vip-badge-4" => "nha-co-mo.png",
                        _ => null
                    };
                    if (badgeFile != null)
                    {
                        <div style="position: absolute; bottom: -110px; left: 50%; transform: translateX(-50%); z-index: 10; pointer-events: none; width: 200px; height: 200px; display: flex; align-items: center; justify-content: center;">
                            <img src="/image/huy-hieu/@badgeFile" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));" />
                        </div>
                    }
                }
            </div>
            @if (Model.RoleName != "Customer" && Model.RoleName != "Admin" && !string.IsNullOrEmpty(Model.RoleName))
            {
                <div style="font-size: 15px; font-weight: 800; color: #1a7a2e; background: #e8f7ec; padding: 6px 16px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; margin: 15px 0; border: 1.5px solid #cde9d5; box-shadow: 0 2px 8px rgba(26,122,46,0.08);">
                    <i class="bi bi-person-badge-fill"></i> @Model.RoleName
                </div>
            }
            @{
                string[] tierIcons = { "bi-circle-fill", "bi-hexagon-fill", "bi-shield-fill", "bi-star-fill", "bi-diamond-fill", "bi-gem", "bi-gem", "bi-trophy-fill", "bi-award-fill", "bi-brightness-high-fill", "bi-radioactive", "bi-stars" };
                string tierIcon = tierIcons[Math.Clamp(displayLvl, 0, tierIcons.Length - 1)];
                string displayTierName = WebBanHang.Services.LoyaltyService.GetTierName(displayLvl);
            }
            @if (true)
            {
                <div class="tier-badge tier-@displayLvl mb-3" id="profileTierBadge">
                    <i class="bi @tierIcon" id="profileTierIcon"></i> <span id="profileTierName">@displayTierName</span>
                </div>
                <div class="mb-1 text-muted small fw-bold text-uppercase">Điểm tích lũy</div>
                <div class="point-num">@Model.LoyaltyPoints.ToString("N0")</div>
                <div class="text-muted small mt-2">Điểm cộng theo công thức: giá trị đơn hàng (trước khi giảm giá) / 200.</div>

                <div class="upgrade-box text-start mt-4">
                    @if (Model.UpgradeCost.HasValue && Model.NextTierName != null)
                    {
                        <div class="fw-bold mb-1">Nâng lên @Model.NextTierName</div>
                        <div class="small text-muted mb-3">Cần @Model.UpgradeCost.Value.ToString("N0") điểm. Khi nâng cấp, điểm sẽ bị trừ.</div>
                        <form asp-action="UpgradeTier" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold" @(Model.CanUpgrade ? "" : "disabled")>
                                <i class="bi bi-arrow-up-circle me-1"></i> Nâng hạng
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="fw-bold text-success"><i class="bi bi-trophy-fill me-1"></i> Bạn đã đạt cấp cao nhất.</div>
                    }
                </div>

                <div class="mt-3">
                    <button type="button" id="btnToggleProfile" class="btn btn-outline-secondary w-100 rounded-pill fw-bold btn-sm">
                        <i class="bi bi-person-lines-fill me-1"></i> Thông tin cá nhân
                    </button>
                </div>
                <div class="mt-2">
                    <button type="button" id="btnToggleStore" class="btn btn-outline-danger w-100 rounded-pill fw-bold btn-sm">
                        <i class="bi bi-shop me-1"></i> Cửa hàng
                    </button>
                </div>
                <div class="mt-2">
                    <button type="button" id="btnToggleAchievement" class="btn btn-outline-warning w-100 rounded-pill fw-bold btn-sm">
                        <i class="bi bi-trophy-fill me-1"></i> Thành tích
                    </button>
                </div>
                <div class="mt-2">
                    <button type="button" id="btnToggleInventory" class="btn btn-outline-success w-100 rounded-pill fw-bold btn-sm">
                        <i class="bi bi-briefcase me-1"></i> Túi đồ cá nhân
                    </button>
                </div>
                <div class="mt-2">
                    <button type="button" id="btnToggleOrderHistory" class="btn btn-outline-info w-100 rounded-pill fw-bold btn-sm">
                        <i class="bi bi-clock-history me-1"></i> Lịch sử mua hàng
                    </button>
                </div>
                <div class="mt-2">
                    <button type="button" id="btnToggleAiChatHistory" class="btn btn-outline-primary w-100 rounded-pill fw-bold btn-sm">
                        <i class="bi bi-robot me-1"></i> Lịch sử chat AI
                    </button>
                </div>
            }
        </aside>

        <div id="profileMainColumn" class="profile-main-column">
            <div id="profileEditSection">
            <section class="profile-card">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="field-label"><i class="bi bi-person-badge me-1"></i>@(isCustomerOrAdmin ? "Tên khách hàng" : "Tên nhân viên")</label>
                        <input asp-for="FullName" class="form-control" placeholder="@(isCustomerOrAdmin ? "Nhập tên hiển thị của bạn..." : "Nhập tên nhân viên...")" />
                        <div class="text-muted small mt-1">@(isCustomerOrAdmin ? "Tên này sẽ hiển thị trên trang chủ thay cho email." : "Tên hiển thị của nhân viên trên hệ thống.")</div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        @if (Model.MembershipLevel > 0)
                        {
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayMembershipLevel" class="field-label"><i class="bi bi-award-fill me-1"></i>Cấp bậc hiển thị</label>
                                <select asp-for="DisplayMembershipLevel" asp-items="Model.AvailableDisplayLevels" class="form-select"></select>
                                <div class="text-muted small mt-1">Chọn cấp hiển thị thấp hơn nếu muốn bảo mật thông tin.</div>
                                <span asp-validation-for="DisplayMembershipLevel" class="text-danger small"></span>
                            </div>
                        }
                        <input type="hidden" asp-for="EquippedAvatarFrame" id="equippedAvatarFrameSelect" />
                        <input type="hidden" asp-for="EquippedBadge" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="field-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="field-label">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AvatarUrl" class="field-label">Ảnh đại diện</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input asp-for="AvatarUrl" class="form-control" id="avatarInput" placeholder="Dán URL ảnh đại diện..." />
                            <span class="text-muted small">hoặc</span>
                            <label for="avatarFile" class="btn btn-outline-secondary btn-sm mb-0 px-3 py-2 fw-bold text-nowrap" style="cursor: pointer; border-radius: 8px;">
                                <i class="bi bi-upload me-1"></i> Chọn file
                            </label>
                            <input type="file" name="avatarFile" id="avatarFile" class="d-none" accept="image/*" />
                        </div>
                        <div id="fileSelectedName" class="text-success small mt-1 fw-bold" style="display: none;"></div>
                    </div>

                    @if (true)
                    {
                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="field-label">Địa chỉ giao hàng</label>
                            <textarea asp-for="ShippingAddress" class="form-control" rows="4" placeholder="Nhập địa chỉ giao hàng mặc định..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BankAccountLink" class="field-label">Liên kết tài khoản ngân hàng</label>
                            <input asp-for="BankAccountLink" class="form-control" placeholder="Ví dụ: ngân hàng, số tài khoản, tên chủ tài khoản hoặc liên kết ví..." />
                        </div>

                        <div class="mb-4">
                            <label class="field-label"><i class="bi bi-share-fill me-1"></i>Liên kết tài khoản mạng xã hội</label>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light d-flex align-items-center justify-content-between" style="border: 1px solid #dee2e6 !important;">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-google text-danger fs-4"></i>
                                            <div>
                                                <div class="fw-bold small text-dark">Tài khoản Google</div>
                                                <div class="text-muted small" style="font-size: 11px;">
                                                    @(!string.IsNullOrEmpty(Model.GoogleEmail) ? Model.GoogleEmail : "Chưa liên kết")
                                                </div>
                                            </div>
                                        </div>
                                        @if (string.IsNullOrEmpty(Model.GoogleEmail))
                                        {
                                            <a href="javascript:void(0);" onclick="openOAuthPopup('/MockAuth/GoogleLink')" class="btn btn-outline-danger btn-sm fw-bold rounded-pill px-3">
                                                <i class="bi bi-plus-circle me-1"></i>Liên kết
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i>Đã liên kết</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light d-flex align-items-center justify-content-between" style="border: 1px solid #dee2e6 !important;">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-facebook text-primary fs-4"></i>
                                            <div>
                                                <div class="fw-bold small text-dark">Tài khoản Facebook</div>
                                                <div class="text-muted small" style="font-size: 11px;">
                                                    @(!string.IsNullOrEmpty(Model.FacebookName) ? Model.FacebookName : "Chưa liên kết")
                                                </div>
                                            </div>
                                        </div>
                                        @if (string.IsNullOrEmpty(Model.FacebookName))
                                        {
                                            <a href="javascript:void(0);" onclick="openOAuthPopup('/MockAuth/FacebookLink')" class="btn btn-outline-primary btn-sm fw-bold rounded-pill px-3">
                                                <i class="bi bi-plus-circle me-1"></i>Liên kết
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i>Đã liên kết</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn-save-profile">
                        <i class="bi bi-check2-circle me-1"></i> Lưu thông tin
                    </button>
                </form>
            </section>
        </div>


    <!-- ALERT: Frame exchange / equip success -->
    @if (TempData["FrameSuccess"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["FrameSuccess"]?.ToString() ?? ""))', 'success');
            });
        </script>
    }
    @if (TempData["FrameEquipSuccess"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["FrameEquipSuccess"]?.ToString() ?? ""))', 'success');
            });
        </script>
    }

    @if (true)
    {
    <!-- CỬA HÀNG ĐỔI MÃ GIẢM GIÁ -->
    <div id="voucherStoreSection" class="d-none">
        <div class="profile-card">
            <h4 class="fw-bold mb-3 text-success" style="font-weight:900;">
                <i class="bi bi-shop me-2"></i>Cửa hàng
            </h4>

            <!-- Sub-category tab buttons -->
            <div class="d-flex gap-2 flex-wrap mb-4">
                <button type="button" id="btnSubTierVoucher"
                        class="store-sub-btn btn btn-success btn-sm rounded-pill fw-bold px-4"
                        onclick="switchStoreSub('tier')">
                    <i class="bi bi-award me-1"></i>Mã Độc Quyền Theo Cấp Bậc
                </button>
                <button type="button" id="btnSubDailyVoucher"
                        class="store-sub-btn btn btn-outline-success btn-sm rounded-pill fw-bold px-4"
                        onclick="switchStoreSub('daily')">
                    <i class="bi bi-lightning-charge-fill me-1"></i>Mã Giảm Giá Hàng Ngày
                </button>
                <button type="button" id="btnSubAvatarFrame"
                        class="store-sub-btn btn btn-outline-success btn-sm rounded-pill fw-bold px-4"
                        onclick="switchStoreSub('frame')">
                    <i class="bi bi-person-bounding-box me-1"></i>Khung Avatar
                </button>

            </div>

            <!-- Sub: Mã Độc Quyền Theo Cấp Bậc -->
            <div id="storeSub-tier" class="store-sub-panel">
                <p class="text-muted small mb-3">
                    Đổi điểm tích lũy lấy mã giảm giá độc quyền theo cấp bậc của bạn. Cấp cao có thể đổi mã của cấp thấp hơn. Mỗi mã chỉ được đổi 1 lần.
                </p>
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.VoucherStoreItems)
                    {
                        var isLocked = Model.MembershipLevel < item.Level;
                        <div class="voucher-store-card p-3 @(item.IsExchanged ? "exchanged" : "")">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                        @item.Title
                                        <span class="badge bg-secondary-subtle text-secondary small">@item.TierName</span>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        @if (item.IsExchanged)
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Đã đổi: </span>
                                            <code class="bg-dark text-white px-2 py-1 rounded">@item.GeneratedCode</code>
                                        }
                                        else
                                        {
                                            <span>Yêu cầu: <strong>@item.RequiredPoints điểm</strong> &amp; @item.TierName</span>
                                        }
                                    </div>
                                </div>
                                <div style="flex-shrink: 0; margin-left: 15px;">
                                    @if (item.IsExchanged)
                                    {
                                        <button class="btn btn-secondary btn-sm rounded-pill fw-bold" style="white-space: nowrap; font-weight: 800;" disabled>Đã sở hữu</button>
                                    }
                                    else if (isLocked)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold" style="white-space: nowrap; font-weight: 800;" disabled title="Chưa đạt cấp bậc yêu cầu">
                                            <i class="bi bi-lock-fill"></i> Khóa
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="ExchangeVoucher" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="level" value="@item.Level" />
                                            <input type="hidden" name="suffix" value="@item.Suffix" />
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill fw-bold" style="white-space: nowrap; font-weight: 800;" @(item.CanExchange ? "" : "disabled")>
                                                Đổi mã
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Sub: Mã Giảm Giá Hàng Ngày -->
            <div id="storeSub-daily" class="store-sub-panel d-none">
                <p class="text-muted small mb-3">
                    Làm mới mỗi ngày vào lúc 12:00 SA. Mọi cấp độ thành viên đều có thể đổi.
                </p>
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.DailyVouchers)
                    {
                        <div class="voucher-store-card p-3 @(item.IsExchanged ? "exchanged" : "")" style="@(item.IsFreeShip ? "border: 2px dashed #ff5722; background: #fffcfb;" : "")">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark d-flex align-items-center flex-wrap gap-2">
                                        @if (item.IsFreeShip)
                                        {
                                            <span class="text-danger"><i class="bi bi-truck me-1"></i><strong>@item.Title</strong></span>
                                            <span class="badge bg-danger text-white">FREE SHIP GIỚI HẠN</span>
                                            @if (!item.IsExchanged)
                                            {
                                                if (item.IsActiveNow)
                                                {
                                                    <span class="badge bg-success" style="animation: opacityPulse 1.5s infinite;">@item.FreeShipStatusText</span>
                                                }
                                                else if (item.FreeShipStatusText != null && (item.FreeShipStatusText.Contains("SẮP MỞ BÁN") || item.FreeShipStatusText.Contains("Mở bán vào")))
                                                {
                                                    <span class="badge bg-warning text-dark">@item.FreeShipStatusText</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-white">@item.FreeShipStatusText</span>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            @item.Title
                                            <span class="badge bg-success-subtle text-success small">Hàng ngày</span>
                                        }
                                    </div>
                                    <div class="small text-muted mt-1">
                                        @if (item.IsExchanged)
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Đã đổi: </span>
                                            <code class="bg-dark text-white px-2 py-1 rounded">@item.GeneratedCode</code>
                                        }
                                        else
                                        {
                                            <span>Yêu cầu: <strong>@item.RequiredPoints điểm</strong></span>
                                        }
                                    </div>
                                </div>
                                <div style="flex-shrink: 0; margin-left: 15px;">
                                    @if (item.IsExchanged)
                                    {
                                        <button class="btn btn-secondary btn-sm rounded-pill fw-bold" style="white-space: nowrap; font-weight: 800;" disabled>Đã sở hữu</button>
                                    }
                                    else
                                    {
                                        <form asp-action="ExchangeDailyVoucher" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="index" value="@item.Index" />
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill fw-bold" style="white-space: nowrap; font-weight: 800;" @(item.CanExchange ? "" : "disabled")>
                                                Đổi mã
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Sub: Khung Avatar Store -->
            <div id="storeSub-frame" class="store-sub-panel d-none">
                <p class="text-muted small mb-3">
                    Đổi điểm tích lũy lấy khung avatar độc đáo. Sau khi đổi, vào <strong>Túi đồ cá nhân → Khung avatar</strong> để trang bị.
                </p>

                <!-- Sub-tabs within Avatar Frame Store -->
                <div class="d-flex gap-2 flex-wrap mb-4 border-bottom pb-3">
                    <button type="button" id="btnFrameSubTier"
                            class="frame-sub-btn btn btn-success btn-sm rounded-pill fw-bold px-4"
                            onclick="switchFrameSub('tier')">
                        <i class="bi bi-award me-1"></i>Khung cấp bậc
                    </button>
                    <button type="button" id="btnFrameSubDaily"
                            class="frame-sub-btn btn btn-outline-success btn-sm rounded-pill fw-bold px-4"
                            onclick="switchFrameSub('daily')">
                        <i class="bi bi-calendar-event me-1"></i>Khung theo ngày
                    </button>
                </div>

                <!-- Frame Panel: Khung Cấp Bậc -->
                <div id="framePanel-tier" class="frame-sub-panel">
                    <div class="row g-3">
                        @foreach (var frame in Model.FrameStoreItems)
                        {
                            <div class="col-6 col-sm-4 col-md-3">
                                <div class="frame-store-card @(frame.IsOwned ? "owned" : frame.CanBuy ? "available" : "locked")"
                                     style="border-radius: 14px; border: 2px solid @(frame.IsOwned ? "#4caf50" : frame.CanBuy ? "#2196f3" : "#ddd"); padding: 14px; text-align: center; transition: all 0.25s; position: relative; background: @(frame.IsOwned ? "#f1fff4" : frame.CanBuy ? "#f0f7ff" : "#fafafa");">
                                    @if (frame.IsOwned)
                                    {
                                        <div style="position: absolute; top: 7px; right: 7px;">
                                            <span class="badge bg-success" style="font-size: 10px;"><i class="bi bi-check-circle-fill"></i> Sở hữu</span>
                                        </div>
                                    }
                                    else if (frame.RequiresTier)
                                    {
                                        <div style="position: absolute; top: 7px; right: 7px;">
                                            <span class="badge bg-secondary" style="font-size: 10px;"><i class="bi bi-lock-fill"></i></span>
                                        </div>
                                    }
                                    <div style="position: relative; width: 90px; height: 90px; margin: 0 auto 10px; display: flex; align-items: center; justify-content: center;">
                                        <div style="width: 70px; height: 70px; border-radius: 50%; background: #e8f7ec; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                            <i class="bi bi-person-fill" style="font-size: 36px; color: #1a7a2e;"></i>
                                        </div>
                                        <img src="/image/khung-avatar/@frame.FileName"
                                             style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; @frame.FilterStyle" />
                                    </div>
                                    <div class="fw-bold text-dark" style="font-size: 12px; margin-bottom: 4px;">@frame.Name</div>
                                    <div class="text-muted" style="font-size: 11px; margin-bottom: 8px;">
                                        @if (frame.Cost == 0) { <span class="text-success fw-bold">Miễn phí</span> }
                                        else { <span>@frame.Cost.ToString("N0") điểm</span> }
                                    </div>
                                    @if (frame.IsOwned)
                                    {
                                        <button class="btn btn-success btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;" disabled>Đã sở hữu</button>
                                    }
                                    else if (frame.RequiresTier)
                                    {
                                        <button class="btn btn-secondary btn-sm rounded-pill fw-bold w-100" style="font-size: 11px; font-weight: 800;" disabled title="Cần đạt @frame.TierName">
                                            <i class="bi bi-lock-fill"></i> @frame.TierName
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="ExchangeAvatarFrame" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="level" value="@frame.Level" />
                                            <button type="submit" class="btn @(frame.CanBuy ? "btn-primary" : "btn-outline-secondary") btn-sm rounded-pill fw-bold w-100"
                                                    style="font-size: 11px; font-weight: 800;" @(frame.CanBuy ? "" : "disabled")
                                                    title="@(frame.CanBuy ? "Đổi khung này" : "Không đủ điểm")">
                                                Đổi
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Frame Panel: Khung Theo Ngày -->
                <div id="framePanel-daily" class="frame-sub-panel d-none">
                    <!-- Reset & Refresh Section -->
                    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px; background: linear-gradient(135deg, #fff7f3 0%, #fff 100%); border-left: 5px solid #ff5722 !important;">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history me-2 text-warning"></i>Khung Xoay Tua Theo Ngày</h5>
                                <p class="text-muted small mb-0">
                                    Hệ thống tự động làm mới lúc <strong>00:00 SA</strong> hàng ngày. Bạn có <strong>3 lượt miễn phí</strong> và <strong>3 lượt tính phí</strong> bằng điểm mỗi ngày.
                                </p>
                            </div>
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="bg-white px-3 py-2 rounded-pill border text-center shadow-sm">
                                    <span class="text-muted small d-block">Đã dùng hôm nay</span>
                                    <strong class="text-danger">@Model.DailyFrameResetsUsed / 6</strong> <span class="text-muted small">lượt</span>
                                </div>
                                @if (Model.DailyFrameResetsUsed < 6)
                                {
                                    <form asp-action="RefreshDailyFrames" method="post" id="refreshFramesForm" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-warning rounded-pill fw-bold text-white px-4 shadow-sm" style="transition: all 0.2s;" onclick="showCustomRefreshModal(@Model.NextResetCost);">
                                            <i class="bi bi-arrow-clockwise me-1"></i> Làm mới 
                                            @if (Model.NextResetCost == 0)
                                            {
                                                <span>(Miễn phí)</span>
                                            }
                                            else
                                            {
                                                <span>(@Model.NextResetCost điểm)</span>
                                            }
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary rounded-pill fw-bold px-4" disabled>
                                        <i class="bi bi-slash-circle me-1"></i> Hết lượt đổi hôm nay
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Frames Grid -->
                    <div class="row g-3">
                        @foreach (var frame in Model.DailyFrames)
                        {
                            var cardBorderColor = frame.IsLimited ? "#ff5722" : frame.IsOwned ? "#4caf50" : "#2196f3";
                            var cardBg = frame.IsLimited ? "linear-gradient(135deg, #fff5f0 0%, #fff 100%)" : frame.IsOwned ? "#f1fff4" : "#f0f7ff";
                            var folder = frame.IsLimited ? "khung-theo-ngay/khung-gioi-han" : "khung-theo-ngay/khung-thuong";
                            var pulseClass = frame.IsLimited ? "limited-pulse-glow" : "";

                            <div class="col-6 col-sm-4 col-md-3">
                                <div class="frame-store-card @(frame.IsOwned ? "owned" : frame.CanBuy ? "available" : "locked") @pulseClass"
                                     style="border-radius: 16px; border: 2px solid @cardBorderColor; padding: 16px; text-align: center; transition: all 0.25s; position: relative; background: @cardBg; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                                    
                                    <!-- Badges & Countdown on Card -->
                                    <div style="position: absolute; top: 8px; left: 8px; right: 8px; display: flex; justify-content: space-between; align-items: center; pointer-events: none; z-index: 5;">
                                        @if (frame.IsLimited)
                                        {
                                            <!-- Countdown -->
                                            <span class="badge bg-dark text-white fw-bold px-2 py-1 shadow-sm daily-countdown" style="font-size: 10px; font-family: monospace; border-left: 3px solid #ff5722;">00:00:00</span>
                                            <!-- Limited Tag -->
                                            <span class="badge bg-danger text-white fw-bold px-2 py-1 shadow-sm" style="font-size: 9px; letter-spacing: 0.5px; animation: pulse 1.5s infinite;">LIMITED</span>
                                        }
                                        else
                                        {
                                            <span></span> <!-- placeholder -->
                                            @if (frame.IsOwned)
                                            {
                                                <span class="badge bg-success shadow-sm" style="font-size: 10px;"><i class="bi bi-check-circle-fill"></i> Sở hữu</span>
                                            }
                                        }
                                    </div>

                                    <div class="mt-3">
                                        <div style="position: relative; width: 96px; height: 96px; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center;">
                                            <div style="width: 74px; height: 74px; border-radius: 50%; background: #e8f7ec; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                                <i class="bi bi-person-fill" style="font-size: 38px; color: #1a7a2e;"></i>
                                            </div>
                                            <img src="/image/@folder/@frame.FileName" asp-append-version="true"
                                                 style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; @(frame.IsLimited ? "filter: drop-shadow(0 0 4px #ff5722);" : "")" />
                                        </div>
                                        <div class="fw-bold text-dark mb-1" style="font-size: 13px; min-height: 20px;">@frame.Name</div>
                                        <div class="text-muted fw-bold mb-3" style="font-size: 12px;">
                                            @if (frame.IsLimited)
                                            {
                                                <span class="text-danger"><i class="bi bi-gem me-1"></i>400 điểm</span>
                                            }
                                            else
