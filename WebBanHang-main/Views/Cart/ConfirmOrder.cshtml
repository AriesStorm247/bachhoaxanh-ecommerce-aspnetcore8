            font-size: 14px;
            margin-bottom: 8px;
        }

        .form-control {
            border: 1px solid #e0e0e0;
            padding: 12px 20px;
            font-size: 14px;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #1a7a2e;
            }

        .rounded-pill {
            border-radius: 50px !important;
        }

        .alert-custom {
            background-color: #d1f3ff;
            border: none;
            color: #055160;
            font-size: 13px;
            border-radius: 10px;
            padding: 12px 15px;
        }

        .btn-confirm {
            background-color: #1a7a2e;
            color: #fff;
            border: none;
            padding: 15px;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(26, 122, 46, 0.2);
            width: 100%;
            border-radius: 50px;
        }

            .btn-confirm:hover {
                background-color: #145c23;
                transform: translateY(-2px);
                color: #fff;
            }

        .btn-back {
            color: #666;
            text-decoration: none;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            margin-bottom: 20px;
            transition: color 0.2s;
        }

            .btn-back:hover {
                color: #1a7a2e;
            }

        .price-red {
            color: #e82828;
            font-weight: 700;
        }

        .btn-select-map {
            background-color: #1a7a2e;
            color: #fff;
            border: none;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 16px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-select-map:hover {
            background-color: #145c23;
            transform: scale(1.02);
            color: #fff;
        }

        .shipping-option-card {
            transition: all 0.2s ease-in-out;
            border: 2px solid #e0e0e0 !important;
            background-color: #fff;
            cursor: pointer;
        }

        .shipping-option-card:hover {
            border-color: #1a7a2e !important;
            background-color: #f1f9f2;
            transform: translateY(-1px);
        }

        .shipping-option-card.active {
            border-color: #1a7a2e !important;
            background-color: #f1f9f2;
            box-shadow: 0 4px 15px rgba(26, 122, 46, 0.1);
        }

        .shipping-option-card.active::after {
            content: "\F272";
            font-family: "bootstrap-icons";
            position: absolute;
            top: 10px;
            right: 10px;
            color: #1a7a2e;
            font-size: 16px;
            font-weight: bold;
        }

        /* DARK THEME SUPPORT */
        html.dark-theme body {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }
        html.dark-theme .card-custom {
            background: #1e1e1e !important;
            border-color: #333 !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
            color: #e0e0e0 !important;
        }
        html.dark-theme .card-title,
        html.dark-theme h4,
        html.dark-theme h5,
        html.dark-theme label,
        html.dark-theme .form-label,
        html.dark-theme th,
        html.dark-theme td {
            color: #e0e0e0 !important;
        }
        html.dark-theme span:not(#map-layers-control span):not(#map-layers-toggle-btn span) {
            color: #e0e0e0 !important;
        }
        html.dark-theme .btn-back {
            color: #aaa !important;
        }
        html.dark-theme .btn-back:hover {
            color: #2c9e47 !important;
        }
        html.dark-theme .form-control {
            background-color: #242424 !important;
            color: #f5f5f5 !important;
            border-color: #444 !important;
        }
        html.dark-theme .form-control:focus {
            background-color: #2b2b2b !important;
            color: #fff !important;
            border-color: #2c9e47 !important;
        }
        html.dark-theme .text-muted {
            color: #aaa !important;
        }
        html.dark-theme .table,
        html.dark-theme .table tr,
        html.dark-theme .table td,
        html.dark-theme .table th {
            background-color: transparent !important;
            background: transparent !important;
            color: #e0e0e0 !important;
        }
        html.dark-theme .table tbody td {
            border-bottom: 1px solid #333 !important;
        }
        html.dark-theme .shipping-option-card {
            background-color: #1e1e1e !important;
            border-color: #444 !important;
        }
        html.dark-theme .shipping-option-card:hover {
            background-color: #203a27 !important;
            border-color: #2c9e47 !important;
        }
        html.dark-theme .shipping-option-card.active {
            background-color: #203a27 !important;
            border-color: #2c9e47 !important;
            box-shadow: 0 4px 15px rgba(44, 158, 71, 0.2) !important;
        }
        html.dark-theme .shipping-option-card.active::after {
            color: #8ae49f !important;
        }
        html.dark-theme #map {
            border-color: #444 !important;
        }
        html.dark-theme .text-success {
            color: #8ae49f !important;
        }
        html.dark-theme .price-red {
            color: #ff6b6b !important;
        }
        html.dark-theme #deliveryDistanceCard {
            background-color: #1e1e1e !important;
            border-color: #333 !important;
        }
        html.dark-theme .bg-success-subtle {
            background-color: #203a27 !important;
            color: #8ae49f !important;
            border: 1px solid #2c9e47 !important;
        }
        html.dark-theme #storeBranchDisplay {
            color: #8ae49f !important;
        }
        html.dark-theme #distanceDisplay {
            color: #ffb84d !important;
        }
        html.dark-theme .alert-custom {
            background-color: #1a3038 !important;
            color: #72dbec !important;
        }
        html.dark-theme .bg-light {
            background-color: #242424 !important;
            color: #e0e0e0 !important;
        }
        html.dark-theme #mapSearchInput {
            color: #000000 !important;
            background-color: #ffffff !important;
        }
        html.dark-theme #mapSearchInput::placeholder {
            color: #777 !important;
        }

        /* Giao diện danh sách chi nhánh hiển thị trong modal tìm kiếm */
        #branchSearchResults {
            background: #ffffff;
            color: #333333;
        }

        html.dark-theme #branchSearchResults {
            background: #1e1e1e !important;
            border-color: #333 !important;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4) !important;
            color: #e0e0e0 !important;
        }

        .branch-search-item {
            padding: 12px 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .branch-search-item:last-child {
            border-bottom: none;
        }

        .branch-search-item:hover {
            background-color: #f1f9f2;
        }

        html.dark-theme .branch-search-item {
            border-bottom-color: #2b2b2b !important;
        }

        html.dark-theme .branch-search-item:hover {
            background-color: #203a27 !important;
        }

        .branch-search-item .bi-geo-alt-fill {
            font-size: 18px;
            color: #1a7a2e;
        }

        html.dark-theme .branch-search-item .bi-geo-alt-fill {
            color: #2c9e47 !important;
        }

        .branch-name-display {
            font-weight: 600;
            color: #212529;
        }

        html.dark-theme .branch-name-display {
