            background-color: #f8f9fa;
            font-family: 'Be Vietnam Pro', sans-serif;
            color: #333;
        }

        .checkout-container {
            max-width: 1100px;
            margin-top: 50px;
        }

        .card-custom {
            background: #fff;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            padding: 30px;
            height: 100%;
        }

        .card-title {
            font-weight: 700;
            font-size: 24px;
            margin-bottom: 25px;
        }

        .table thead th {
            border: none;
            color: #6c757d;
            font-size: 14px;
