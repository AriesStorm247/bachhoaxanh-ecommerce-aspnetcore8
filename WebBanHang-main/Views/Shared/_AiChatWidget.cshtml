<script>
    (function () {
        if (window.__aiChatWidgetLoaded) return;
        window.__aiChatWidgetLoaded = true;

        document.addEventListener('DOMContentLoaded', function () {
            const widget = document.getElementById('aiChatWidget');
            const toggle = document.getElementById('aiChatToggle');
            const close = document.getElementById('aiChatClose');
            const form = document.getElementById('aiChatForm');
            const input = document.getElementById('aiChatInput');
            const messages = document.getElementById('aiChatMessages');
            const resetBtn = document.getElementById('aiChatReset');
            const btnUploadImage = document.getElementById('btnUploadImage');

            if (!widget || !toggle || !close || !form || !input || !messages || !resetBtn) return;

            let isMuted = true; // Mặc định tắt tiếng

            // ── SESSION STORAGE: LƯU & KHÔI PHỤC LỊCH SỬ CHAT ──────────────
            const STORAGE_KEY = 'aiChatHistory_v1';
            const STORAGE_OPEN_KEY = 'aiChatWidgetOpen';

            function saveChatHistory() {
                try {
                    const msgs = messages.querySelectorAll('.ai-chat-msg-row');
                    const history = [];
                    msgs.forEach(function (row) {
                        const isBot = row.classList.contains('bot');
                        const bubble = row.querySelector('.ai-chat-msg');
                        if (!bubble) return;
                        const imgEl = bubble.querySelector('img');
                        history.push({
                            type: isBot ? 'bot' : 'user',
                            html: bubble.innerHTML,
                            hasImage: !!imgEl
                        });
                    });
                    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history));
                } catch (e) {}
            }

            function loadChatHistory() {
                try {
                    const raw = sessionStorage.getItem(STORAGE_KEY);
                    if (!raw) return;
                    const history = JSON.parse(raw);
                    if (!history || history.length === 0) return;

                    // Xóa tin chào mặc định nếu có lịch sử lưu
                    messages.innerHTML = '';

                    history.forEach(function (item) {
                        const row = document.createElement('div');
                        if (item.type === 'bot') {
                            row.className = 'ai-chat-msg-row bot';
                            const avatar = document.createElement('div');
                            avatar.className = 'bot-avatar-container';
                            avatar.innerHTML = '<img src="/image/robot_avatar.webp" alt="Robot Avatar" class="bot-avatar-img" />';
                            const bubble = document.createElement('div');
                            bubble.className = 'ai-chat-msg bot-bubble';
                            bubble.innerHTML = item.html;
                            row.appendChild(avatar);
                            row.appendChild(bubble);
                        } else {
                            row.className = 'ai-chat-msg-row user';
                            const bubble = document.createElement('div');
                            bubble.className = 'ai-chat-msg user-bubble';
                            bubble.innerHTML = item.html;
                            row.appendChild(bubble);
                        }
                        messages.appendChild(row);
                    });
                    messages.scrollTop = messages.scrollHeight;
                } catch (e) {}
            }

            // Khôi phục lịch sử chat khi tải trang
            loadChatHistory();

            // Khôi phục trạng thái mở/đóng widget
            if (sessionStorage.getItem(STORAGE_OPEN_KEY) === '1') {
                widget.classList.add('open');
            }

            // Sự kiện Mở/Đóng widget
            toggle.addEventListener('click', function () {
                widget.classList.add('open');
                sessionStorage.setItem(STORAGE_OPEN_KEY, '1');
                input.focus();
            });

            close.addEventListener('click', function () {
                widget.classList.remove('open');
                sessionStorage.setItem(STORAGE_OPEN_KEY, '0');
            });

            // Nút đóng widget (lịch sử chat vẫn được giữ nguyên)
            resetBtn.addEventListener('click', function () {
                widget.classList.remove('open');
                sessionStorage.setItem(STORAGE_OPEN_KEY, '0');
            });

            // Xử lý tải ảnh / dán ảnh từ clipboard / kéo thả ảnh
            const aiChatImageInput = document.getElementById('aiChatImageInput');
            const imagePreviewContainer = document.getElementById('imagePreviewContainer');
            const imagePreview = document.getElementById('imagePreview');
            const btnRemoveImage = document.getElementById('btnRemoveImage');
            let currentImage = null;

            function processImageFile(file) {
                if (!file || !file.type.startsWith('image/')) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    const base64Data = e.target.result.split(',')[1];
                    const mimeType = file.type;
                    
                    currentImage = {
                        mimeType: mimeType,
                        data: base64Data,
                        src: e.target.result
                    };
                    
                    if (imagePreview) imagePreview.src = e.target.result;
                    if (imagePreviewContainer) imagePreviewContainer.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }

            if (btnUploadImage && aiChatImageInput) {
                btnUploadImage.addEventListener('click', function () {
                    aiChatImageInput.click();
                });
            }

            if (aiChatImageInput) {
                aiChatImageInput.addEventListener('change', function () {
                    const file = aiChatImageInput.files[0];
                    if (file) {
                        processImageFile(file);
                    }
                });
            }

            // Dán hình ảnh từ clipboard (Ctrl+V hoặc Context menu paste)
            function handlePasteImage(e) {
                const clipboardData = e.clipboardData || window.clipboardData;
                if (!clipboardData || !clipboardData.items) return;

                for (let i = 0; i < clipboardData.items.length; i++) {
                    const item = clipboardData.items[i];
                    if (item.type.indexOf('image') !== -1) {
                        e.preventDefault();
                        const file = item.getAsFile();
                        if (file) {
                            processImageFile(file);
                        }
                        break;
                    }
                }
            }

            input.addEventListener('paste', handlePasteImage);
            form.addEventListener('paste', handlePasteImage);

            // Kéo thả hình ảnh vào khung nhập
            form.addEventListener('dragover', function (e) {
                e.preventDefault();
            });
            form.addEventListener('drop', function (e) {
                e.preventDefault();
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    const file = e.dataTransfer.files[0];
                    if (file && file.type.startsWith('image/')) {
                        processImageFile(file);
                    }
                }
            });

            if (btnRemoveImage) {
                btnRemoveImage.addEventListener('click', function () {
                    currentImage = null;
                    if (aiChatImageInput) aiChatImageInput.value = '';
                    if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
                    if (imagePreview) imagePreview.src = '';
                });
            }

            // Phát tiếng Beep
            function playBeep(freq = 600, duration = 0.15) {
                if (isMuted) return;
                try {
                    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const oscillator = audioCtx.createOscillator();
                    const gainNode = audioCtx.createGain();
                    oscillator.connect(gainNode);
                    gainNode.connect(audioCtx.destination);
                    oscillator.type = 'sine';
                    oscillator.frequency.setValueAtTime(freq, audioCtx.currentTime);
                    gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);
                    oscillator.start();
                    oscillator.stop(audioCtx.currentTime + duration);
                } catch (e) {}
            }

            // Đưa tin nhắn mới vào khung chat
            function appendMessage(text, type, imageSrc = null) {
                const row = document.createElement('div');
                if (type === 'bot') {
                    row.className = 'ai-chat-msg-row bot';
                    
                    const avatar = document.createElement('div');
                    avatar.className = 'bot-avatar-container';
                    avatar.innerHTML = `<img src="/image/robot_avatar.webp" alt="Robot Avatar" class="bot-avatar-img" />`;
                    
                    const bubble = document.createElement('div');
                    bubble.className = 'ai-chat-msg bot-bubble';
                    bubble.textContent = text;
                    
                    row.appendChild(avatar);
                    row.appendChild(bubble);
                    messages.appendChild(row);
                    messages.scrollTop = messages.scrollHeight;
                    playBeep(550, 0.12);
                    return bubble;
                } else {
                    row.className = 'ai-chat-msg-row user';
                    
                    const bubble = document.createElement('div');
                    bubble.className = 'ai-chat-msg user-bubble';
                    
                    if (imageSrc) {
                        const img = document.createElement('img');
                        img.src = imageSrc;
                        img.style.maxWidth = '100%';
                        img.style.maxHeight = '150px';
                        img.style.borderRadius = '8px';
                        img.style.marginBottom = '6px';
                        img.style.display = 'block';
                        bubble.appendChild(img);
                    }
                    
                    if (text) {
                        const textSpan = document.createElement('span');
                        textSpan.textContent = text;
                        bubble.appendChild(textSpan);
                    } else {
                        bubble.style.padding = '6px';
                    }
                    
                    row.appendChild(bubble);
                    messages.appendChild(row);
                    messages.scrollTop = messages.scrollHeight;
                    playBeep(700, 0.08);
                    return bubble;
                }
            }

            // Gửi tin nhắn lên Server AI
            // Gửi tin nhắn lên Server AI
            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                const text = input.value.trim();
                if (!text && !currentImage) return;

                const imageSrcToSend = currentImage ? currentImage.src : null;
                const imageMimeTypeToSend = currentImage ? currentImage.mimeType : null;
                const imageDataToSend = currentImage ? currentImage.data : null;

                appendMessage(text, 'user', imageSrcToSend);
                saveChatHistory(); // Lưu sau khi user gửi
                input.value = '';

                // Reset image preview
                currentImage = null;
                if (aiChatImageInput) aiChatImageInput.value = '';
                if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
                if (imagePreview) imagePreview.src = '';

                // Chặn cục bộ nếu hỏi về thời gian mở cửa
                const textLower = text.toLowerCase();
                if (!imageSrcToSend && (textLower.includes('thời gian mở cửa') || textLower.includes('giờ mở cửa') || textLower.includes('mở cửa đến mấy giờ') || textLower.includes('mở cửa từ mấy giờ'))) {
                    input.disabled = true;
                    const pending = appendMessage('Đang kiểm tra...', 'bot');
                    setTimeout(() => {
                        pending.textContent = "Thời gian mở cửa siêu thị của tôi là từ 8 giờ sáng đến 10 giờ tối hằng ngày (kể cả thứ Bảy, Chủ Nhật và các ngày lễ). Rất hân hạnh được phục vụ quý khách!";
                        saveChatHistory(); // Lưu sau khi bot trả lời local
                        input.disabled = false;
                        input.focus();
                        messages.scrollTop = messages.scrollHeight;
                        playBeep(550, 0.12);
                    }, 500);
                    return;
                }

            function renderFormattedMarkdown(text) {
                if (!text) return '';
                let html = text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
                html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
                html = html.replace(/^[\-\*]\s+(.*)$/gm, '• $1');
                html = html.replace(/\n/g, '<br>');
                return html;
            }

            input.disabled = true;
            const pending = appendMessage('Đang trả lời...', 'bot');

            try {
                const response = await fetch('/Chat/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: text,
                        imageMimeType: imageMimeTypeToSend,
                        imageData: imageDataToSend
                    })
                });
                const data = await response.json();
                pending.innerHTML = renderFormattedMarkdown(data.reply || 'Hiện tại mình chưa trả lời được câu này.');
                saveChatHistory(); // Lưu sau khi bot trả lời API
            } catch {
                pending.innerHTML = 'Kết nối hỗ trợ AI đang gián đoạn. Bạn thử lại sau nhé.';
                saveChatHistory(); // Lưu cả khi lỗi để giữ tin nhắn user
            } finally {
                input.disabled = false;
                input.focus();
                messages.scrollTop = messages.scrollHeight;
            }
            });

            // Gửi câu hỏi gợi ý
            window.sendSuggestedQuestion = function(questionText) {
                input.value = questionText;
                form.dispatchEvent(new Event('submit'));
            };

            // Cuộn ngang các câu hỏi gợi ý
            window.scrollSuggestions = function(amount) {
                const container = document.getElementById('suggestedQuestionsContainer');
                if (container) {
                    container.scrollBy({ left: amount, behavior: 'smooth' });
                }
            };
        });
    })();
</script>

<script>
    /* ── SOCIAL FLOAT ICONS: Hiện khi scroll xuống, ẩn khi về đầu trang ── */
    (function() {
        const icons = document.getElementById('socialFloatIcons');
        if (!icons) return;

        const SCROLL_THRESHOLD = 80; // px – Bắt đầu hiện sau khi lướt xuống 80px

        function updateVisibility() {
            const scrollY = window.scrollY || window.pageYOffset;
            if (scrollY > SCROLL_THRESHOLD) {
                icons.classList.add('visible');
            } else {
                icons.classList.remove('visible');
            }
        }

        // Debounce để tối ưu hiệu năng
        let ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    updateVisibility();
                    ticking = false;
                });
                ticking = true;
            }
        }, { passive: true });

        // Kiểm tra ngay khi trang tải xong (trường hợp đã cuộn sẵn)
        updateVisibility();
    })();
</script>
