<script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectRegion = document.getElementById('selectRegion');
        const selectProvince = document.getElementById('selectProvince');
        const selectDistrict = document.getElementById('selectDistrict');
        const searchInput = document.getElementById('searchBranchInput');
        const container = document.getElementById('branchListContainer');
        const countText = document.getElementById('branchCountText');
        const clearBtn = document.getElementById('btnClearFilters');

        if (!selectRegion || !selectProvince || !selectDistrict || !searchInput || !container) return;

        let allBranches = [];
        const regionMap = {
            "Cần Thơ": "Miền Nam", "Đà Nẵng": "Miền Trung", "Hà Nội": "Miền Bắc", "Hải Phòng": "Miền Bắc",
            "Hồ Chí Minh": "Miền Nam", "Thừa Thiên Huế": "Miền Trung", "Huế": "Miền Trung", "An Giang": "Miền Nam", "Bắc Ninh": "Miền Bắc",
            "Cà Mau": "Miền Nam", "Đắk Lắk": "Miền Trung", "Đồng Nai": "Miền Nam", "Đồng Tháp": "Miền Nam",
            "Gia Lai": "Miền Trung", "Hà Tĩnh": "Miền Trung", "Hưng Yên": "Miền Bắc", "Khánh Hòa": "Miền Trung",
            "Lâm Đồng": "Miền Trung", "Nghệ An": "Miền Trung", "Ninh Bình": "Miền Bắc", "Quảng Ngãi": "Miền Trung",
            "Quảng Ninh": "Miền Bắc", "Quảng Trị": "Miền Trung", "Tây Ninh": "Miền Nam", "Thanh Hóa": "Miền Trung",
            "Vĩnh Long": "Miền Nam"
        };

        const branchAddressModalEl = document.getElementById('branchAddressModal');
        if (branchAddressModalEl) {
            branchAddressModalEl.addEventListener('show.bs.modal', function () {
                if (allBranches.length === 0) {
                    fetch('/Home/GetBranches')
                        .then(res => res.json())
                        .then(data => {
                            allBranches = data.map(item => {
                                let prov = item.province;
                                if (prov === "Huế") prov = "Thừa Thiên Huế";
                                const region = regionMap[prov] || "Miền Nam";
                                return {
                                    id: item.id,
                                    name: item.name,
                                    address: item.address,
                                    province: prov,
                                    district: item.district || "Khác",
                                    region: region
                                };
                            });
                            countText.innerText = `Tìm thấy ${allBranches.length} chi nhánh trên toàn quốc.`;
                            renderBranches(allBranches.slice(0, 12)); // Render first 12 as preview
                        })
                        .catch(err => {
                            console.error("Error loading branches:", err);
                            countText.innerText = "Lỗi khi tải danh sách chi nhánh.";
                        });
                }
            });
        }

        // Event listeners
        selectRegion.addEventListener('change', handleRegionChange);
        selectProvince.addEventListener('change', handleProvinceChange);
        selectDistrict.addEventListener('change', updateFilters);
        searchInput.addEventListener('input', updateFilters);
        clearBtn.addEventListener('click', clearFilters);

        function handleRegionChange() {
            const region = selectRegion.value;
            selectProvince.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
            selectDistrict.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            selectDistrict.disabled = true;

            if (!region) {
                selectProvince.disabled = true;
            } else {
                selectProvince.disabled = false;
                // Get unique provinces in this region
                const provinces = [...new Set(allBranches.filter(b => b.region === region).map(b => b.province))].sort();
                provinces.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p;
                    opt.textContent = p === "Thừa Thiên Huế" ? "Huế" : p;
                    selectProvince.appendChild(opt);
                });
            }
            updateFilters();
        }

        async function handleProvinceChange() {
            const prov = selectProvince.value;
            selectDistrict.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';

            if (!prov) {
                selectDistrict.disabled = true;
            } else {
                selectDistrict.disabled = false;
                try {
                    const response = await fetch(`/Home/GetWards?province=${encodeURIComponent(prov)}`);
                    const districts = await response.json();
                    districts.forEach(d => {
                        if (d && d !== "Khác") {
                            const opt = document.createElement('option');
                            opt.value = d;
                            opt.textContent = d;
                            selectDistrict.appendChild(opt);
                        }
                    });
                } catch (err) {
                    const districts = [...new Set(allBranches.filter(b => b.province === prov).map(b => b.district))].sort();
                    districts.forEach(d => {
                        if (d && d !== "Khác") {
                            const opt = document.createElement('option');
                            opt.value = d;
                            opt.textContent = d;
                            selectDistrict.appendChild(opt);
                        }
                    });
                }
            }
            updateFilters();
        }

        function updateFilters() {
            const region = selectRegion.value;
            const prov = selectProvince.value;
            const dist = selectDistrict.value;
            const query = searchInput.value.toLowerCase().trim();

            if (region || prov || dist || query) {
                clearBtn.style.display = "inline-block";
            } else {
                clearBtn.style.display = "none";
            }

            let filtered = allBranches;

            if (region) filtered = filtered.filter(b => b.region === region);
            if (prov) filtered = filtered.filter(b => b.province === prov);
            if (dist) filtered = filtered.filter(b => b.district === dist);
            if (query) {
                filtered = filtered.filter(b => 
                    b.name.toLowerCase().includes(query) || 
                    b.address.toLowerCase().includes(query)
                );
            }

            countText.innerText = `Tìm thấy ${filtered.length} chi nhánh.`;
            
            // Limit render to 100 max for performance
            renderBranches(filtered.slice(0, 100));
        }

        function clearFilters() {
            selectRegion.value = "";
            selectProvince.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
            selectProvince.disabled = true;
            selectDistrict.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            selectDistrict.disabled = true;
            searchInput.value = "";
            clearBtn.style.display = "none";
            updateFilters();
        }

        function renderBranches(list) {
            container.innerHTML = "";
            if (list.length === 0) {
                container.innerHTML = `
                    <div class="col-12 text-center py-4">
                        <i class="bi bi-geo-fill text-muted fs-2 mb-2 d-block"></i>
                        <span class="text-muted">Không tìm thấy chi nhánh nào phù hợp với bộ lọc.</span>
                    </div>
                `;
                return;
            }

            list.forEach(b => {
                const col = document.createElement('div');
                col.className = "col-md-6";
                col.innerHTML = `
                    <div class="p-3 border rounded shadow-sm bg-white h-100 branch-card-item d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-house-fill text-success me-2"></i>${b.name}</h6>
                            <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>${b.address}</p>
                        </div>
                        <a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(b.address)}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success btn-sm rounded-pill fw-bold align-self-start mt-2">
                            <i class="bi bi-map me-1"></i>Xem bản đồ
                        </a>
                    </div>
                `;
                container.appendChild(col);
            });
        }
    });
</script>