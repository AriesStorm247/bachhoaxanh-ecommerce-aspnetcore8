    <style>
        :root {
            --green-dark: #1a7a2e;
            --green-main: #2c9e47;
            --green-light: #e8f7ec;
            --green-accent: #38b558;
            --orange-flash: #ff6b00;
            --yellow-sale: #ffd600;
            --pink-promo: #e91e8c;
            --red-badge: #e82828;
            --gray-text: #444;
            --gray-light: #f5f5f5;
            --white: #fff;
            --radius: 10px;
        }
        * { box-sizing: border-box; }
        body { font-family: 'Be Vietnam Pro', sans-serif; background: #f0f2f0; color: var(--gray-text); }
        .topbar { background: var(--green-dark); padding: 6px 0; font-size: 12px; color: rgba(255,255,255,0.85); }
        .topbar a { color: rgba(255,255,255,0.85); text-decoration: none; }
        .topbar a:hover { color: #fff; }
        .main-navbar {
            background: var(--green-main);
            padding: 12px 0;
            box-shadow: 0 2px 12px rgba(44,158,71,0.25);
            transition: padding 0.3s ease;
        }
        @@media (min-width: 768px) {
            .main-navbar {
                padding: 36px 0;
            }
        }
        @@media (max-width: 480px) {
            .logo-wrap .brand-name { font-size: 19px; }
            .logo-wrap .tagline { display: none; }
        }
        .logo-wrap .brand-name { font-size: 22px; font-weight: 900; color: #fff; line-height: 1; }
        .logo-wrap .brand-name span { color: var(--yellow-sale); }
        .logo-wrap .tagline { font-size: 10px; color: rgba(255,255,255,0.8); font-style: italic; }
        .search-bar { position: relative; }
        .search-bar input { width: 100%; padding: 10px 50px 10px 18px; border-radius: 25px; border: 2px solid transparent; font-size: 14px; font-family: 'Be Vietnam Pro', sans-serif; outline: none; transition: border-color .2s; }
        .search-bar input:focus { border-color: var(--yellow-sale); }
        .search-bar button { position: absolute; right: 0; top: 0; bottom: 0; width: 46px; background: var(--green-dark); border: none; border-radius: 0 25px 25px 0; color: #fff; font-size: 16px; cursor: pointer; transition: background .2s; }
        .search-bar button:hover { background: #145520; }
        .location-btn { background: rgba(255,255,255,0.18); border: 1.5px solid rgba(255,255,255,0.45); border-radius: 8px; padding: 8px 14px; color: #fff; font-size: 13px; cursor: pointer; white-space: nowrap; transition: background .2s; }
        .location-btn:hover { background: rgba(255,255,255,0.28); }
        .nav-action-btn { background: none; border: none; color: #fff; font-size: 13px; font-weight: 600; display: flex; flex-direction: column; align-items: center; gap: 2px; cursor: pointer; padding: 0 5px; }
        .nav-action-btn i { font-size: 20px; }
        .cart-badge { background: var(--yellow-sale); color: var(--green-dark); border-radius: 50%; font-size: 10px; font-weight: 800; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; position: absolute; top: -6px; right: -2px; }
        .profile-avatar { width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,.18); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid rgba(255,255,255,.45); }
        .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .nav-auth-link { color: #fff; text-decoration: none; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }
        .nav-auth-link:hover { color: var(--yellow-sale); }
        .nav-logout-btn { border: 0; background: transparent; color: #fff; font-size: 12px; font-weight: 700; padding: 0; }
        .nav-logout-btn:hover { color: var(--yellow-sale); }
        .nav-auth-btn-login { border: 0; background: transparent; color: var(--yellow-sale); font-size: 12px; font-weight: 700; padding: 0; text-decoration: none; transition: color 0.2s ease; }
        .nav-auth-btn-login:hover { color: #fff; text-shadow: 0 0 8px rgba(255, 214, 0, 0.5); }
        .nav-auth-btn-register { border: 0; background: transparent; color: #fff; font-size: 12px; font-weight: 700; padding: 0; text-decoration: none; transition: color 0.2s ease; }
        .nav-auth-btn-register:hover { color: var(--yellow-sale); }
        .cat-nav { background: var(--green-dark); border-bottom: 3px solid var(--green-accent); }
        .cat-nav-toggle { background: var(--green-accent); color: #fff; border: none; padding: 10px 20px; font-size: 13px; font-weight: 700; letter-spacing: .5px; white-space: nowrap; cursor: pointer; font-family: 'Be Vietnam Pro', sans-serif; }
        .cat-nav-toggle i { font-size: 16px; margin-right: 6px; }
        .cat-menu-scroll { display: flex; gap: 0; overflow-x: auto; padding-bottom: 2px; -webkit-overflow-scrolling: touch; }
        .cat-menu-scroll::-webkit-scrollbar { height: 4px; }
        .cat-menu-scroll::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.1); }
        .cat-menu-scroll::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); border-radius: 10px; }
        .cat-menu-scroll::-webkit-scrollbar-thumb:hover { background: var(--yellow-sale); }
        .cat-menu-scroll a { color: rgba(255,255,255,0.9); font-size: 12.5px; font-weight: 600; padding: 10px 14px; text-decoration: none; white-space: nowrap; border-right: 1px solid rgba(255,255,255,0.12); transition: background .15s, color .15s; }
        .cat-menu-scroll a:hover, .cat-menu-scroll a.active { background: rgba(255,255,255,0.15); color: var(--yellow-sale); }
        .hero-placeholder { width: 100%; height: 280px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; color: #fff; text-align: center; position: relative; overflow: hidden; }
        .hero-placeholder::before { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.15); }
        .hp1 { background: linear-gradient(135deg, #1a7a2e 0%, #38b558 60%, #ffd600 100%); }
        .hp2 { background: linear-gradient(135deg, #e82828 0%, #ff6b00 60%, #ffd600 100%); }
        .hp3 { background: linear-gradient(135deg, #0077b6 0%, #00b4d8 60%, #90e0ef 100%); }
        .hero-placeholder .badge-sale { background: var(--red-badge); color: #fff; font-size: 28px; font-weight: 900; padding: 6px 14px; border-radius: 6px; display: inline-block; margin-bottom: 8px; animation: pulse 1.8s ease-in-out infinite; }
        @@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
        .flash-sale-bar { background: #fff; border-radius: var(--radius); padding: 14px 18px; margin: 12px 0; box-shadow: 0 1px 6px rgba(0,0,0,0.07); }
        .flash-label { background: var(--orange-flash); color: #fff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 4px; letter-spacing: 1px; white-space: nowrap; }
        .flash-scroll { display: flex; gap: 12px; overflow-x: auto; flex-wrap: nowrap; padding-top: 8px; padding-bottom: 8px; -webkit-overflow-scrolling: touch; }
        .flash-scroll::-webkit-scrollbar { height: 6px; }
        .flash-scroll::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        .flash-scroll::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
        .flash-scroll::-webkit-scrollbar-thumb:hover { background: var(--green-main); }
        .flash-item { min-width: 80px; text-align: center; cursor: pointer; flex-shrink: 0; transition: transform 0.2s ease; }
        .flash-item:hover { transform: translateY(-3px); }
        .flash-item-img { width: 56px; height: 56px; border-radius: 50%; background: var(--gray-light); margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; font-size: 24px; transition: all 0.2s ease; position: relative; border: 1.5px solid #eaeaea; }
        .flash-item:hover .flash-item-img { border-color: var(--green-main); background: var(--green-light); box-shadow: 0 4px 10px rgba(44, 158, 71, 0.15); }
        .flash-item.active .flash-item-img { border-color: var(--green-main); background: var(--green-light); box-shadow: 0 4px 12px rgba(44, 158, 71, 0.22); }
        .flash-item-badge { position: absolute; top: -6px; left: 50%; transform: translateX(-50%); background: var(--red-badge); color: #fff; font-size: 8px; font-weight: 800; padding: 2px 5px; border-radius: 10px; box-shadow: 0 2px 6px rgba(232, 40, 40, 0.25); text-transform: uppercase; line-height: 1; }
        .section-title { font-size: 20px; font-weight: 900; color: var(--green-dark); position: relative; padding-left: 14px; }
        .section-title::before { content: ''; position: absolute; left: 0; top: 3px; bottom: 3px; width: 5px; background: var(--green-accent); border-radius: 3px; }
        .product-card { background: #fff; border-radius: var(--radius); overflow: hidden; transition: box-shadow .2s, transform .2s, border-color .2s; cursor: pointer; height: 100%; position: relative; display: flex; flex-direction: column; border: 1.5px solid #e0e5e0; }
        .product-card:hover { box-shadow: 0 8px 28px rgba(44,158,71,0.18); transform: translateY(-3px); border-color: var(--green-main); }
        .product-img-wrap { background: var(--gray-light); height: 160px; display: flex; align-items: center; justify-content: center; font-size: 56px; position: relative; overflow: hidden; flex-shrink: 0; }
        .product-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
        .product-body { padding: 12px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
        .product-name { font-size: 13px; font-weight: 600; color: #333; line-height: 1.4; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 36px; }
        .product-price-new { font-size: 16px; font-weight: 800; color: var(--red-badge); }
        .btn-add-cart { width: 32px; height: 32px; background: var(--green-main); border: none; border-radius: 50%; color: #fff; font-size: 18px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background .2s, transform .15s; flex-shrink: 0; }
        .promo-banner { border-radius: var(--radius); padding: 28px 32px; color: #fff; position: relative; overflow: hidden; min-height: 130px; display: flex; flex-direction: column; justify-content: center; }
        .pb-green { background: linear-gradient(135deg, #1a7a2e, #38b558); }
        .pb-orange { background: linear-gradient(135deg, #c94b00, #ff6b00); }
        .btn-promo { display: inline-block; background: #fff; padding: 8px 18px; border-radius: 20px; font-size: 13px; font-weight: 700; text-decoration: none; width: fit-content; }
        .cat-grid-item { background: #fff; border-radius: var(--radius); padding: 16px 10px; text-align: center; cursor: pointer; transition: box-shadow .2s, transform .2s; }
        .cat-grid-item:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.1); transform: translateY(-2px); }
        .sidebar-cat { background: #fff; border-radius: var(--radius); overflow: hidden; }
        .sidebar-cat-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid #f0f0f0; cursor: pointer; font-size: 13px; font-weight: 600; color: #333; text-decoration: none; }
        .sidebar-cat-item .arrow { margin-left: auto; color: #999; }
        .sidebar-cat-item:hover, .sidebar-cat-item.active { background: var(--green-light); color: var(--green-dark); }
        footer { background: var(--green-dark); color: rgba(255,255,255,0.85); padding: 40px 0 20px; margin-top: 40px; }
        footer h6 { color: #fff; font-weight: 800; font-size: 14px; margin-bottom: 14px; }
        footer ul { list-style: none; padding: 0; }
        footer ul li a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 13px; }
        .social-btn { width: 36px; height: 36px; background: rgba(255,255,255,0.15); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #fff; text-decoration: none; }
        .fade-in { opacity: 0; transform: translateY(18px); animation: fadeUp .5s ease forwards; }
        @@keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

        /* === Lục Bảo Tier: Glowing Emerald Cyan === */
        @@keyframes lucbao-glow {
            0%, 100% { text-shadow: 0 0 6px rgba(0,255,208,.4), 0 0 12px rgba(0,188,212,.2); color: #00ffd0; }
            50%       { text-shadow: 0 0 12px rgba(0,255,208,.8), 0 0 24px rgba(0,150,136,.6); color: #00e5c4; }
        }
        .loyalty-lucbao {
            font-weight: 900 !important;
            animation: lucbao-glow 2.5s ease-in-out infinite;
        }

        /* === Kim Cương Tier: Ice Blue & Prismatic Lavender === */
        @@keyframes kimcuong-sweep {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        @@keyframes kimcuong-glow {
            0%, 100% { text-shadow: 0 0 6px rgba(0,234,255,.4), 0 0 12px rgba(123,47,247,.2); }
            50%       { text-shadow: 0 0 12px rgba(0,234,255,.8), 0 0 24px rgba(123,47,247,.6); }
        }
        .loyalty-kimcuong {
            font-weight: 900 !important;
            background: linear-gradient(90deg, #90e0ef, #00b4d8, #7b2ff7, #00b4d8, #90e0ef);
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: kimcuong-sweep 3s linear infinite, kimcuong-glow 2.5s ease-in-out infinite;
        }

        /* === Ruby Tier: Fiery Glowing Crimson === */
        @@keyframes ruby-glow {
            0%, 100% { text-shadow: 0 0 6px rgba(255,23,68,.4), 0 0 12px rgba(229,57,53,.2); color: #ff1744; }
            50%       { text-shadow: 0 0 12px rgba(255,23,68,.8), 0 0 24px rgba(229,57,53,.6); color: #ff4d4d; }
        }
        .loyalty-ruby {
            font-weight: 900 !important;
            animation: ruby-glow 2s ease-in-out infinite;
        }

        /* === Niken Tier: Dark Steel + Crimson Energy === */
        @@keyframes niken-crimson-sweep {
            0%   { background-position: 200% center; }
            100% { background-position: -200% center; }
        }
        @@keyframes niken-glow {
            0%, 100% { text-shadow: 0 0 6px rgba(229,57,53,.5), 0 0 14px rgba(255,23,68,.3); }
            50%       { text-shadow: 0 0 14px rgba(229,57,53,1), 0 0 28px rgba(255,23,68,.8), 0 0 50px rgba(229,57,53,.4); }
        }
        .loyalty-niken {
            font-weight: 900 !important;
            color: #ff4d4d;
            text-shadow: 0 0 8px rgba(229,57,53,.6), 0 0 18px rgba(255,23,68,.4);
            animation: niken-glow 2.5s ease-in-out infinite;
        }

        /* === Titan Tier: Holographic Aurora (Highest) === */
        @@keyframes titan-glow {
            0%, 100% { text-shadow: 0 0 8px #ff6ec7, 0 0 16px #7b2ff7; }
            33%       { text-shadow: 0 0 8px #00eaff, 0 0 16px #ff6ec7; }
            66%       { text-shadow: 0 0 8px #ffe600, 0 0 16px #00eaff; }
        }
        .loyalty-titan {
            font-weight: 900 !important;
            color: #ff6ec7;
            animation: titan-glow 4s ease-in-out infinite;
        }

        /* === Uranium Tier: Radioactive Neon Green (Cấp 10) === */
        @@keyframes uranium-glow {
            0%, 100% { text-shadow: 0 0 8px rgba(57,255,20,.6), 0 0 18px rgba(0,255,133,.4); }
            50%       { text-shadow: 0 0 16px rgba(57,255,20,1), 0 0 32px rgba(0,255,133,.7); }
        }
        .loyalty-uranium {
            font-weight: 900 !important;
            color: #39FF14;
            animation: uranium-glow 2s ease-in-out infinite;
        }

        /* === Iridium Tier: Royal Iridescent Purple (Cấp 11) === */
        @@keyframes iridium-glow {
            0%   { text-shadow: 0 0 10px rgba(199,125,255,.8), 0 0 22px rgba(183,50,255,.6), 0 0 40px rgba(199,125,255,.3); }
            25%  { text-shadow: 0 0 18px rgba(224,64,251,1),   0 0 36px rgba(199,125,255,.9), 0 0 60px rgba(224,64,251,.5); }
            50%  { text-shadow: 0 0 16px rgba(100,200,255,1),  0 0 32px rgba(199,125,255,.8), 0 0 55px rgba(100,200,255,.4); }
            75%  { text-shadow: 0 0 18px rgba(224,64,251,1),   0 0 36px rgba(199,125,255,.9), 0 0 60px rgba(224,64,251,.5); }
            100% { text-shadow: 0 0 10px rgba(199,125,255,.8), 0 0 22px rgba(183,50,255,.6), 0 0 40px rgba(199,125,255,.3); }
        }
        .loyalty-iridium {
            font-weight: 900 !important;
            color: #C77DFF;
            animation: iridium-glow 2s ease-in-out infinite;
        }

        /* ===== PREMIUM TOAST NOTIFICATION ===== */
        .toast-notification {
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(255, 255, 255, 0.88);
            border-left: 5px solid var(--green-accent);
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08), 0 5px 15px rgba(0, 0, 0, 0.03);
            padding: 16px 20px;
            min-width: 320px;
            max-width: 400px;
            position: relative;
            overflow: hidden;
            pointer-events: auto;
            transform: translateX(120%);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.55);
            border-left-width: 5px;
        }
        .toast-notification.show {
            transform: translateX(0);
        }
        .toast-notification.fade-out {
            opacity: 0 !important;
            transform: translateY(-20px) scale(0.9) !important;
            transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1) !important;
        }
        .toast-notification .toast-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            background: var(--green-light);
            color: var(--green-accent);
            border-radius: 50%;
            font-size: 18px;
            flex-shrink: 0;
        }
        .toast-notification.show .toast-icon i {
            display: inline-block;
            animation: toast-icon-pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.5) forwards;
        }
        @@keyframes toast-icon-pop {
            0% { transform: scale(0) rotate(-45deg); }
            100% { transform: scale(1) rotate(0deg); }
        }
        .toast-notification.toast-error {
            border-left-color: var(--red-badge);
        }
        .toast-notification.toast-error .toast-icon {
            background: #ffebee;
            color: var(--red-badge);
        }
        .toast-notification .toast-body {
            font-size: 14px;
            font-weight: 700;
            color: var(--gray-text);
            line-height: 1.45;
            flex-grow: 1;
        }
        .toast-notification .toast-close {
            background: none;
            border: none;
            color: #aaa;
            font-size: 18px;
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.25s ease, color 0.2s;
        }
        .toast-notification .toast-close:hover {
            transform: rotate(90deg);
            color: var(--red-badge);
        }
        .toast-notification .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--green-accent), #a3e635);
            width: 100%;
            transition: width 3s linear;
            box-shadow: 0 0 4px rgba(56, 181, 88, 0.3);
        }
        .toast-notification.toast-error .toast-progress {
            background: linear-gradient(90deg, var(--red-badge), #f87171);
            box-shadow: 0 0 4px rgba(232, 40, 40, 0.3);
        }

