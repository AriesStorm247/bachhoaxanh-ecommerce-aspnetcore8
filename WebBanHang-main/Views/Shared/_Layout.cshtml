@using System.Security.Claims
@using WebBanHang.Data
@using WebBanHang.Services
@inject ApplicationDbContext Db
@{
    bool isBranchExplicitlyChosen = Context.Session.GetString("IsBranchExplicitlyChosen") == "true"
        || Context.Request.Cookies["IsBranchExplicitlyChosen"] == "true";
    int activeBranchId = isBranchExplicitlyChosen
        ? (Context.Session.GetInt32("ActiveBranchId")
           ?? (int.TryParse(Context.Request.Cookies["ActiveBranchId"], out int cbId) ? cbId : 0))
        : 0; // 0 = chưa chọn chi nhánh → hiển thị tổng
    string activeBranchName = isBranchExplicitlyChosen
        ? (Context.Session.GetString("ActiveBranchName") ?? Db.Branches.FirstOrDefault(b => b.Id == activeBranchId)?.Name ?? "Chọn cửa hàng")
        : "Chọn cửa hàng";

    bool isPosPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Pos";
    int role = Convert.ToInt32(ViewBag.Role ?? 0);
    int? currentCategory = ViewBag.CurrentCategory as int?;
    int? flashSaleCategoryId = ViewBag.FlashSaleCategoryId as int?;
    var layoutCategories = Db.Categories.OrderBy(c => c.Name).Take(8).ToList();
    var cartQuantity = 0;
    string? currentUserId = null;
    CustomerProfile? customerProfile = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrWhiteSpace(currentUserId))
        {
            var cartSum = Db.CartItems
                .Where(ci => ci.Cart.UserId == currentUserId)
                .Sum(ci => (decimal?)ci.Quantity) ?? 0m;
            cartQuantity = (int)Math.Ceiling(cartSum);
            customerProfile = Db.CustomerProfiles.FirstOrDefault(p => p.UserId == currentUserId);
        }
    }
    else
    {
        var guestId = Context.Session.GetString("GuestCartId");
        if (!string.IsNullOrWhiteSpace(guestId))
        {
            var cartSum = Db.CartItems
                .Where(ci => ci.Cart.UserId == guestId)
                .Sum(ci => (decimal?)ci.Quantity) ?? 0m;
            cartQuantity = (int)Math.Ceiling(cartSum);
        }
    }

    // Hàm tạo style màu cho badge cấp thẻ thành viên
    string LoyaltyTierStyle(int level) => level switch
    {
        0 => "color:#9c968f;font-weight:700;",           // Sắt - xám ấm (như ảnh 1)
        1 => "color:#a36338;font-weight:700;",           // Đồng - nâu cam đồng (như ảnh 1)
        2 => "color:#9fb2b8;font-weight:700;",           // Bạc - bạc xanh (như ảnh 1)
        3 => "color:#e5b742;font-weight:700;",           // Vàng - vàng (như ảnh 1)
        4 => "color:#73ffd3;font-weight:700;",           // Bạch kim - lục bảo sáng (như ảnh 1 nhưng sáng hơn để có độ tương phản tốt)
        _ => "color:#fff;font-weight:700;"
    };

    string LoyaltyTierClass(int level) => level switch
    {
        5 => "loyalty-lucbao",
        6 => "loyalty-kimcuong",
        7 => "loyalty-ruby",
        8 => "loyalty-niken",
        9 => "loyalty-titan",
        10 => "loyalty-uranium",
        11 => "loyalty-iridium",
        _ => ""
    };
}
