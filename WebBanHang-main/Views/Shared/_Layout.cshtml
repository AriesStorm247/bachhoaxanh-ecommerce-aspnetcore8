    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toast Notification System
        const lastShownToasts = window._lastShownToasts || (window._lastShownToasts = new Set());
        function showToast(message, type = 'success') {
            if (lastShownToasts.has(message + '|' + type)) return;
            lastShownToasts.add(message + '|' + type);
            setTimeout(() => lastShownToasts.delete(message + '|' + type), 1000);

            var container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.style.cssText = 'position: fixed; top: 24px; right: 24px; z-index: 9999; display: flex; flex-direction: column; gap: 12px; pointer-events: none;';
                document.body.appendChild(container);
            }

            var toast = document.createElement('div');
            toast.className = 'toast-notification ' + (type === 'error' ? 'toast-error' : '');
            
            var iconHtml = type === 'error' ? '<i class="bi bi-x-circle-fill"></i>' : '<i class="bi bi-check-circle-fill"></i>';
            
            toast.innerHTML = `
                <div class="toast-icon">${iconHtml}</div>
                <div class="toast-body">${message}</div>
                <button type="button" class="toast-close"><i class="bi bi-x"></i></button>
                <div class="toast-progress"></div>
            `;

            container.appendChild(toast);

            setTimeout(function () {
                toast.classList.add('show');
                var progress = toast.querySelector('.toast-progress');
                if (progress) {
                    // Ép buộc trình duyệt tính toán lại layout (reflow) để đảm bảo animation hoạt động
                    progress.offsetHeight; 
                    progress.style.width = '0%';
                }
            }, 10);

            function removeToast() {
                toast.classList.add('fade-out');
                setTimeout(function () {
                    toast.remove();
                }, 400); // Khớp với thời gian transition CSS fade-out (0.4s)
            }

            toast.querySelector('.toast-close').addEventListener('click', function () {
                removeToast();
            });

            setTimeout(function () {
                removeToast();
            }, 3000);
        }

        // Xử lý giỏ hàng dùng chung và hiển thị thông báo TempData
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["Success"] != null)
            {
                <text>
                showToast('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]?.ToString() ?? ""))', 'success');
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                showToast('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]?.ToString() ?? ""))', 'error');
                </text>
            }
            document.querySelectorAll('.btn-add-cart').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault(); e.stopPropagation();
                    var pId = this.getAttribute('data-id');
                    if (!pId) return;
                    fetch('/Cart/AddToCart?productId=' + pId, { method: 'POST' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                document.querySelectorAll('.cart-badge-count').forEach(badge => {
                                    badge.textContent = data.cartCount ?? (parseInt(badge.textContent || 0) + 1);
                                });
                                showToast(data.message || 'Đã thêm sản phẩm vào giỏ hàng!');
                            } else {
                                if (typeof data.cartCount !== 'undefined') {
                                    document.querySelectorAll('.cart-badge-count').forEach(badge => {
                                        badge.textContent = data.cartCount;
                                    });
                                }
                                showToast(data.message || 'Không thể thêm sản phẩm vào giỏ hàng.', 'error');
                            }
                        }).catch(err => { window.location.href = '/Identity/Account/Login';});
                });
            });

            // 1. Cuộn mượt mà khi tải trang có hash
            if (window.location.hash) {
                setTimeout(function () {
                    var el = document.getElementById(window.location.hash.substring(1));
                    if (el) {
                        var navbar = document.querySelector('.main-navbar');
                        var navbarHeight = navbar ? navbar.offsetHeight : 70;
                        var offset = el.getBoundingClientRect().top + window.scrollY - navbarHeight - 15;
                        window.scrollTo({
                            top: offset,
                            behavior: 'smooth'
                        });
                    }
                }, 150);
            }

            // 2. Click vào link có hash cùng trang
            document.addEventListener('click', function (e) {
                var anchor = e.target.closest('a');
                if (!anchor) return;
                
                var href = anchor.getAttribute('href');
                if (!href) return;
                
                try {
                    var url = new URL(anchor.href, window.location.href);
                    if (url.origin === window.location.origin && 
                        url.pathname === window.location.pathname && 
                        url.search === window.location.search && 
                        url.hash) {
                        
                        var targetId = url.hash.substring(1);
                        var targetEl = document.getElementById(targetId);
                        if (targetEl) {
                            e.preventDefault();
                            var navbar = document.querySelector('.main-navbar');
                            var navbarHeight = navbar ? navbar.offsetHeight : 70;
                            var offset = targetEl.getBoundingClientRect().top + window.scrollY - navbarHeight - 15;
                            window.scrollTo({
                                top: offset,
                                behavior: 'smooth'
                            });
                            
                            // Cập nhật URL hash mà không bị nhảy trang mặc định
                            history.pushState(null, null, url.hash);
                        }
                    }
                } catch (err) {
                    // Bỏ qua lỗi parse url không hợp lệ
                }
            });
        });
    </script>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <script>
            (function () {
                window.addEventListener('storage', function (event) {
                    if (event.key === 'requestAdminSession') {
                        if (sessionStorage.getItem('adminSessionActive')) {
                            localStorage.setItem('shareAdminSession', Date.now().toString());
                        }
                    }
                });

                if (sessionStorage.getItem('adminSessionActive')) {
                    return;
                }

                if (document.referrer && (document.referrer.indexOf('/Identity/Account/Login') >= 0 || document.referrer.indexOf('/login') >= 0)) {
                    sessionStorage.setItem('adminSessionActive', 'true');
                    return;
                }

                localStorage.setItem('requestAdminSession', Date.now().toString());

                function storageResponseHandler(event) {
                    if (event.key === 'shareAdminSession') {
                        sessionStorage.setItem('adminSessionActive', 'true');
                        window.removeEventListener('storage', storageResponseHandler);
                    }
                }
                window.addEventListener('storage', storageResponseHandler);

                setTimeout(function () {
                    if (!sessionStorage.getItem('adminSessionActive')) {
                        window.location.href = '/Identity/Account/Logout?returnUrl=%2F';
                    }
                }, 500);
            })();
        </script>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function () {
                // Check for session conflict across tabs
                var serverUser = '@(User.Identity?.Name ?? "")';
                if (serverUser) {
                    var cachedUser = sessionStorage.getItem('currentUserEmail');
                    if (!cachedUser) {
                        sessionStorage.setItem('currentUserEmail', serverUser);
                    } else if (cachedUser !== serverUser) {
                        sessionStorage.removeItem('currentUserEmail');
                        window.location.href = '/Identity/Account/Logout?returnUrl=%2FIdentity%2FAccount%2FLogin';
                        return;
                    }
                } else {
                    sessionStorage.removeItem('currentUserEmail');
                }

                function checkLockout() {
                    fetch('/Home/CheckLockoutStatus')
                        .then(response => response.json())
                        .then(data => {
                            if (data.isLocked) {
                                window.location.href = '/Identity/Account/Lockout?email=' + encodeURIComponent(data.email);
                            }
                        })
                        .catch(err => console.error("Error checking lockout status:", err));
                }
                // Check every 8 seconds
                setInterval(checkLockout, 8000);

                // --- Presence tracking for immediate offline updates ---
                var isInternalNavigation = false;

                document.addEventListener('click', function (e) {
                    var anchor = e.target.closest('a');
                    if (anchor && anchor.href) {
                        try {
                            var url = new URL(anchor.href, window.location.href);
                            var isLogout = url.pathname.toLowerCase().includes('/logout');
                            if (url.origin === window.location.origin && !isLogout) {
                                isInternalNavigation = true;
                            }
                        } catch (err) {}
                    }
                });

                document.addEventListener('submit', function (e) {
                    var form = e.target.closest('form');
                    if (form) {
                        var action = form.getAttribute('action') || window.location.href;
                        try {
                            var url = new URL(action, window.location.href);
                            var isLogout = url.pathname.toLowerCase().includes('/logout');
                            if (url.origin === window.location.origin && !isLogout) {
                                isInternalNavigation = true;
                            }
                        } catch (err) {}
                    }
                });

                window.addEventListener('pagehide', function () {
                    if (!isInternalNavigation) {
                        var url = '/CustomerProfile/SetOffline';
                        if (navigator.sendBeacon) {
                            navigator.sendBeacon(url);
                        } else {
                            fetch(url, { method: 'POST', keepalive: true, credentials: 'same-origin' });
                        }
                    }
                });
            })();
        </script>
    }
    <!-- Modal Cài đặt -->
    <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden;">
                <div class="modal-header bg-success text-white py-3 border-0">
                    <h5 class="modal-title fw-bold" id="settingsModalLabel">
                        <i class="bi bi-gear-fill me-2"></i>Cài đặt giao diện
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted mb-3" style="font-size: 14px;">Chế độ giao diện (Nền)</label>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-outline-success flex-grow-1 py-3 fw-bold theme-toggle-btn" data-theme="light" style="border-radius: 12px; border-width: 2px;">
                                <i class="bi bi-sun-fill me-2 fs-5"></i>Nền sáng
                            </button>
                            <button type="button" class="btn btn-outline-success flex-grow-1 py-3 fw-bold theme-toggle-btn" data-theme="dark" style="border-radius: 12px; border-width: 2px;">
                                <i class="bi bi-moon-stars-fill me-2 fs-5"></i>Nền tối
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            function updateThemeButtons(theme) {
                document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
                    const btnTheme = btn.getAttribute('data-theme');
                    if (btnTheme === theme) {
                        btn.classList.remove('btn-outline-success');
                        btn.classList.add('btn-success');
                    } else {
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-success');
                    }
                });
            }

            function setTheme(theme) {
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark-theme');
                } else {
                    document.documentElement.classList.remove('dark-theme');
                }
                localStorage.setItem('theme', theme);
                updateThemeButtons(theme);
                window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: theme } }));
            }

            document.addEventListener('DOMContentLoaded', () => {
                const savedTheme = localStorage.getItem('theme') || 'light';
                setTheme(savedTheme);

                document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const theme = btn.getAttribute('data-theme');
                        setTheme(theme);
                    });
                });

                const settingsModal = document.getElementById('settingsModal');
                if (settingsModal) {
                    settingsModal.addEventListener('show.bs.modal', () => {
                        const currentTheme = localStorage.getItem('theme') || 'light';
                        updateThemeButtons(currentTheme);
                    });
                }
            });
        })();
    </script>
    <!-- Branch Selection Modal -->
    <div class="modal fade" id="branchModal" tabindex="-1" aria-labelledby="branchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header bg-success text-white border-0" style="border-top-left-radius: 16px; border-top-right-radius: 16px; padding: 20px;">
                    <h5 class="modal-title fw-bold" id="branchModalLabel">
                        <i class="bi bi-shop me-2 text-warning"></i>Chọn Siêu Thị Bách Hóa Xanh
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4" style="background: #f8faf8;">
                    <!-- Regional and Search Filters like Footer -->
                    <div class="row g-2 mb-4">
                        <div class="col-md-3 col-6">
                            <select id="modalSelectRegion" class="form-select rounded-pill border-success-subtle shadow-sm" style="font-weight: 600;">
                                <option value="">-- Chọn Miền --</option>
                                <option value="Miền Bắc">Miền Bắc</option>
                                <option value="Miền Trung">Miền Trung</option>
                                <option value="Miền Nam">Miền Nam</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <select id="modalSelectProvince" class="form-select rounded-pill border-success-subtle shadow-sm" style="font-weight: 600;" disabled>
                                <option value="">-- Chọn Tỉnh/TP --</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <select id="modalSelectDistrict" class="form-select rounded-pill border-success-subtle shadow-sm" style="font-weight: 600;" disabled>
                                <option value="">-- Chọn Phường/Xã --</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="position-relative">
                                <input type="text" id="branchSearchInput" class="form-control rounded-pill border-success-subtle shadow-sm" 
                                       placeholder="Tìm tên đường, địa chỉ..." style="font-weight: 600; padding-right: 35px;" />
                                <i class="bi bi-search position-absolute text-success" style="right: 15px; top: 50%; transform: translateY(-50%);"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-secondary fw-bold m-0"><i class="bi text-success bi-list-stars me-1"></i>DANH SÁCH HỆ THỐNG SIÊU THỊ</h6>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" id="btnClearSelectedBranch" class="btn btn-outline-danger btn-sm rounded-pill fw-bold" onclick="clearSelectedStoreBranch()" style="display: none; font-size: 12px; padding: 4px 10px;">
                                <i class="bi bi-trash3-fill me-1"></i>Xóa chi nhánh đã chọn
                            </button>
                            <span class="text-muted small fw-bold" id="modalBranchCountText">Đang tải danh sách chi nhánh...</span>
                        </div>
                    </div>
                    <div class="branch-list-wrapper" style="max-height: 380px; overflow-y: auto; border-radius: 10px; background: #fff; border: 1px solid #e2ebd6; padding: 10px;">
                        <div id="branchesContainer" class="list-group list-group-flush">
                            <div class="text-center py-5">
                                <div class="spinner-border text-success" role="status">
                                    <span class="visually-hidden">Đang tải...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 bg-light" style="border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;">
                    <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var branches = [];
            var activeBranchId = @activeBranchId;
            var isBranchExplicitlyChosen = @Html.Raw(Json.Serialize(isBranchExplicitlyChosen));
            
            const modalSelectRegion = document.getElementById('modalSelectRegion');
            const modalSelectProvince = document.getElementById('modalSelectProvince');
            const modalSelectDistrict = document.getElementById('modalSelectDistrict');
            const searchInput = document.getElementById('branchSearchInput');
            const countText = document.getElementById('modalBranchCountText');
            const container = document.getElementById('branchesContainer');

            const regionMap = {
                "Cần Thơ": "Miền Nam", "Đà Nẵng": "Miền Trung", "Hà Nội": "Miền Bắc", "Hải Phòng": "Miền Bắc",
                "Hồ Chí Minh": "Miền Nam", "Thừa Thiên Huế": "Miền Trung", "Huế": "Miền Trung", "An Giang": "Miền Nam", "Bắc Ninh": "Miền Bắc",
                "Cà Mau": "Miền Nam", "Đắk Lắk": "Miền Trung", "Đồng Nai": "Miền Nam", "Đồng Tháp": "Miền Nam",
                "Gia Lai": "Miền Trung", "Hà Tĩnh": "Miền Trung", "Hưng Yên": "Miền Bắc", "Khánh Hòa": "Miền Trung",
                "Lâm Đồng": "Miền Trung", "Nghệ An": "Miền Trung", "Ninh Bình": "Miền Bắc", "Quảng Ngãi": "Miền Trung",
                "Quảng Ninh": "Miền Bắc", "Quảng Trị": "Miền Trung", "Tây Ninh": "Miền Nam", "Thanh Hóa": "Miền Trung",
                "Vĩnh Long": "Miền Nam"
            };

            var branchModalEl = document.getElementById('branchModal');
            if (branchModalEl) {
                branchModalEl.addEventListener('show.bs.modal', function () {
                    const clearBtn = document.getElementById('btnClearSelectedBranch');
                    if (clearBtn) {
                        clearBtn.style.display = isBranchExplicitlyChosen ? 'inline-block' : 'none';
                    }
                    if (branches.length === 0) {
                        fetch('/Home/GetBranches')
                            .then(res => res.json())
                            .then(data => {
                                branches = data.map(item => {
                                    let prov = item.province;
                                    if (prov === "Huế") prov = "Thừa Thiên Huế";
                                    const region = regionMap[prov] || "Miền Nam";
                                    return {
                                        id: item.id,
                                        name: item.name,
                                        address: item.address,
                                        province: prov,
                                        district: item.district || "Khác",
                                        region: region
                                    };
                                });
                                
                                initModalDropdownsWithActiveBranch();
                                updateModalFilters();
                            })
                            .catch(err => {
                                if (container) container.innerHTML = '<div class="alert alert-danger">Không thể tải danh sách chi nhánh. Vui lòng thử lại sau.</div>';
                            });
                    } else {
                        initModalDropdownsWithActiveBranch();
                        updateModalFilters();
                    }
                });
            }

            if (modalSelectRegion) modalSelectRegion.addEventListener('change', handleRegionChange);
            if (modalSelectProvince) modalSelectProvince.addEventListener('change', handleProvinceChange);
            if (modalSelectDistrict) modalSelectDistrict.addEventListener('change', updateModalFilters);
            if (searchInput) searchInput.addEventListener('input', updateModalFilters);

            function initModalDropdowns() {
                modalSelectRegion.value = "";
                modalSelectProvince.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
                modalSelectProvince.disabled = true;
                modalSelectDistrict.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                modalSelectDistrict.disabled = true;
            }

            async function initModalDropdownsWithActiveBranch() {
                if (activeBranchId && isBranchExplicitlyChosen) {
                    const activeBranch = branches.find(b => b.id === activeBranchId);
                    if (activeBranch) {
                        modalSelectRegion.value = activeBranch.region;
                        
                        modalSelectProvince.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
                        modalSelectProvince.disabled = false;
                        const provinces = [...new Set(branches.filter(b => b.region === activeBranch.region).map(b => b.province))].sort();
                        provinces.forEach(p => {
                            const opt = document.createElement('option');
                            opt.value = p;
                            opt.textContent = p === "Thừa Thiên Huế" ? "Huế" : p;
                            if (p === activeBranch.province) {
                                opt.selected = true;
                            }
                            modalSelectProvince.appendChild(opt);
                        });
                        
                        modalSelectDistrict.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                        modalSelectDistrict.disabled = false;
                        try {
                            const response = await fetch(`/Home/GetWards?province=${encodeURIComponent(activeBranch.province)}`);
                            const districts = await response.json();
                            districts.forEach(d => {
                                if (d && d !== "Khác") {
                                    const opt = document.createElement('option');
                                    opt.value = d;
                                    opt.textContent = d;
                                    if (d === activeBranch.district) {
                                        opt.selected = true;
                                    }
                                    modalSelectDistrict.appendChild(opt);
                                }
                            });
                        } catch (err) {
                            const districts = [...new Set(branches.filter(b => b.province === activeBranch.province).map(b => b.district))].sort();
                            districts.forEach(d => {
                                if (d && d !== "Khác") {
                                    const opt = document.createElement('option');
                                    opt.value = d;
                                    opt.textContent = d;
                                    if (d === activeBranch.district) {
                                        opt.selected = true;
                                    }
                                    modalSelectDistrict.appendChild(opt);
                                }
                            });
                        }
                        return;
                    }
                }
                initModalDropdowns();
            }

            function handleRegionChange() {
                const region = modalSelectRegion.value;
                modalSelectProvince.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
                modalSelectDistrict.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                modalSelectDistrict.disabled = true;

                if (!region) {
                    modalSelectProvince.disabled = true;
                } else {
                    modalSelectProvince.disabled = false;
                    const provinces = [...new Set(branches.filter(b => b.region === region).map(b => b.province))].sort();
                    provinces.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p;
                        opt.textContent = p === "Thừa Thiên Huế" ? "Huế" : p;
                        modalSelectProvince.appendChild(opt);
                    });
                }
                updateModalFilters();
            }

            async function handleProvinceChange() {
                const prov = modalSelectProvince.value;
                modalSelectDistrict.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';

                if (!prov) {
                    modalSelectDistrict.disabled = true;
                } else {
                    modalSelectDistrict.disabled = false;
                    try {
                        const response = await fetch(`/Home/GetWards?province=${encodeURIComponent(prov)}`);
                        const districts = await response.json();
                        districts.forEach(d => {
                            if (d && d !== "Khác") {
                                const opt = document.createElement('option');
                                opt.value = d;
                                opt.textContent = d;
                                modalSelectDistrict.appendChild(opt);
                            }
                        });
                    } catch (err) {
                        const districts = [...new Set(branches.filter(b => b.province === prov).map(b => b.district))].sort();
                        districts.forEach(d => {
                            if (d && d !== "Khác") {
                                const opt = document.createElement('option');
                                opt.value = d;
                                opt.textContent = d;
                                modalSelectDistrict.appendChild(opt);
                            }
                        });
                    }
                }
                updateModalFilters();
            }

            function updateModalFilters() {
                const region = modalSelectRegion.value;
                const prov = modalSelectProvince.value;
                const dist = modalSelectDistrict.value;
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

                let filtered = branches;

                if (region) filtered = filtered.filter(b => b.region === region);
                if (prov) filtered = filtered.filter(b => b.province === prov);
                if (dist) filtered = filtered.filter(b => b.district === dist);
                if (query) {
                    filtered = filtered.filter(b => 
                        b.name.toLowerCase().includes(query) || 
                        b.address.toLowerCase().includes(query)
                    );
                }

                if (countText) {
                    countText.innerText = `Tìm thấy ${filtered.length} siêu thị.`;
                }

                renderBranches(filtered);
            }
            
            function renderBranches(list) {
                if (!container) return;
                if (list.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted py-4">Không tìm thấy chi nhánh phù hợp.</div>';
                    return;
                }
                
                var html = '';
                // Limit rendering to 120 elements for smooth DOM performance
                list.slice(0, 120).forEach(function (b) {
                    var isActive = b.id === activeBranchId;
                    var activeClass = isActive ? 'active-branch bg-success text-white' : 'bg-white hover-branch';
                    var textClass = isActive ? 'text-white' : 'text-dark';
                    var subTextClass = isActive ? 'text-white-50' : 'text-secondary';
                    var badgeHtml = isActive ? '<span class="badge bg-warning text-dark fw-bold ms-auto rounded-pill py-2 px-3 fs-7 shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Đang Chọn</span>' : '';
                    
                    html += `
                        <div class="list-group-item list-group-item-action d-flex align-items-center p-3 mb-2 border rounded shadow-sm ${activeClass}" 
                             style="cursor: pointer; transition: all 0.2s; border-color: #e2ebd6;" 
                             onclick="selectStoreBranch(${b.id}, '${escapeHtml(b.name)}')">
                             <div class="me-3 fs-3 text-warning">
                                 <i class="bi bi-shop"></i>
                             </div>
                             <div>
                                 <h6 class="mb-1 fw-bold ${textClass}">${b.name}</h6>
                                 <p class="mb-0 small ${subTextClass}"><i class="bi bi-geo-alt-fill text-danger me-1"></i>${b.address}</p>
                             </div>
                             ${badgeHtml}
                        </div>
                    `;
                });
                container.innerHTML = html;
            }
            
            window.selectStoreBranch = function (id, name) {
                var formData = new FormData();
                formData.append('branchId', id);
                
                fetch('/Home/SelectBranch', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        var activeText = document.getElementById('activeBranchText');
                        if (activeText) activeText.textContent = name;
                        
                        var modalEl = document.getElementById('branchModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                        
                        window.location.reload();
                    } else {
                        alert(data.message || 'Lỗi khi chọn chi nhánh');
                    }
                })
                .catch(err => {
                    alert('Có lỗi xảy ra, vui lòng thử lại.');
                });
            };
            
            window.clearSelectedStoreBranch = function () {
                fetch('/Home/ClearBranch', {
                    method: 'POST'
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert('Lỗi khi xóa chi nhánh');
                    }
                })
                .catch(err => {
                    alert('Có lỗi xảy ra, vui lòng thử lại.');
                });
            };

            function escapeHtml(str) {
                return str
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }
        });
    </script>

    <!-- Scripts cho chuông thông báo -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var bellDropdown = document.getElementById('bellNotificationDropdown');
                if (bellDropdown) {
                    bellDropdown.addEventListener('show.bs.dropdown', function () {
                        var listContainer = document.getElementById('quickNotificationsList');
                        listContainer.innerHTML = '<li class="p-4 text-center text-muted"><div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>Đang tải thông báo...</li>';
                        
                        fetch('/Notification/GetQuickNotifications')
                        .then(res => res.json())
                        .then(data => {
                            if (data.length === 0) {
                                listContainer.innerHTML = '<li class="p-4 text-center text-muted"><i class="bi bi-bell-slash fs-4 d-block mb-2"></i>Không có thông báo mới</li>';
                                return;
                            }
                            
                            var html = '';
                            data.forEach(n => {
                                var unreadClass = n.isRead ? '' : 'quick-unread';
                                var unreadDot = n.isRead ? '' : '<span class="badge bg-success rounded-circle p-1 ms-auto" style="width:8px; height:8px; display:inline-block; margin-right: 5px;"></span>';
                                
                                var icon = '<i class="bi bi-gear-fill text-primary"></i>';
                                if (n.type === 'Promotion') icon = '<i class="bi bi-tag-fill text-orange"></i>';
                                else if (n.type === 'Reward') icon = '<i class="bi bi-gift-fill text-pink"></i>';

                                html += `
                                    <li class="p-3 notification-item-quick d-flex align-items-center gap-3 ${unreadClass}" onclick="window.location.href='/Notification/Index'">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width:36px; height:36px; font-size: 16px;">
                                            ${icon}
                                        </div>
                                        <div class="flex-grow-1 min-w-0" style="text-align: left;">
                                            <div class="text-truncate fw-bold text-dark" style="font-size: 13px;">${escapeHtml(n.title)}</div>
                                            <small class="text-muted" style="font-size:11px;">${n.createdAt}</small>
                                        </div>
                                        ${unreadDot}
                                    </li>
                                `;
                            });
                            listContainer.innerHTML = html;
                        })
                        .catch(err => {
                            listContainer.innerHTML = '<li class="p-4 text-center text-danger">Lỗi khi tải dữ liệu</li>';
                        });
                    });
                }

                var quickMarkAllBtn = document.getElementById('quickMarkAllRead');
                if (quickMarkAllBtn) {
                    quickMarkAllBtn.addEventListener('click', function (e) {
                        e.stopPropagation(); // Ngăn đóng dropdown
                        
                        fetch('/Notification/MarkAllAsRead', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            }
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                document.querySelectorAll('.notification-item-quick').forEach(item => {
                                    item.classList.remove('quick-unread');
                                    var dot = item.querySelector('.bg-success.rounded-circle');
                                    if (dot) dot.remove();
                                });
                                
                                updateNavbarBellCount(0);
                            }
                        });
                    });
                }

                function updateNavbarBellCount(count) {
                    var badges = document.querySelectorAll('.bell-unread-count');
                    badges.forEach(b => {
                        if (count > 0) {
                            b.innerText = count;
                            b.classList.remove('d-none');
                        } else {
                            b.innerText = '0';
                            b.classList.add('d-none');
                        }
                    });
                    
                    var bellIcon = document.getElementById('bellIcon');
                    if (bellIcon) {
                        if (count > 0) {
                            bellIcon.classList.add('bell-ring-active');
                        } else {
                            bellIcon.classList.remove('bell-ring-active');
                        }
                    }
                }

                function checkUnreadNotifications() {
                    fetch('/Notification/GetUnreadCount')
                    .then(res => res.json())
                    .then(data => {
                        updateNavbarBellCount(data.count);
                    });
                }
                
                checkUnreadNotifications();
                setInterval(checkUnreadNotifications, 5 * 60 * 1000); // 5 phút
                
                function escapeHtml(str) {
                    return str
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;")
                        .replace(/'/g, "&#039;");
                }
            });
        </script>
    }

    <script>
        window.goToPage = function (el, customPageParam) {
            if (!el) return;
            let input = null;
            if (el.tagName === 'INPUT') {
                input = el;
            } else {
                const parent = el.closest('.d-flex') || el.closest('.pagination-wrap') || el.parentElement;
                input = parent ? parent.querySelector('input[type="number"], input') : null;
            }
            if (!input || !input.value) return;

            let p = parseInt(input.value, 10);
            if (isNaN(p) || p < 1) p = 1;

            if (input.max) {
                const maxP = parseInt(input.max, 10);
                if (!isNaN(maxP) && p > maxP) p = maxP;
            }

            const pageParam = customPageParam || input.getAttribute('data-param') || input.getAttribute('data-page-param') || 'page';

            const u = new URL(window.location.href);
            u.searchParams.set(pageParam, p);

            const section = input.getAttribute('data-section');
            if (section) u.searchParams.set('activeSection', section);

            const sub = input.getAttribute('data-sub');
            if (sub) u.searchParams.set('activeSubInventory', sub);

            const path = window.location.pathname.toLowerCase();
            if (path === '/' || path.endsWith('/home') || path.endsWith('/home/index')) {
                u.searchParams.set('showAll', 'True');
            }
            u.hash = '';
            window.location.assign(u.toString());
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
