                            else
                            {
                                <div class="alert alert-warning p-1 text-center mb-0" style="font-size: 10.5px; border-radius: 6px;">
                                    <i class="bi bi-info-circle-fill"></i> Vui lòng <a href="/Identity/Account/Login" class="fw-bold text-success text-decoration-underline">Đăng nhập</a> để nhận xét.
                                </div>
                            }
                        </div>
                        <hr class="my-2" />
                        <p class="small text-secondary mb-2" style="font-size: 11px;">Mô tả: Sản phẩm tươi ngon, đảm bảo an toàn vệ sinh thực phẩm, nguồn gốc rõ ràng từ Bách Hóa Xanh.</p>
                        <div class="mt-2">
                            <button id="modalAddBtn" class="btn btn-success btn-lg w-100 rounded-pill fw-bold" style="font-size: 14px; padding: 10px;">THÊM VÀO GIỎ HÀNG</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openProductModal(name, image, price, discountedPrice, id, amount) {
        // 1. Đổ dữ liệu vào Modal
        document.getElementById('modalName').innerText = name;
        document.getElementById('modalImg').src = image || '/images/default.png';
        document.getElementById('modalProductId').value = id;

        // Reset review form if present
        const ratingInput = document.getElementById('reviewRatingInput');
        const commentInput = document.getElementById('reviewCommentInput');
        if (ratingInput) ratingInput.value = 5;
        if (commentInput) commentInput.value = '';
        if (typeof updateStarHighlights === 'function') {
            updateStarHighlights(5);
        }

        // Fetch reviews from DB
        fetch('/Home/GetReviews?productId=' + id)
            .then(res => res.json())
            .then(data => {
                const reviewsContainer = document.getElementById('modalReviewsContainer');
                let dbReviews = (data.success && data.reviews) ? data.reviews : [];
                
                const baseReviewCount = 12 + (id % 40) * 3;
                const baseRating = 4.0 + (id % 10) * 0.1;
                const dbCount = dbReviews.length;
                const mockCount = baseReviewCount;

                const sampleComments = [
                    "Sản phẩm tươi ngon, đóng gói sạch sẽ vệ sinh.",
                    "Giao hàng siêu tốc đúng 2h, rất ưng ý.",
                    "Chất lượng tốt, mua đợt sale nên giá rất hợp lý.",
                    "Đúng mô tả, rau củ tươi xanh không bị dập nát.",
                    "Nhân viên giao hàng thân thiện, đồ bách hóa chuẩn sạch.",
                    "Sản phẩm chất lượng cao, ăn rất ngon miệng.",
                    "Đóng gói cẩn thận, sản phẩm chuẩn VietGAP, uy tín.",
                    "Đồ sạch sẽ tươi ngon, đóng gói cẩn thận.",
                    "Giá rẻ, giao nhanh đúng hẹn 2h.",
                    "Đúng chuẩn sản phẩm Bách Hóa Xanh, cả nhà đều thích.",
                    "Rất chất lượng, ăn thấy ngọt nước ngon lành."
                ];
                const sampleReviewers = [
                    "Nguyễn Văn Tuấn", "Trần Thị Lan", "Lê Minh Hoàng", "Phạm Thanh Thảo", 
                    "Vũ Anh Dũng", "Hoàng Thu Trang", "Đỗ Hữu Hùng", "Bùi Minh Đức",
                    "Đặng Mỹ Linh", "Phan Thanh Sơn", "Lý Thu Hà", "Trịnh Quốc Việt"
                ];
                
                let mockReviews = [];
                const pad = (n) => String(n).padStart(2, '0');
                const now = new Date();
                const numFiveStars = Math.round(mockCount * (baseRating - 4.0));

                for (let r = 0; r < mockCount; r++) {
                    const reviewerIndex = (id + r * 7) % sampleReviewers.length;
                    const commentIndex = (id + r * 13) % sampleComments.length;
                    const reviewer = sampleReviewers[reviewerIndex];
                    const comment = sampleComments[commentIndex];
                    const reviewerRating = (r < numFiveStars) ? 5 : 4;

                    // Generate a unique past date/time (e.g. starting a few hours ago up to days ago)
                    const reviewDate = new Date(now.getTime() - (r * 3 * 60 * 60 * 1000) - (id % 4) * 24 * 60 * 60 * 1000);
                    const dateStr = `${pad(reviewDate.getDate())}/${pad(reviewDate.getMonth()+1)}/${reviewDate.getFullYear()} ${pad(reviewDate.getHours())}:${pad(reviewDate.getMinutes())}`;

                    mockReviews.push({
                        fullName: reviewer,
                        rating: reviewerRating,
                        comment: comment,
                        createdAt: dateStr
                    });
                }

                // Merge DB reviews (newest first) and mock reviews
                const allReviews = dbReviews.concat(mockReviews);

                // Recalculate average stars dynamically based on merged list
                let sum = 0;
                allReviews.forEach(r => sum += r.rating);
                const avg = (sum / allReviews.length).toFixed(1);
                const count = allReviews.length;
                
                let starHtml = '';
                const fullStars = Math.floor(avg);
                const hasHalfStar = (avg - fullStars) >= 0.5;
                for (let i = 1; i <= 5; i++) {
                    if (i <= fullStars) {
                        starHtml += '<i class="bi bi-star-fill text-warning"></i>';
                    } else if (i === fullStars + 1 && hasHalfStar) {
                        starHtml += '<i class="bi bi-star-half text-warning"></i>';
                    } else {
                        starHtml += '<i class="bi bi-star text-warning"></i>';
                    }
                }
                document.getElementById('modalRatingStars').innerHTML = starHtml;
                document.getElementById('modalRatingText').innerText = `${avg}/5 (${count} đánh giá)`;

                // Render reviews
                let reviewsHtml = '';
                allReviews.forEach(r => {
                    let reviewerStars = '';
                    for (let i = 1; i <= 5; i++) {
                        if (i <= r.rating) reviewerStars += '★';
                        else reviewerStars += '☆';
                    }
                    reviewsHtml += `
                        <div class="mb-1 pb-1 border-bottom text-start">
                            <div class="d-flex justify-content-between align-items-center mb-0">
                                <span class="fw-bold" style="color: var(--green-dark);">${r.fullName}</span>
                                <span style="color: #ffc107; font-size: 10px;">
                                    ${reviewerStars} 
                                    <small class="text-muted" style="font-size: 9px;">(${r.createdAt})</small>
                                </span>
                            </div>
                            <div class="text-dark" style="font-size: 11px;">${r.comment}</div>
                        </div>
                    `;
                });
                reviewsContainer.innerHTML = reviewsHtml;
            })
            .catch(err => {
                console.error("Error fetching reviews: ", err);
            });

        if (discountedPrice !== price) {
            document.getElementById('modalPrice').innerHTML = 
                `<span class="text-decoration-line-through text-muted small me-2" style="font-size: 15px;">${price}₫</span>` +
                `<span class="text-danger fw-bold">${discountedPrice}₫</span>`;
        } else {
            document.getElementById('modalPrice').innerText = price + "₫";
        }

        const modalAddBtn = document.getElementById('modalAddBtn');
        modalAddBtn.onclick = null;

        if (amount <= 0) {
            modalAddBtn.innerText = "HẾT HÀNG";
            modalAddBtn.disabled = true;
            modalAddBtn.classList.remove('btn-success');
            modalAddBtn.classList.add('btn-secondary');
        } else {
            modalAddBtn.innerText = "THÊM VÀO GIỎ HÀNG";
            modalAddBtn.disabled = false;
            modalAddBtn.classList.remove('btn-secondary');
            modalAddBtn.classList.add('btn-success');
        }

        modalAddBtn.onclick = function () {
            if (amount <= 0) return;
            var formData = new FormData();
            formData.append('productId', id);

            fetch('/Cart/AddToCart', {
                method: 'POST',
                body: formData
            })
            .then(res => {
                if (res.status === 401) {
                    showToast("Vui lòng đăng nhập để mua hàng nhé!", 'error');
                    window.location.href = "/Identity/Account/Login";
                    throw new Error("Unauthorized");
                }
                if (!res.ok) {
                    throw new Error("Server error");
                }
                return res.json();
            })
            .then(data => {
                if (!data.success) {
                    showToast(data.message || "Không thể thêm sản phẩm vào giỏ hàng.", 'error');
                    return;
                }

                if (typeof data.cartCount !== 'undefined') {
                    document.querySelectorAll('.cart-badge-count').forEach(badge => {
                        badge.textContent = data.cartCount;
                    });
                }

                showToast(data.message || ("Đã thêm " + name + " vào giỏ hàng!"));

                var myModalEl = document.getElementById('productQuickView');
                var modal = bootstrap.Modal.getInstance(myModalEl) || new bootstrap.Modal(myModalEl);
                if (modal) {
                    modal.hide();
                }
            })
            .catch(err => {
                if (err.message !== "Unauthorized") {
                    showToast("Lỗi hệ thống! Vui lòng thử lại sau.", 'error');
                }
            });
        };

        // Gắn sự kiện submit đánh giá
        const submitBtn = document.getElementById('btnSubmitReview');
        if (submitBtn) {
            submitBtn.onclick = function () {
                const commentInput = document.getElementById('reviewCommentInput');
                const ratingInput = document.getElementById('reviewRatingInput');
                const comment = commentInput ? commentInput.value.trim() : '';
                const rating = ratingInput ? ratingInput.value : 5;

                if (!comment) {
                    showToast("Vui lòng nhập nhận xét của bạn.", "error");
                    return;
                }

                var rFormData = new FormData();
                rFormData.append('productId', id);
                rFormData.append('rating', rating);
                rFormData.append('comment', comment);

                fetch('/Home/AddReview', {
                    method: 'POST',
                    body: rFormData
                })
                .then(res => res.json())
                .then(rData => {
                    if (rData.success) {
                        showToast(rData.message);
                        if (commentInput) commentInput.value = '';
                        // Tải lại modal để làm mới danh sách đánh giá từ DB ngay lập tức
                        openProductModal(name, image, price, discountedPrice, id, amount);
                    } else {
                        showToast(rData.message, "error");
                    }
                })
                .catch(err => {
                    showToast("Đã xảy ra lỗi khi gửi đánh giá.", "error");
                    console.error(err);
                });
            };
        }

        var myModalEl = document.getElementById('productQuickView');
        var myModal = bootstrap.Modal.getInstance(myModalEl) || new bootstrap.Modal(myModalEl);
        myModal.show();
    }
</script>

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
{
    <!-- Popup Markup -->
    <div class="promo-overlay" id="promoPopup">
        <div class="promo-popup-card">
            <button type="button" class="promo-close-btn" onclick="closePromoPopup(false)">
                <i class="bi bi-x-lg text-dark fw-bold"></i>
            </button>
            @{
                var activePromo = WebBanHang.Services.PromotionService.GetCurrentPromotion(WebBanHang.Services.PromotionService.GetVietnamNow());
                var gradient = WebBanHang.Services.PromotionService.GetPromoGradient(activePromo.Theme);
                var badgeText = activePromo.Type != WebBanHang.Services.PromotionType.None ? "Khuyến mãi" : "Thành viên";
                var discountVal = activePromo.Type == WebBanHang.Services.PromotionType.Weekend ? 10 :
                                  activePromo.Type == WebBanHang.Services.PromotionType.DoubleDate ? 12 :
                                  activePromo.Type == WebBanHang.Services.PromotionType.Holiday ? 15 :
                                  activePromo.Type == WebBanHang.Services.PromotionType.Weekday ? 7 : 5;
            }
            <div class="promo-header text-white text-center p-4 position-relative" style="background: @gradient; border-radius: 24px 24px 0 0; overflow: hidden;">
                <div class="position-absolute" style="width: 150px; height: 150px; background: rgba(255,255,255,0.15); border-radius: 50%; top: -60px; left: -60px;"></div>
                <div class="position-absolute" style="width: 120px; height: 120px; background: rgba(255,255,255,0.15); border-radius: 50%; bottom: -50px; right: -40px;"></div>
                
                <div class="badge-promo mb-2" style="background: #ffd600; color: #1a7a2e; font-size: 11px; font-weight: 800; padding: 4px 12px; border-radius: 20px; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;">@badgeText</div>
                <h3 class="fw-black mb-1" style="font-weight: 900; text-shadow: 0 2px 4px rgba(0,0,0,0.2); font-size: 1.6rem;">@activePromo.Title.ToUpper()</h3>
                <p class="small mb-0" style="opacity: 0.9;">@activePromo.Subtitle</p>
            </div>
            <div class="promo-body text-center p-4">
                <div class="promo-illustration my-3 d-flex justify-content-center align-items-center gap-3" style="font-size: 48px;">
                    @{
                        var promoEmojis = WebBanHang.Services.PromotionService.GetPromoEmojis(activePromo, WebBanHang.Services.PromotionService.GetVietnamNow());
                    }
                    @if (promoEmojis.Count >= 1)
                    {
                        <span class="illustration-item animate-bounce">@promoEmojis[0]</span>
                    }
                    @if (promoEmojis.Count >= 2)
                    {
                        <span class="illustration-item animate-bounce-delayed">@promoEmojis[1]</span>
                    }
                    @if (promoEmojis.Count >= 3)
                    {
                        <span class="illustration-item animate-bounce">@promoEmojis[2]</span>
                    }
                </div>
                
                <div class="discount-display mb-4" style="background: #fdf5e6; border: 1.5px dashed #f39c12; border-radius: 16px; padding: 12px;">
                    <div style="font-size: 12px; font-weight: 700; color: #e67e22;">ƯU ĐÃI ĐẶC BIỆT DÀNH CHO BẠN</div>
                    <div style="font-size: 28px; font-weight: 900; color: #e74c3c;">
                        @(activePromo.Type != WebBanHang.Services.PromotionType.None ? $"GIẢM ĐẾN {discountVal}%" : "ĐIỂM THƯỞNG x2")
                    </div>
                    <div class="small text-muted" style="font-size: 11px;">
                        @(activePromo.Type != WebBanHang.Services.PromotionType.None ? activePromo.AppliedCategoryDescription : "Tích lũy điểm mua sắm nhận thêm quà tặng hấp dẫn")
                    </div>
                </div>

                <button type="button" class="btn btn-lg w-100 btn-promo-cta" style="background: linear-gradient(135deg, #2c9e47, #38b558); color: #fff; border-radius: 50px; font-weight: 800; font-size: 15px; border: none; padding: 12px; box-shadow: 0 4px 15px rgba(44,158,71,0.3); transition: 0.2s;" onclick="closePromoPopup(true)">
                    MUA NGAY
                </button>
            </div>
        </div>
    </div>

    <style>
        .promo-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 10000; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.35s ease; }
        .promo-popup-card { width: 90%; max-width: 400px; background: #fff; border-radius: 24px; position: relative; overflow: visible; box-shadow: 0 20px 50px rgba(0,0,0,0.35); transform: scale(0.85); transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
        .promo-overlay.show { opacity: 1; pointer-events: auto; }
        .promo-overlay.show .promo-popup-card { transform: scale(1); }
        .promo-close-btn { position: absolute; top: -15px; right: -15px; width: 38px; height: 38px; border-radius: 50%; background: #fff; border: none; box-shadow: 0 4px 10px rgba(0,0,0,0.2); display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 10100; transition: transform 0.2s; }
        .promo-close-btn:hover { transform: scale(1.1); }
        .btn-promo-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(44,158,71,0.4); }
        @@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
        .animate-bounce { display: inline-block; animation: bounce 1.8s ease-in-out infinite; }
        .animate-bounce-delayed { display: inline-block; animation: bounce 1.8s ease-in-out infinite; animation-delay: 0.3s; }
    </style>

    <script>
        function showPromoPopup() {
            var popup = document.getElementById('promoPopup');
            if (popup) {
                popup.classList.add('show');
            }
        }

        function closePromoPopup(goToPromo) {
            var popup = document.getElementById('promoPopup');
            if (popup) {
                popup.classList.remove('show');
                sessionStorage.setItem('promoPopupShown', 'true');
            }
            if (goToPromo) {
                window.location.href = '@(activePromo.Type != WebBanHang.Services.PromotionType.None ? "/Home/Index#hang-hot" : "/Home/Index#featured-products")';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (!sessionStorage.getItem('promoPopupShown')) {
                setTimeout(showPromoPopup, 800);
            }
        });

        // Close when clicking overlay background
        document.addEventListener('click', function(e) {
            var popup = document.getElementById('promoPopup');
            if (popup && e.target === popup) {
                closePromoPopup(false);
            }
        });
    </script>
}

