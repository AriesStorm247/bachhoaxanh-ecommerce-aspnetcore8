@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
    var searchQuery = ViewBag.SearchQuery as string ?? "";
    var categories = ViewBag.Categories as IEnumerable<WebBanHang.Models.Category> ?? Enumerable.Empty<WebBanHang.Models.Category>();
    int? currentCategory = ViewBag.CurrentCategory as int?;
    var currentCategoryName = ViewBag.CurrentCategoryName as string;
    int? flashSaleCategoryId = ViewBag.FlashSaleCategoryId as int?;
    var selectedCategoryName = flashSaleCategoryId.HasValue 
        ? categories.FirstOrDefault(c => c.Id == flashSaleCategoryId.Value)?.Name 
        : null;
}
@if (Model != null && Model.Any())
{
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ItemList",
      "numberOfItems": @Model.Count(),
      "itemListElement": [
        @Html.Raw(string.Join(",", Model.Select((p, idx) => {
            var domain = "https://stbachhoaxanh-001-site1.itempurl.com";
            var urlName = System.Net.WebUtility.UrlEncode(p.Name);
            var baseRating = 4.0 + (p.Id % 10) * 0.1;
            var ratingStr = baseRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
            var reviewCount = 12 + (p.Id % 40) * 3;
            var priceVal = (p.DiscountedPrice < p.Price ? p.DiscountedPrice : p.Price).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
            var avail = p.Amount > 0 ? "InStock" : "OutOfStock";
            var escapedName = System.Web.HttpUtility.JavaScriptStringEncode(p.Name);
            // Xây dựng imageUrl đúng: nếu đã là URL đầy đủ thì giữ nguyên, nếu là path tương đối thì ghép domain
            var imageUrl = "";
            if (!string.IsNullOrWhiteSpace(p.Image))
            {
                imageUrl = p.Image.StartsWith("http://") || p.Image.StartsWith("https://")
                    ? p.Image
                    : $"{domain}{(p.Image.StartsWith("/") ? "" : "/")}{p.Image}";
            }
            var imageField = !string.IsNullOrEmpty(imageUrl) ? $@"""image"": ""{imageUrl}""," : "";
            return $@"{{
              ""@type"": ""ListItem"",
              ""position"": {idx + 1},
              ""url"": ""{domain}/Home/Index?search={urlName}"",
              ""item"": {{
                ""@type"": ""Product"",
                ""name"": ""{escapedName}"",
                {imageField}
                ""description"": ""Mua {escapedName} chất lượng cao, tươi ngon sạch sẽ tại Bách Hóa Xanh."",
                ""offers"": {{
                  ""@type"": ""Offer"",
                  ""priceCurrency"": ""VND"",
                  ""price"": {priceVal},
                  ""availability"": ""https://schema.org/{avail}""
                }},
                ""aggregateRating"": {{
                  ""@type"": ""AggregateRating"",
                  ""ratingValue"": {ratingStr},
                  ""reviewCount"": {reviewCount}
                }}
              }}
            }}";
        })))
      ]
    }
    </script>
}
@functions {
    // Maps category name keywords to Bootstrap Icons
    static string CategoryIcon(string name)
    {
        if (string.IsNullOrEmpty(name)) return "bi-tag-fill";
        var n = name.ToLowerInvariant();
        
        if (n.Contains("bánh") || n.Contains("kẹo") || n.Contains("banh") || n.Contains("keo"))
            return "bi-cake2-fill";
            
        if (n.Contains("bia") || n.Contains("nước") || n.Contains("nuoc") || n.Contains("giải khát") || n.Contains("giai khat"))
            return "bi-cup-straw";
            
        if (n.Contains("chăm sóc") || n.Contains("cham soc") || n.Contains("cá nhân") || n.Contains("ca nhan"))
            return "bi-person-hearts";
            
        if (n.Contains("dầu") || n.Contains("dau") || n.Contains("gia vị") || n.Contains("gia vi"))
            return "bi-droplet-half";
            
        if (n.Contains("gạo") || n.Contains("gao") || n.Contains("bột") || n.Contains("bot") || n.Contains("đồ khô") || n.Contains("do kho"))
            return "bi-box-seam-fill";
            
        if (n.Contains("kem") || n.Contains("sữa chua") || n.Contains("sua chua"))
            return "bi-thermometer-snow";
            
        if (n.Contains("mì") || n.Contains("mi\u0300") || n.Contains("miến") || n.Contains("mien") || n.Contains("cháo") || n.Contains("chao"))
            return "bi-cup-hot-fill";
            
        if (n.Contains("rau") || n.Contains("cu") || n.Contains("trái cây") || n.Contains("trai cay"))
            return "bi-flower3";
            
        if (n.Contains("mẹ") || n.Contains("me & be") || n.Contains("bé") || n.Contains("be") || n.Contains("trẻ") || n.Contains("tre"))
            return "bi-emoji-laughing-fill";
            
        if (n.Contains("thịt") || n.Contains("thit") || n.Contains("trứng") || n.Contains("trung"))
            return "bi-egg-fried";
            
        if (n.Contains("đông") || n.Contains("dong") || n.Contains("lạnh") || n.Contains("lanh"))
            return "bi-snow";
            
        if (n.Contains("vệ sinh") || n.Contains("ve sinh") || n.Contains("nhà cửa") || n.Contains("nha cua"))
            return "bi-house-heart-fill";
            
        if (n.Contains("sữa") || n.Contains("sua"))
            return "bi-cup-fill";
            
        return "bi-tag-fill";
    }
}

@{
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    string sortBy = ViewBag.SortBy as string ?? "";
}

<!-- ===== THANH TÌM KIẾM & BỘ LỌC GIÁ ===== -->
<div class="home-search-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex flex-column gap-2">
        <div class="d-flex">
            <input type="text" name="search" class="form-control rounded-pill py-2 border-2" placeholder="Tìm sản phẩm sạch, tươi ngon..." value="@searchQuery" style="border-color: #2c9e47; outline: none; font-size: 14px;" />
            @if (currentCategory.HasValue)
            {
                <input type="hidden" name="categoryId" value="@currentCategory.Value" />
            }
            <button type="submit" class="btn btn-success rounded-pill px-4 ms-2 fw-bold d-flex align-items-center justify-content-center gap-1" style="background-color: #2c9e47; border: none; font-size: 14px; white-space: nowrap;">
                <i class="bi bi-search"></i>
                <span>Tìm</span>
            </button>
        </div>

        <!-- Bộ lọc giá & Sắp xếp -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 bg-light rounded-3 border">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold text-success small"><i class="bi bi-funnel-fill me-1"></i>Lọc theo giá:</span>
                
                <a href="@Url.Action("Index", "Home", new { search = searchQuery, categoryId = currentCategory, minPrice = (decimal?)null, maxPrice = 50000, sortBy = sortBy })"
                   class="btn btn-xs rounded-pill @(minPrice == null && maxPrice == 50000 ? "btn-success" : "btn-outline-success") small px-2 py-1" style="font-size: 12px;">
                    Dưới 50k
                </a>
                <a href="@Url.Action("Index", "Home", new { search = searchQuery, categoryId = currentCategory, minPrice = 50000, maxPrice = 100000, sortBy = sortBy })"
                   class="btn btn-xs rounded-pill @(minPrice == 50000 && maxPrice == 100000 ? "btn-success" : "btn-outline-success") small px-2 py-1" style="font-size: 12px;">
                    50k - 100k
                </a>
                <a href="@Url.Action("Index", "Home", new { search = searchQuery, categoryId = currentCategory, minPrice = 100000, maxPrice = 200000, sortBy = sortBy })"
                   class="btn btn-xs rounded-pill @(minPrice == 100000 && maxPrice == 200000 ? "btn-success" : "btn-outline-success") small px-2 py-1" style="font-size: 12px;">
                    100k - 200k
                </a>
                <a href="@Url.Action("Index", "Home", new { search = searchQuery, categoryId = currentCategory, minPrice = 200000, maxPrice = (decimal?)null, sortBy = sortBy })"
                   class="btn btn-xs rounded-pill @(minPrice == 200000 && maxPrice == null ? "btn-success" : "btn-outline-success") small px-2 py-1" style="font-size: 12px;">
                    Trên 200k
                </a>

                <!-- Nhập khoảng giá tùy chọn -->
                <div class="d-flex align-items-center gap-1 ms-1">
                    <input type="number" name="minPrice" placeholder="Từ đ" value="@(minPrice?.ToString("0"))" class="form-control form-control-sm rounded-pill" style="width: 85px; font-size: 12px;" />
                    <span class="text-muted small">-</span>
                    <input type="number" name="maxPrice" placeholder="Đến đ" value="@(maxPrice?.ToString("0"))" class="form-control form-control-sm rounded-pill" style="width: 85px; font-size: 12px;" />
                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-2 py-0" style="font-size: 11px; height: 28px;">Áp dụng</button>
                </div>

                @if (minPrice.HasValue || maxPrice.HasValue)
                {
                    <a href="@Url.Action("Index", "Home", new { search = searchQuery, categoryId = currentCategory, sortBy = sortBy })" class="text-danger small text-decoration-none ms-1">
                        <i class="bi bi-x-circle-fill"></i> Xóa lọc
                    </a>
                }
            </div>

            <!-- Sắp xếp giá -->
            <div class="d-flex align-items-center gap-1">
                <span class="small text-muted"><i class="bi bi-sort-down me-1"></i>Sắp xếp:</span>
                <select name="sortBy" class="form-select form-select-sm rounded-pill" style="width: 140px; font-size: 12px;" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(sortBy))">Mặc định</option>
                    <option value="price_asc" selected="@(sortBy == "price_asc")">Giá: Thấp đến Cao</option>
                    <option value="price_desc" selected="@(sortBy == "price_desc")">Giá: Cao đến Thấp</option>
                </select>
            </div>
        </div>
    </form>
</div>

<!-- ===== CAROUSEL ===== -->
@{
    var activePromoHome = WebBanHang.Services.PromotionService.GetCurrentPromotion(WebBanHang.Services.PromotionService.GetVietnamNow());
    ViewData["ActivePromo"] = activePromoHome;
    var promoUrlHome = activePromoHome.Type != WebBanHang.Services.PromotionType.None 
        ? "/Home/Index#hang-hot" 
        : "/Home/Index#featured-products";
}
<div id="heroCarousel" class="carousel slide mb-3" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <a href="@promoUrlHome" class="text-decoration-none d-block">
                <div class="hero-placeholder shadow-sm" style="background: @(WebBanHang.Services.PromotionService.GetPromoGradient(activePromoHome.Theme));">
                    <div class="text-wrap text-center text-white">
                        @if (activePromoHome.Type != WebBanHang.Services.PromotionType.None)
                        {
                            var pctStr = activePromoHome.Type == WebBanHang.Services.PromotionType.Weekend ? "-10%" : 
                                         activePromoHome.Type == WebBanHang.Services.PromotionType.DoubleDate ? "-12%" : 
                                         activePromoHome.Type == WebBanHang.Services.PromotionType.Weekday ? "7%" : "-15%";
                            <div class="badge-sale mb-3" style="background: #e82828; animation: pulse 1.8s infinite; font-size: 26px; font-weight: 900; padding: 6px 16px; border-radius: 8px; display: inline-block;">@pctStr</div>
                            <h2 class="fw-black" style="font-size: 2.3rem; font-weight: 900; letter-spacing: 0.2px; text-shadow: 0 2px 10px rgba(0,0,0,0.35);">@activePromoHome.Title.ToUpper()</h2>
                            <p class="fs-5 fw-bold mt-2" style="color: rgba(255,255,255,0.95); text-shadow: 0 1px 6px rgba(0,0,0,0.2);">@activePromoHome.Subtitle</p>
                        }
                        else
                        {
                            <div class="badge-sale mb-3" style="background: var(--green-dark); font-size: 26px; font-weight: 900; padding: 6px 16px; border-radius: 8px; display: inline-block;">BÁCH HÓA XANH</div>
                            <h2 class="fw-black" style="font-size: 2.3rem; font-weight: 900; letter-spacing: 0.2px;">MUA SẮM TIỆN LỢI & NHANH CHÓNG</h2>
                            <p class="fs-5 mt-2" style="color: rgba(255,255,255,0.85);">SIÊU THỊ GẦN NHÀ, GIÁ TIẾT KIỆM MỖI NGÀY</p>
                        }
                    </div>
                </div>
            </a>
        </div>
        <div class="carousel-item">
            <a href="/Home/Info?page=stores" class="text-decoration-none d-block">
                <div class="hero-placeholder hp2 shadow-sm">
                    <div class="text-wrap text-center text-white">
                        <div class="badge-sale mb-3" style="background: #ff6b00; font-size: 26px; font-weight: 900; padding: 6px 16px; border-radius: 8px; display: inline-block;">HỆ THỐNG</div>
                        <h2 class="fw-black" style="font-size: 2.3rem; font-weight: 900; letter-spacing: 0.2px;">HỆ THỐNG CỬA HÀNG RỘNG KHẮP</h2>
                        <p class="fs-5 mt-2" style="color: rgba(255,255,255,0.85);">Xem danh sách địa chỉ và tìm vị trí gần nhất trên bản đồ</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

@if (ViewBag.IsPromoOnly == true)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center mb-4 border-2 border-success-subtle shadow-sm fade-in" style="border-radius: 12px; background: #e8f7ec;">
        <div class="pe-2">
            <h5 class="fw-bold text-success mb-1" style="font-weight: 800;"><i class="bi bi-gift-fill me-2"></i>Đang xem: @activePromoHome.Title</h5>
            <span class="small text-secondary">
                @if (activePromoHome.Type == WebBanHang.Services.PromotionType.Weekend)
                {
                    <span>Đang hiển thị các sản phẩm thuộc danh mục Thịt, cá, trứng & Rau, củ, quả được giảm giá 10% cuối tuần.</span>
                }
                else if (activePromoHome.Type == WebBanHang.Services.PromotionType.Weekday)
                {
                    <span>Đang hiển thị các sản phẩm thuộc danh mục @activePromoHome.AppliedCategoryDescription được giảm giá 7% ngày thường.</span>
                }
                else if (activePromoHome.Type == WebBanHang.Services.PromotionType.DoubleDate)
                {
                    <span>Đang hiển thị toàn bộ sản phẩm được giảm giá 12% ngày hội mua sắm song số.</span>
                }
                else if (activePromoHome.Type == WebBanHang.Services.PromotionType.Holiday)
                {
                    <span>Đang hiển thị toàn bộ sản phẩm được giảm giá 15% ngày Đại lễ Việt Nam.</span>
                }
            </span>
        </div>
        <a href="@Url.Action("Index", "Home")#featured-products" class="btn btn-success btn-sm rounded-pill fw-bold px-3" style="white-space: nowrap;">
            Xem tất cả sản phẩm
        </a>
    </div>
}

@if (activePromoHome.Type != WebBanHang.Services.PromotionType.None)
{
    <!-- ===== FLASH SALE ===== -->
    <div class="flash-sale-bar d-flex flex-wrap align-items-center gap-3 mb-3 shadow-sm" style="border-radius: 12px; padding: 16px 20px;">
        <div class="d-flex align-items-center gap-2">
            <div class="flash-label text-center" style="background: var(--orange-flash); border-radius: 6px; font-weight: 800; padding: 6px 12px; line-height: 1.1;">
                FLASH<br><span style="font-size: 13px; color: var(--yellow-sale);">SALE</span>
            </div>
            <!-- Countdown Timer -->
            <div class="d-flex align-items-center gap-1 ms-2" id="flash-countdown-wrap" style="font-size: 13px; font-weight: 700; color: #333;">
                <span class="countdown-label d-none d-sm-inline" style="color: #666; font-size: 12px;"><i class="bi bi-clock-fill text-danger animate-pulse"></i> Kết thúc sau:</span>
                <span class="countdown-box" id="cd-hours" style="background: #222; color: #fff; padding: 3px 6px; border-radius: 4px; font-size: 12px; font-family: monospace; font-weight: 900;">00</span>
                <span>:</span>
                <span class="countdown-box" id="cd-minutes" style="background: #222; color: #fff; padding: 3px 6px; border-radius: 4px; font-size: 12px; font-family: monospace; font-weight: 900;">00</span>
                <span>:</span>
                <span class="countdown-box" id="cd-seconds" style="background: #222; color: #fff; padding: 3px 6px; border-radius: 4px; font-size: 12px; font-family: monospace; font-weight: 900;">00</span>
            </div>
        </div>
        <div class="flash-scroll flex-grow-1">

            <!-- "Tất cả" item -->
            <a asp-action="Index" asp-fragment="hang-hot" class="text-decoration-none text-dark">
                <div class="flash-item text-center @(flashSaleCategoryId == null ? "active" : "")">
                    <div class="flash-item-img">
                        <i class="bi bi-grid-fill"></i>
                        <span class="flash-item-badge">HOT</span>
                    </div>
                    <div class="flash-item-name">Tất cả</div>
                </div>
            </a>
            @foreach (var category in categories)
            {
                var discountedCategoryIds = ViewBag.DiscountedCategoryIds as List<int> ?? new List<int>();
                if (discountedCategoryIds.Contains(category.Id))
                {
                    <a asp-action="Index" asp-route-flashSaleCategoryId="@category.Id" asp-fragment="hang-hot" class="text-decoration-none text-dark">
                        <div class="flash-item text-center @(flashSaleCategoryId == category.Id ? "active" : "")">
                            <div class="flash-item-img">
                                <i class="bi @CategoryIcon(category.Name)"></i>
                                <span class="flash-item-badge">HOT</span>
                            </div>
                            <div class="flash-item-name">@category.Name</div>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
}



@if (!string.IsNullOrWhiteSpace(searchQuery))
{
    <p>Kết quả tìm kiếm cho: <strong>@searchQuery</strong></p>
}
else if (!string.IsNullOrWhiteSpace(selectedCategoryName))
{
    <p>Đang xem danh mục: <strong>@selectedCategoryName</strong></p>
}
else if (!string.IsNullOrWhiteSpace(currentCategoryName))
{
    <p>Đang xem danh mục: <strong>@currentCategoryName</strong></p>
}

@if (Model != null && Model.Any())
{
    var discountedCategoryIds = ViewBag.DiscountedCategoryIds as List<int> ?? new List<int>();
    var showAll = ViewBag.ShowAll as bool? ?? false;
    
    List<WebBanHang.Models.Product> saleProducts;
    if (flashSaleCategoryId.HasValue)
    {
        saleProducts = Model.Where(p => p.CategoryId == flashSaleCategoryId.Value)
                            .OrderByDescending(p => p.DiscountedPrice < p.Price)
                            .ThenBy(p => p.Name)
                            .ToList();
    }
    else
    {
        saleProducts = Model.Where(p => p.CategoryId.HasValue && discountedCategoryIds.Contains(p.CategoryId.Value)).ToList();
    }

    var featuredProducts = Model.Where(p => !p.CategoryId.HasValue || !discountedCategoryIds.Contains(p.CategoryId.Value)).ToList();
    if (flashSaleCategoryId.HasValue)
    {
        featuredProducts = featuredProducts.Where(p => p.CategoryId != flashSaleCategoryId.Value).ToList();
    }

    if (showAll)
    {
        featuredProducts = Model.ToList();
        saleProducts = new List<WebBanHang.Models.Product>();
    }
    else
    {
        featuredProducts = featuredProducts.Take(10).ToList();
    }

    var toggleShowAllUrl = Url.Action("Index", "Home", new { 
        search = ViewBag.SearchQuery,
        categoryId = ViewBag.CurrentCategory,
        flashSaleCategoryId = ViewBag.FlashSaleCategoryId,
        showAll = !showAll
    }) + "#featured-products";

    void RenderProductCard(WebBanHang.Models.Product p)
    {
        <div class="product-card @(p.Amount <= 0 ? "out-of-stock-card" : "")" style="cursor: pointer;"
             onclick="openProductModal('@p.Name', '@p.Image', '@p.Price.ToString("N0")', '@p.DiscountedPrice.ToString("N0")', '@p.Id', @p.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture))">
            <div class="product-img-wrap">
                @if (!string.IsNullOrEmpty(p.Image))
                {
                    <img src="@p.Image" alt="@p.Name" loading="lazy" />
                }
                else
                {
                    <span>🛒</span>
                }
                @if (p.Amount <= 0)
                {
                    <div class="out-of-stock-banner">HẾT HÀNG</div>
                }
                @if (p.DiscountedPrice < p.Price)
                {
                    var pct = (int)Math.Round((1 - p.DiscountedPrice / p.Price) * 100);
                    <span class="badge bg-danger position-absolute top-0 end-0 m-2" 
                          style="z-index: 10; font-size: 11px; padding: 4px 8px; font-weight: 800; border-radius: 6px; text-transform: uppercase; line-height: 1;">
                        -@pct%
                    </span>
                }
                
                @* Product Badges *@
                @{
                    string? badgeText = null;
                    string badgeBgClass = "";
                    if (p.IsBestSeller || p.Id % 5 == 0)
                    {
                        badgeText = "BÁN CHẠY";
                        badgeBgClass = "bg-warning text-dark";
                    }
                    else if (p.Id % 7 == 1)
                    {
                        badgeText = "MỚI";
                        badgeBgClass = "bg-primary text-white";
                    }
                    else if (p.IsHot || p.Id % 6 == 2)
                    {
                        badgeText = "HOT";
                        badgeBgClass = "bg-success text-white";
                    }
                }
                @if (badgeText != null)
                {
                    <span class="badge @badgeBgClass position-absolute top-0 start-0 m-2" 
                          style="z-index: 10; font-size: 9px; padding: 4px 8px; font-weight: 800; border-radius: 6px; text-transform: uppercase; line-height: 1; letter-spacing: 0.5px;">
                        @badgeText
                    </span>
                }
            </div>
            <div class="product-body">
                <div class="product-name">@p.Name</div>
                
                @* Dynamic Ratings & Review Counts *@
                @{
                    var dbReviewStats = ViewBag.DbReviewStats as Dictionary<int, double[]>;
                    int dbCount = 0;
                    double dbAvg = 0.0;
                    if (dbReviewStats != null && dbReviewStats.ContainsKey(p.Id))
                    {
                        var stats = dbReviewStats[p.Id];
                        dbCount = (int)stats[0];
                        dbAvg = stats[1];
                    }

                    var baseReviewCount = 12 + (p.Id % 40) * 3;
                    var reviewCount = baseReviewCount + dbCount;

                    var baseRating = 4.0 + (p.Id % 10) * 0.1;
                    var rating = baseRating;
                    if (dbCount > 0)
                    {
                        rating = (baseRating * baseReviewCount + dbAvg * dbCount) / reviewCount;
                    }

                    var fullStars = (int)Math.Floor(rating);
                    var hasHalfStar = (rating - fullStars) >= 0.5;
                }
                <div class="product-rating d-flex align-items-center gap-1 mb-1" style="font-size: 11px; color: #ffc107;">
                    <div class="stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= fullStars)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else if (i == fullStars + 1 && hasHalfStar)
                            {
                                <i class="bi bi-star-half"></i>
                            }
                            else
                            {
                                <i class="bi bi-star"></i>
                            }
                        }
                    </div>
                    <span class="text-muted" style="font-size: 10px; font-weight: 700;">@rating.ToString("0.0") (@reviewCount)</span>
                </div>

                @if (!User.IsInRole("Customer") && !User.IsInRole("Customers"))
                {
                    <div class="text-muted small" style="font-size: 11px; font-weight: 700;">
                        Tồn kho: @(p.IsSoldByWeight ? p.Amount.ToString("0.000") : p.Amount.ToString("0")) @p.Unit
                    </div>
                }
                <div class="d-flex align-items-center justify-content-between mt-1">
                    @if (p.DiscountedPrice < p.Price)
                    {
                        <div>
                            <span class="product-price-old text-decoration-line-through text-muted small" style="font-size: 11px; margin-right: 4px;">@p.Price.ToString("N0")₫</span>
                            <span class="product-price-new text-danger fw-bold" style="font-size: 15px;">@p.DiscountedPrice.ToString("N0")₫</span>
                        </div>
                    }
                    else
                    {
                        <span class="product-price-new">@p.Price.ToString("N0")₫</span>
                    }
                    @if (p.Amount > 0)
                    {
                        <button class="btn-add-cart" data-id="@p.Id" onclick="event.stopPropagation();">
                            <i class="bi bi-plus"></i>
                        </button>
                    }
                    else
                    {
                        <button class="btn-add-cart bg-secondary text-white" style="cursor: not-allowed; opacity: 0.5;" onclick="event.stopPropagation();" disabled>
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    if (saleProducts.Any())
    {
        <!-- ===== SẢN PHẨM ĐANG SALE ===== -->
        <div id="hang-hot" class="d-flex justify-content-between align-items-center mb-3">
            <div class="section-title">@(string.IsNullOrWhiteSpace(selectedCategoryName) ? "SẢN PHẨM ĐANG SALE 🔥" : selectedCategoryName.ToUpper())</div>
        </div>
        <div class="hang-hot-scroll mb-4">
            @foreach (var p in saleProducts)
            {
                <div class="col fade-in">
                    @{ RenderProductCard(p); }
                </div>
            }
        </div>
    }

    if (featuredProducts.Any())
    {
        <!-- ===== SẢN PHẨM NỔI BẬT ===== -->
        <div id="featured-products" class="d-flex justify-content-between align-items-center mb-2">
            <div class="section-title">@(string.IsNullOrWhiteSpace(currentCategoryName) ? "SẢN PHẨM NỔI BẬT" : currentCategoryName.ToUpper())</div>
            <a href="@toggleShowAllUrl" class="view-all">
                @(showAll ? "Quay lại" : "Xem tất cả") 
                <i class="bi @(showAll ? "bi-chevron-up" : "bi-chevron-right")"></i>
            </a>
        </div>

        @* Sorting and Filtering controls *@
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 p-3 bg-white shadow-sm border" style="border-radius: 12px;">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-secondary" style="font-size: 13px;"><i class="bi bi-funnel-fill text-success"></i> Bộ lọc:</span>
                <div class="form-check form-switch m-0 d-flex align-items-center gap-1">
                    <input class="form-check-input text-success" type="checkbox" role="switch" id="filterInStock" style="cursor: pointer;">
                    <label class="form-check-label fw-bold text-dark" for="filterInStock" style="font-size: 13px; cursor: pointer; user-select: none;">Chỉ hiện còn hàng</label>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-secondary" style="font-size: 13px;"><i class="bi bi-sort-down-alt text-success"></i> Sắp xếp:</span>
                <select class="form-select form-select-sm border-2 fw-semibold" id="sortSelect" style="width: auto; border-radius: 8px; font-size: 13px; cursor: pointer; padding: 4px 28px 4px 12px; border-color: #e0e5e0;">
                    <option value="default">Mặc định</option>
                    <option value="price-asc">Giá: Thấp đến Cao</option>
                    <option value="price-desc">Giá: Cao đến Thấp</option>
                    <option value="name-asc">Tên: A-Z</option>
                </select>
            </div>
        </div>

        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-5 g-2 mb-4" id="featured-products-grid">
            @foreach (var p in featuredProducts)
            {
                <div class="col fade-in product-grid-item-wrap" data-price="@((int)p.DiscountedPrice)" data-name="@p.Name.ToLower()" data-stock="@p.Amount">
                    @{ RenderProductCard(p); }
                </div>
            }
        </div>

        @if (ViewBag.ShowAll == true && ViewBag.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 mb-4 bg-white shadow-sm border rounded-4">
                <div class="d-flex align-items-center gap-1 text-muted fw-bold small">
                    <span>Trang</span>
                    <input type="number" class="form-control form-control-sm text-center p-0 fw-bold border-success"
                           style="width: 48px; height: 28px; font-size: 13px;"
                           value="@ViewBag.Page" min="1" max="@ViewBag.TotalPages"
                           onkeydown="if(event.key==='Enter'){ event.preventDefault(); window.goToPage(this); }" />
                    <span>/ @ViewBag.TotalPages</span>
                    <button type="button" class="btn btn-sm btn-success py-0 px-2 fw-bold ms-1"
                            style="height: 28px; font-size: 12px; border-radius: 6px;"
                            onclick="window.goToPage(this);">
                        OK
                    </button>
                </div>
                <div class="d-flex gap-2">
                    @if (ViewBag.Page > 1)
                    {
                        <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                           href="@Url.Action("Index", "Home", new { search = ViewBag.SearchQuery, categoryId = ViewBag.CurrentCategory, showAll = ViewBag.ShowAll, isPromoOnly = ViewBag.IsPromoOnly, page = ViewBag.Page - 1 })">
                            <i class="bi bi-chevron-left"></i> Trước
                        </a>
                    }
                    else
                    {
                        <span class="btn btn-outline-secondary btn-sm rounded-3 disabled"><i class="bi bi-chevron-left"></i> Trước</span>
                    }

                    @if (ViewBag.Page < ViewBag.TotalPages)
                    {
                        <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                           href="@Url.Action("Index", "Home", new { search = ViewBag.SearchQuery, categoryId = ViewBag.CurrentCategory, showAll = ViewBag.ShowAll, isPromoOnly = ViewBag.IsPromoOnly, page = ViewBag.Page + 1 })">
                            Sau <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="btn btn-outline-secondary btn-sm rounded-3 disabled">Sau <i class="bi bi-chevron-right"></i></span>
                    }
                </div>
            </div>
        }
    }

    if (!saleProducts.Any() && !featuredProducts.Any())
    {
        <div class="empty-state text-center">
            <i class="bi bi-box-seam" style="font-size: 3rem;"></i>
            <p>Không tìm thấy sản phẩm!</p>
        </div>
    }
}
else
{
    <div class="empty-state text-center">
        <i class="bi bi-box-seam" style="font-size: 3rem;"></i>
        <p>Không tìm thấy sản phẩm!</p>
    </div>
}

@{
    int role = Convert.ToInt32(ViewBag.Role ?? 0);
}
<a asp-controller="Cart" asp-action="Tracking" asp-route-id="5" class="btn btn-info text-white fw-bold" style="border-radius: 8px;">Tra cứu</a>
@if (role == 1 || role == 5)
{
    <a asp-controller="Pos" asp-action="Index" class="btn btn-primary fw-bold ms-2" style="border-radius: 8px;">Thanh toán</a>
