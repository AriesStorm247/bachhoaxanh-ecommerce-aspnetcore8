                            <i class="bi bi-truck text-success"></i> Giao hàng nhanh trong 2h
                        </p>
                        <hr class="my-2" />
                        
                        <!-- Reviews Section -->
                        <h6 class="fw-bold mb-2 text-success" style="font-size: 13px;">
                            <i class="bi bi-chat-left-text-fill me-1"></i> Khách hàng nhận xét:
                        </h6>
                        <div id="modalReviewsContainer" class="mb-2 pe-1" style="max-height: 180px; overflow-y: auto; font-size: 12px; border-left: 2px solid #2c9e47; padding-left: 8px;">
                            <!-- Will be dynamically populated -->
                        </div>
                        <hr class="my-2" />

                        <!-- Review Submission Form -->
                        <div id="addReviewFormContainer" class="mb-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <h6 class="fw-bold mb-1 text-success" style="font-size: 12px;">
                                    <i class="bi bi-pencil-square me-1"></i> Viết nhận xét của bạn:
                                </h6>
                                <div class="d-flex flex-column gap-1 p-2 bg-light border rounded" style="font-size: 11px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span>Số sao:</span>
                                        <div class="star-rating-input d-flex gap-1" style="cursor: pointer; font-size: 14px; color: #ffc107;">
                                            <i class="bi bi-star-fill star-select" data-rating="1"></i>
                                            <i class="bi bi-star-fill star-select" data-rating="2"></i>
                                            <i class="bi bi-star-fill star-select" data-rating="3"></i>
                                            <i class="bi bi-star-fill star-select" data-rating="4"></i>
                                            <i class="bi bi-star-fill star-select" data-rating="5"></i>
                                        </div>
                                        <input type="hidden" id="reviewRatingInput" value="5" />
                                    </div>
                                    <div class="d-flex gap-2">
                                        <input type="text" id="reviewCommentInput" class="form-control form-control-sm py-1" placeholder="Nhập nhận xét..." style="font-size: 11px;" />
                                        <button type="button" id="btnSubmitReview" class="btn btn-success btn-sm fw-bold px-2 py-1" style="font-size: 11px; white-space: nowrap;">Gửi</button>
