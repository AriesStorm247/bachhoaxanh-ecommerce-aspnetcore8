<script>
    // General E-commerce enhancement scripts
    document.addEventListener('DOMContentLoaded', function () {
        // Countdown Timer
        const hoursEl = document.getElementById('cd-hours');
        const minsEl = document.getElementById('cd-minutes');
        const secsEl = document.getElementById('cd-seconds');

        if (hoursEl && minsEl && secsEl) {
            function tick() {
                const now = new Date();
                const endOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
                let diffMs = endOfDay - now;
                if (diffMs < 0) diffMs = 0;

                const hours = Math.floor(diffMs / (1000 * 60 * 60));
                const mins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
                const secs = Math.floor((diffMs % (1000 * 60)) / 1000);

                hoursEl.textContent = String(hours).padStart(2, '0');
                minsEl.textContent = String(mins).padStart(2, '0');
                secsEl.textContent = String(secs).padStart(2, '0');
            }
            tick();
            setInterval(tick, 1000);
        }

        // Sorting & Filtering
        const grid = document.getElementById('featured-products-grid');
        const sortSelect = document.getElementById('sortSelect');
        const filterInStock = document.getElementById('filterInStock');

        if (grid && sortSelect && filterInStock) {
            const items = Array.from(grid.getElementsByClassName('product-grid-item-wrap'));
            
            function updateGrid() {
                const sortBy = sortSelect.value;
                const onlyInStock = filterInStock.checked;

                // Sort & Filter
                let visibleItems = items.filter(item => {
                    const stock = parseInt(item.getAttribute('data-stock') || 0);
                    if (onlyInStock && stock <= 0) {
                        item.style.display = 'none';
                        return false;
                    }
                    item.style.display = '';
                    return true;
                });

                if (sortBy === 'price-asc') {
                    visibleItems.sort((a, b) => parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price')));
                } else if (sortBy === 'price-desc') {
                    visibleItems.sort((a, b) => parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price')));
                } else if (sortBy === 'name-asc') {
                    visibleItems.sort((a, b) => a.getAttribute('data-name').localeCompare(b.getAttribute('data-name')));
                } else {
                    // Default
                    items.forEach(item => {
                        const stock = parseInt(item.getAttribute('data-stock') || 0);
                        if (onlyInStock && stock <= 0) {
                            item.style.display = 'none';
                        } else {
                            item.style.display = '';
                        }
                        grid.appendChild(item);
                    });
                    return;
                }

                visibleItems.forEach(item => grid.appendChild(item));
            }

            sortSelect.addEventListener('change', updateGrid);
            filterInStock.addEventListener('change', updateGrid);
        }

        // Star Selector highlights helper
        const ratingInput = document.getElementById('reviewRatingInput');
        const stars = document.querySelectorAll('.star-select');

        window.updateStarHighlights = function(rating) {
            if (!stars) return;
            stars.forEach(star => {
                const starVal = parseInt(star.getAttribute('data-rating'));
                if (starVal <= rating) {
                    star.className = 'bi bi-star-fill star-select';
                    star.style.color = '#ffc107';
                } else {
                    star.className = 'bi bi-star star-select';
                    star.style.color = '#ccc';
                }
            });
        }

        if (stars && ratingInput) {
            stars.forEach(star => {
                star.addEventListener('mouseover', function () {
                    const rating = parseInt(this.getAttribute('data-rating'));
                    updateStarHighlights(rating);
                });
                star.addEventListener('mouseout', function () {
                    const currentRating = parseInt(ratingInput.value || 5);
                    updateStarHighlights(currentRating);
                });
                star.addEventListener('click', function () {
                    const rating = parseInt(this.getAttribute('data-rating'));
                    ratingInput.value = rating;
                    updateStarHighlights(rating);
                });
            });
            updateStarHighlights(5);
        }
    });
</script>

