@model WebBanHang.ViewModels.AdminCustomerEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa khách hàng";
    Layout = "_Layout_HRM";
    var tiers = WebBanHang.Services.LoyaltyService.MembershipTierNames;
}

@section Styles {
    <style>
        .form-wrap { max-width: 860px; margin: 0 auto; }
        .profile-card { background: #fff; border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,.08); padding: 26px; }
        .field-label { font-size: 12px; font-weight: 800; color: #666; text-transform: uppercase; margin-bottom: 7px; }
        .form-control, .form-select { border-radius: 10px; border: 1.5px solid #eee; padding: 11px 14px; }
        .form-control:focus, .form-select:focus { border-color: var(--green-main); box-shadow: 0 0 0 4px rgba(44,158,71,.1); }
        .btn-save { background: linear-gradient(135deg, var(--green-main), var(--green-accent)); color: #fff; border: none; border-radius: 25px; padding: 12px 22px; font-weight: 800; }
    </style>
}

<div class="form-wrap">
    <a asp-action="Index" class="mb-3 d-inline-block text-decoration-none" style="color:#888;font-weight:700;">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách khách hàng
    </a>

    <div class="profile-card">
        <h3 class="mb-4" style="font-weight:900;color:var(--green-dark);">
            <i class="bi bi-person-gear me-2"></i> Chỉnh sửa khách hàng
        </h3>

        <form asp-action="Edit" method="post">
            <input asp-for="UserId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="field-label">Tên khách hàng</label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập tên hiển thị..." />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="field-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PhoneNumber" class="field-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="field-label">Mật khẩu mới (Để trống nếu không đổi)</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới nếu muốn thay đổi..." />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AvatarUrl" class="field-label">Ảnh đại diện</label>
                <input asp-for="AvatarUrl" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ShippingAddress" class="field-label">Địa chỉ giao hàng</label>
                <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="BankAccountLink" class="field-label">Liên kết tài khoản ngân hàng</label>
                <input asp-for="BankAccountLink" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="LoyaltyPoints" class="field-label">Điểm tích lũy</label>
                    <input asp-for="LoyaltyPoints" class="form-control" type="number" min="0" />
                    <span asp-validation-for="LoyaltyPoints" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="MembershipLevel" class="field-label">Cấp thẻ</label>
                    <select asp-for="MembershipLevel" class="form-select">
                        @for (var i = 0; i < tiers.Count; i++)
                        {
                            <option value="@i">@tiers[i]</option>
                        }
                    </select>
                    <span asp-validation-for="MembershipLevel" class="text-danger small"></span>
                </div>

            </div>

            <button type="submit" class="btn-save">
                <i class="bi bi-check2-circle me-1"></i> Lưu khách hàng
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
