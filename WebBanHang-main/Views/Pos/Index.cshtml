@section Scripts {
    <!-- Tải jQuery trước để tránh lỗi $ is not defined -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Thư viện Html5-QRCode để quét camera -->
    <script src="https://unpkg.com/html5-qrcode"></script>
    <!-- Thư viện JsBarcode để tạo mã vạch demo -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    
    <script>
        // Danh sách giỏ hàng POS
        let cartItems = [];
        let identifiedCustomer = null;
        let selectedVoucher = null;
        let paymentMethod = "Tiền mặt";
        let posBranchesData = [];
        let activePosBranchId = '';
        const cashierWorkingBranchId = @Html.Raw(Json.Serialize(ViewBag.WorkingBranchId));

        // Cấu hình ngân hàng cho VietQR lấy từ appsettings
        const bankConfig = {
            bankCode: "ACB",
            accountNumber: "34675617",
            accountName: "VO VAN PHU"
        };

        $(document).ready(function () {
            // Nạp danh sách chi nhánh
            $.ajax({
                url: '/Home/GetBranches',
                type: 'GET',
                success: function(branches) {
                    posBranchesData = branches;
                    initBranchDropdowns();
                },
                error: function() {
                    showToast("Không thể tải danh sách chi nhánh!", "error");
                }
            });

            // Autofocus ô nhập mã vạch
            $("#barcodeInput").focus();

            // Nhấn Enter ở ô nhập mã vạch
            $("#barcodeInput").keypress(function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    addProductByInput();
                }
            });


            // Lắng nghe sự kiện bàn phím toàn cục cho máy quét mã vạch USB chuyên dụng
            // (Máy quét vạch hoạt động như bàn phím gõ nhanh và kết thúc bằng Enter)
            let barcodeBuffer = "";
            let lastKeyTime = Date.now();
            
            $(document).keypress(function(e) {
                // Chỉ theo dõi nếu tiêu điểm không nằm trong input văn bản khác (ngoại trừ barcodeInput)
                if (document.activeElement.tagName === "INPUT" && document.activeElement.id !== "barcodeInput" && document.activeElement.id !== "customerPhoneInput") {
                    return;
                }

                const currentTime = Date.now();
                if (currentTime - lastKeyTime > 150) {
                    barcodeBuffer = ""; // Quá lâu giữa các phím gõ -> xóa bộ đệm (đây là gõ tay)
                }
                lastKeyTime = currentTime;

                if (e.which === 13) { // Phím Enter kết thúc mã vạch
                    if (barcodeBuffer.length >= 4) { // Mã vạch thường dài hơn 4 ký tự
                        e.preventDefault();
                        addProductByBarcode(barcodeBuffer);
                        barcodeBuffer = "";
                    }
                } else if (e.which >= 48 && e.which <= 57) { // Chỉ lấy các ký tự số
                    barcodeBuffer += String.fromCharCode(e.which);
                }
            });

            // Tìm kiếm tự động khi gõ tên
            $("#barcodeInput").on("input", function() {
                const term = $(this).val();
                if (term.length >= 2) {
                    if (!activePosBranchId) {
                        showBranchRequiredModal();
                        $(this).val("");
                        return;
                    }
                    $.ajax({
                        url: '/Pos/SearchProducts',
                        type: 'GET',
                        data: { term: term, branchId: activePosBranchId },
                        success: function(data) {
                            let html = '';
                            if (data && data.length > 0) {
                                data.forEach(p => {
                                    html += `
                                        <div class="search-result-item" onclick="addProductFromSearch(${JSON.stringify(p).replace(/"/g, '&quot;')})">
                                            <img src="${p.image || 'https://placehold.co/50x50'}" onerror="this.src='https://placehold.co/50x50'" />
                                            <div>
                                                <div class="fw-bold" style="font-size: 13px;">${p.name}</div>
                                                <small class="text-muted">Mã vạch: ${formatBarcodeText(p.barcode)} | Tồn kho: ${p.amount}</small>
                                            </div>
                                            <div class="ms-auto fw-black text-danger" style="font-size: 14px;">${formatMoney(p.discountedPrice)}</div>
                                        </div>
                                    `;
                                });
                                $("#searchResults").html(html).show();
                            } else {
                                $("#searchResults").hide();
                            }
                        }
                    });
                } else {
                    $("#searchResults").hide();
                }
            });

            // Đóng danh sách kết quả khi click ra ngoài
            $(document).on("click", function(e) {
                if (!$(e.target).closest('.search-bar, #searchResults').length) {
                    $("#searchResults").hide();
                }
            });

            // Định dạng số tiền khi mất focus và khôi phục khi focus vào ô tiền khách đưa
            $("#cashReceivedInput").on("focus", function() {
                const val = $(this).val().replace(/\D/g, "");
                $(this).val(val);
            }).on("blur", function() {
                const val = $(this).val().replace(/\D/g, "");
                if (val) {
                    $(this).val(parseInt(val).toLocaleString('vi-VN'));
                }
            });
        });

        // Xử lý nạp dropdown chi nhánh 3 bước và hết hạn 1 ngày
        function checkPosBranchExpiry() {
            if (cashierWorkingBranchId) {
                activePosBranchId = cashierWorkingBranchId.toString();
                localStorage.setItem("posActiveBranchId", activePosBranchId);
                localStorage.setItem("posBranchSelectedTime", Date.now().toString());
                return;
            }

            let savedTime = localStorage.getItem('posBranchSelectedTime');
            let savedBranchId = localStorage.getItem('posActiveBranchId');
            
            if (savedTime && savedBranchId) {
                let timeDiff = Date.now() - parseInt(savedTime);
                let oneDayMs = 24 * 60 * 60 * 1000;
                
                if (timeDiff >= oneDayMs) {
                    localStorage.removeItem('posActiveBranchId');
                    localStorage.removeItem('posBranchSelectedTime');
                    activePosBranchId = '';
                    showToast("Đã quá 1 ngày kể từ lần chọn chi nhánh cuối. Vui lòng chọn lại chi nhánh!", "warning");
                } else {
                    activePosBranchId = savedBranchId;
                }
            } else {
                activePosBranchId = '';
            }
        }

        function initBranchDropdowns() {
            checkPosBranchExpiry();
            
            let provinces = [...new Set(posBranchesData.map(b => {
                let p = b.province;
                if (p === "Huế") p = "Thừa Thiên Huế";
                return p;
            }))].sort();
            
            const provSelect = $("#posProvinceSelect");
            provSelect.empty().append('<option value="">-- Tỉnh/TP --</option>');
            provinces.forEach(p => {
                const displayName = p === "Thừa Thiên Huế" ? "Huế" : p;
                provSelect.append(`<option value="${p}">${displayName}</option>`);
            });
            
            if (activePosBranchId) {
                let currentBranch = posBranchesData.find(b => b.id == activePosBranchId);
                if (currentBranch) {
                    provSelect.val(currentBranch.province);
                    populateDistricts(currentBranch.province, currentBranch.district, currentBranch.id);
                } else {
                    activePosBranchId = '';
                }
            }
            
            if (cashierWorkingBranchId) {
                provSelect.prop("disabled", true);
                $("#posDistrictSelect").prop("disabled", true);
                $("#posBranchSelect").prop("disabled", true);
            }
            
            provSelect.on("change", function() {
                let prov = $(this).val();
                if (prov === "Huế") prov = "Thừa Thiên Huế";
                if (prov) {
                    populateDistricts(prov);
                    $("#posBranchSelect").empty().append('<option value="">-- Chi nhánh --</option>').prop("disabled", true);
                    activePosBranchId = '';
                    localStorage.removeItem('posActiveBranchId');
                    localStorage.removeItem('posBranchSelectedTime');
                } else {
                    $("#posDistrictSelect").empty().append('<option value="">-- Phường/Xã --</option>').prop("disabled", true);
                    $("#posBranchSelect").empty().append('<option value="">-- Chi nhánh --</option>').prop("disabled", true);
                    activePosBranchId = '';
                    localStorage.removeItem('posActiveBranchId');
                    localStorage.removeItem('posBranchSelectedTime');
                }
                resetPos();
            });
            
            $("#posDistrictSelect").on("change", function() {
                let prov = provSelect.val();
                let dist = $(this).val();
                if (prov && dist) {
                    populateBranches(prov, dist);
                    activePosBranchId = '';
                    localStorage.removeItem('posActiveBranchId');
                    localStorage.removeItem('posBranchSelectedTime');
                } else {
                    $("#posBranchSelect").empty().append('<option value="">-- Chi nhánh --</option>').prop("disabled", true);
                    activePosBranchId = '';
                    localStorage.removeItem('posActiveBranchId');
                    localStorage.removeItem('posBranchSelectedTime');
                }
                resetPos();
            });
            
            $("#posBranchSelect").on("change", function() {
                let val = $(this).val();
                if (val) {
                    activePosBranchId = val;
                    localStorage.setItem("posActiveBranchId", activePosBranchId);
                    localStorage.setItem("posBranchSelectedTime", Date.now().toString());
                    showToast("Đã chuyển sang chi nhánh: " + $("#posBranchSelect option:selected").text());
                } else {
                    activePosBranchId = '';
                    localStorage.removeItem('posActiveBranchId');
                    localStorage.removeItem('posBranchSelectedTime');
                }
                resetPos();
            });
        }
        
        function populateDistricts(province, selectedDistrictValue = "", selectedBranchValue = "") {
            let normProv = province;
            if (normProv === "Huế") normProv = "Thừa Thiên Huế";
            const distSelect = $("#posDistrictSelect");
            distSelect.empty().append('<option value="">-- Phường/Xã --</option>').prop("disabled", false);
            
            $.ajax({
                url: `/Home/GetWards?province=${encodeURIComponent(normProv)}`,
                type: 'GET',
                success: function(districts) {
                    districts.forEach(d => {
                        if (d && d !== "Khác") {
                            distSelect.append(`<option value="${d}">${d}</option>`);
                        }
                    });
                    if (selectedDistrictValue) {
                        distSelect.val(selectedDistrictValue);
                    }
                    if (selectedDistrictValue && selectedBranchValue) {
                        populateBranches(normProv, selectedDistrictValue);
                        $("#posBranchSelect").val(selectedBranchValue);
                    }
                },
                error: function() {
                    let districts = [...new Set(posBranchesData.filter(b => {
                        let p = b.province;
                        if (p === "Huế") p = "Thừa Thiên Huế";
                        return p === normProv;
                    }).map(b => b.district))].sort();
                    districts.forEach(d => {
                        if (d && d !== "Khác") {
                            distSelect.append(`<option value="${d}">${d}</option>`);
                        }
                    });
                    if (selectedDistrictValue) {
                        distSelect.val(selectedDistrictValue);
                    }
                    if (selectedDistrictValue && selectedBranchValue) {
                        populateBranches(normProv, selectedDistrictValue);
                        $("#posBranchSelect").val(selectedBranchValue);
                    }
                }
            });
        }
        
        function populateBranches(province, district) {
            let normProv = province;
            if (normProv === "Huế") normProv = "Thừa Thiên Huế";
            const brSelect = $("#posBranchSelect");
            if (!district) {
                brSelect.empty().append('<option value="">-- Chi nhánh --</option>').prop("disabled", true);
                return;
            }
            let branches = posBranchesData.filter(b => {
                let p = b.province;
                if (p === "Huế") p = "Thừa Thiên Huế";
                return p === normProv && b.district === district;
            }).sort((a,b) => a.name.localeCompare(b.name));
            if (branches.length === 0) {
                brSelect.empty().append('<option value="" style="white-space: nowrap;">Không có chi nhánh tại đây!</option>').prop("disabled", true);
            } else {
                brSelect.empty().append('<option value="">-- Chi nhánh --</option>').prop("disabled", false);
                branches.forEach(b => {
                    brSelect.append(`<option value="${b.id}">${b.name}</option>`);
                });
            }
        }

        function showBranchRequiredModal() {
            const modalEl = document.getElementById('posBranchRequiredModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // 1. QUÉT BẰNG CAMERA VỚI CHỌN THIẾT BỊ (INLINE VÀ QUÉT LIÊN TỤC)
        let html5QrcodeScanner = null;
        let currentCameraId = null;
        let isCameraActive = false;
        
        let lastScannedBarcode = "";
        let lastScanTime = 0;
        const DUPLICATE_COOLDOWN_MS = 2000; // Cooldown 2 giây đối với cùng 1 mã vạch

        // Hàm phát tiếng "bíp" thanh toán siêu thị (sử dụng Web Audio API)
        function playBeep() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                
                oscillator.type = "sine";
                oscillator.frequency.value = 1000; // Tần số 1000Hz phù hợp tiếng bíp siêu thị
                gainNode.gain.setValueAtTime(0.8, audioCtx.currentTime); // Âm lượng 80% (tăng để nghe rõ hơn)
                
                oscillator.start();
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.12);
                oscillator.stop(audioCtx.currentTime + 0.12);
            } catch (e) {
                console.warn("Web Audio API không được hỗ trợ hoặc bị chặn bởi trình duyệt: ", e);
            }
        }

        // Hiệu ứng nháy sáng viền máy quét khi quét thành công
        function flashScannerUI() {
            const container = $("#cameraScannerContainer");
            container.addClass("scanner-flash");
            setTimeout(() => {
                container.removeClass("scanner-flash");
            }, 150);
        }

        function toggleCameraScan(show) {
            if (show === undefined) {
                show = !isCameraActive;
            }
            
            if (show) {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    showToast("Thiết bị hoặc giao thức kết nối (HTTP) không hỗ trợ mở Camera. Vui lòng chuyển sang dùng HTTPS!", "error");
                    return;
                }
                
                isCameraActive = true;
                $("#btnToggleCamera").html('<i class="bi bi-camera-video-off-fill me-2"></i>Tắt Camera').removeClass("btn-success").addClass("btn-danger");
                $("#cameraScannerContainer").slideDown(300, function() {
                    // Dò tìm danh sách camera kết nối
                    Html5Qrcode.getCameras().then(cameras => {
                        const select = $("#cameraSourceSelect");
                        select.empty();
                        
                        if (cameras && cameras.length > 0) {
                            cameras.forEach((camera, index) => {
                                const label = camera.label.toLowerCase();
                                // Ưu tiên các thiết bị camera mô phỏng từ điện thoại hoặc camera sau
                                const isPreferred = label.includes("iriun") || label.includes("droidcam") || label.includes("back") || label.includes("rear");
                                select.append(`<option value="${camera.id}" ${isPreferred ? "selected" : ""}>${camera.label || 'Camera ' + (index + 1)}</option>`);
                            });
                            
                            currentCameraId = select.val() || cameras[0].id;
                            initCameraScanner(currentCameraId);
                        } else {
                            select.append('<option value="">Không tìm thấy camera nào</option>');
                            showToast("Không phát hiện camera nào được kết nối!", "error");
                        }
                    }).catch(err => {
                        showToast("Không thể nạp danh sách camera: " + err, "error");
                    });
                });
            } else {
                isCameraActive = false;
                $("#btnToggleCamera").html('<i class="bi bi-camera-fill me-2"></i>Quét Camera').removeClass("btn-danger").addClass("btn-success");
                $("#cameraScannerContainer").slideUp(300);
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.stop().then(() => {
                        html5QrcodeScanner = null;
                    }).catch(err => console.error(err));
                }
                $("#barcodeInput").focus();
            }
        }

        function initCameraScanner(cameraId) {
            if (html5QrcodeScanner) {
                html5QrcodeScanner.stop().then(() => {
                    html5QrcodeScanner = null;
                    startScannerOnDevice(cameraId);
                }).catch(err => {
                    console.error(err);
                    startScannerOnDevice(cameraId);
                });
            } else {
                startScannerOnDevice(cameraId);
            }
        }

        function startScannerOnDevice(cameraId) {
            // Reset phần tử DOM #reader để giải phóng camera cũ triệt để
            $("#reader").remove();
            $("#cameraScannerContainer .card-body").prepend('<div id="reader" style="width: 100%; max-width: 320px; margin: 0 auto; border-radius: 8px; overflow: hidden; background: #000; border: 2px solid #ccc; transition: all 0.15s ease;"></div>');

            setTimeout(() => {
                try {
                    html5QrcodeScanner = new Html5Qrcode("reader");
                    html5QrcodeScanner.start(
                        cameraId,
                        {
                            fps: 20, // Tăng fps để phản hồi quét nhạy hơn
                            qrbox: function(width, height) {
                                return { width: Math.min(width * 0.8, 280), height: 160 };
                            }
                        },
                        function(decodedText) { // Thành công
                            handleBarcodeScanned(decodedText);
                        },
                        function(error) { // Lỗi quét liên tục (bỏ qua)
                        }
                    ).catch(err => {
                        showToast("Không thể khởi động camera được chọn: " + err, "error");
                    });
                } catch (e) {
                    showToast("Lỗi khởi tạo máy quét: " + e.message, "error");
                }
            }, 300);
        }

        function handleBarcodeScanned(decodedText) {
            const currentTime = Date.now();
            
            // Cơ chế cooldown: Chặn quét trùng mã vạch trong thời gian quy định
            if (decodedText === lastScannedBarcode && (currentTime - lastScanTime) < DUPLICATE_COOLDOWN_MS) {
                return;
            }
            
            lastScannedBarcode = decodedText;
            lastScanTime = currentTime;
            
            playBeep();
            flashScannerUI();
            
            // Gọi hàm thêm sản phẩm
            addProductByBarcode(decodedText);
        }

        function switchCamera(cameraId) {
            if (cameraId) {
                currentCameraId = cameraId;
                initCameraScanner(cameraId);
            }
        }

        function refreshCurrentCamera() {
            if (currentCameraId) {
                showToast("Đang tải lại luồng camera...");
                initCameraScanner(currentCameraId);
            } else {
                toggleCameraScan(true);
            }
        }

        // BIỂU DIỄN VÀ QUÉT THỬ MÃ VẠCH (TEST SCANNING)
        function showTestBarcode(barcode, name, event) {
            if (event) event.stopPropagation(); // Ngăn chặn kích hoạt click dòng sản phẩm
            
            $("#barcodePreviewTitle").text("Quét Thử: " + name);
            $("#previewBarcodeName").text(name + " (" + formatBarcodeText(barcode) + ")");
            
            const modalEl = document.getElementById('barcodePreviewModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
            
            setTimeout(() => {
                try {
                    JsBarcode("#previewBarcodeSvg", barcode, {
                        format: "EAN13",
                        width: 2.3,
                        height: 100,
                        fontSize: 16,
                        displayValue: true
                    });
                } catch (e) {
                    console.warn("EAN-13 check digit calculation failed. Falling back to CODE128 formatting: ", e);
                    try {
                        JsBarcode("#previewBarcodeSvg", barcode, {
                            format: "CODE128",
                            width: 2.3,
                            height: 100,
                            fontSize: 16,
                            displayValue: true
                        });
                    } catch (err) {
                        console.error("Failed to render barcode in fallback format: ", err);
                    }
                }
            }, 300);
        }

        // 2. NGHIỆP VỤ GIỎ HÀNG
        function addProductByInput() {
            const val = $("#barcodeInput").val().trim();
            if (val) {
                addProductByBarcode(val);
            }
        }

        function addProductFromSearch(product) {
            if (!activePosBranchId) {
                showBranchRequiredModal();
                $("#searchResults").hide();
                $("#barcodeInput").val("");
                return;
            }
            $("#searchResults").hide();
            $("#barcodeInput").val("").focus();
            addProductToCart(product);
        }

        function addProductByBarcode(barcode) {
            if (!barcode) return;
            if (!activePosBranchId) {
                showBranchRequiredModal();
                $("#barcodeInput").val("");
                return;
            }
            $("#barcodeInput").val("").focus();

            $.ajax({
                url: '/Pos/GetProductByBarcode',
                type: 'GET',
                data: { barcode: barcode.trim(), branchId: activePosBranchId },
                success: function (data) {
                    if (data.success) {
                        addProductToCart(data);
                    } else {
                        showToast(data.message, "error");
                    }
                },
                error: function () {
                    showToast("Lỗi kết nối máy chủ!", "error");
                }
            });
        }

        function addProductToCart(product) {
            const existing = cartItems.find(item => item.id === product.id);
            const defaultQty = product.isSoldByWeight ? 0.5 : 1;
            
            if (existing) {
                const addQty = existing.isSoldByWeight ? 0.1 : 1;
                const newQty = parseFloat((existing.quantity + addQty).toFixed(3));
                if (newQty > product.amount) {
                    showToast(`Sản phẩm ${product.name} chỉ còn ${product.amount} trong kho!`, "error");
                    return;
                }
                existing.quantity = newQty;
            } else {
                if (product.amount <= 0) {
                    showToast(`Sản phẩm ${product.name} đã hết hàng!`, "error");
                    return;
                }
                cartItems.push({
                    id: product.id,
                    name: product.name,
                    price: product.price,
                    discountedPrice: product.discountedPrice,
                    quantity: defaultQty,
                    image: product.image,
                    amount: product.amount, // Tồn kho thực tế
                    barcode: product.barcode,
                    unit: product.unit || 'cái',
                    isSoldByWeight: product.isSoldByWeight
                });
            }
            renderCart();
            showToast(`Đã thêm ${product.name}`);
        }

        function changeQuantity(productId, delta) {
            const item = cartItems.find(item => item.id === productId);
            if (item) {
                const deltaVal = item.isSoldByWeight ? (delta > 0 ? 0.1 : -0.1) : delta;
                const newQty = parseFloat((item.quantity + deltaVal).toFixed(3));
                if (newQty <= 0) {
                    removeItem(productId);
                    return;
                }
                if (newQty > item.amount) {
                    showToast(`Chỉ còn tồn ${item.amount} ${item.unit} sản phẩm này!`, "error");
                    return;
                }
                item.quantity = newQty;
                renderCart();
            }
        }

        function updateQuantityInput(productId, val) {
            const item = cartItems.find(item => item.id === productId);
            if (item) {
                let newQty = parseFloat(val) || 1.0;
                if (newQty <= 0) newQty = item.isSoldByWeight ? 0.1 : 1.0;
                if (newQty > item.amount) {
                    showToast(`Chỉ còn tồn ${item.amount} ${item.unit} sản phẩm này!`, "error");
                    newQty = item.amount;
                }
                item.quantity = parseFloat(newQty.toFixed(3));
                renderCart();
            }
        }

        function removeItem(productId) {
            cartItems = cartItems.filter(item => item.id !== productId);
            renderCart();
        }

        function renderCart() {
            const body = $("#cartTableBody");
            body.empty();

            if (cartItems.length === 0) {
                body.html(`
                    <tr id="emptyCartRow">
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-upc-scan d-block fs-1 mb-2"></i>
                            Chưa có sản phẩm nào được quét.
                        </td>
                    </tr>
                `);
                calculateTotals();
                return;
            }

            cartItems.forEach(item => {
                const totalVal = item.quantity * item.discountedPrice;
                body.append(`
                    <tr>
                        <td class="py-3 text-center">
                            <img src="${item.image || 'https://placehold.co/50x50'}" class="rounded" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='https://placehold.co/50x50'" />
                        </td>
                        <td class="py-3">
                            <div class="fw-bold" style="font-size: 13.5px; line-height: 1.3;">${item.name}</div>
                            <small class="text-muted" style="font-size: 11px;">Mã vạch: ${formatBarcodeText(item.barcode)}</small>
                        </td>
                        <td class="text-end fw-bold text-secondary py-3">${formatMoney(item.discountedPrice)}</td>
                        <td class="text-center py-3">
                            <div class="d-flex justify-content-center">
                                <div class="quantity-control d-flex align-items-center">
                                    <button type="button" onclick="changeQuantity(${item.id}, -1)">-</button>
                                    <input type="text" value="${item.quantity}" onchange="updateQuantityInput(${item.id}, this.value)" style="width: ${item.isSoldByWeight ? '65px' : '40px'}; text-align: center;" />
                                    <button type="button" onclick="changeQuantity(${item.id}, 1)">+</button>
                                    ${item.isSoldByWeight ? `<span class="small text-secondary ms-1 fw-bold">${item.unit}</span>` : ''}
                                </div>
                            </div>
                        </td>
                        <td class="text-end fw-black text-danger py-3" style="font-size: 14px;">${formatMoney(totalVal)}</td>
                        <td class="text-center py-3">
                            <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle" onclick="removeItem(${item.id})">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });

            calculateTotals();
        }

        // 3. TÍNH TOÁN TIỀN HÓA ĐƠN
        let subtotal = 0;
        let memberDiscount = 0;
        let voucherDiscount = 0;
        let finalTotal = 0;

        function calculateTotals() {
            subtotal = cartItems.reduce((acc, item) => acc + (item.quantity * item.discountedPrice), 0);
            
            // Chiết khấu Rank thành viên
            if (identifiedCustomer) {
                const memberPct = parseFloat(identifiedCustomer.discountPercent) || 0;
                memberDiscount = Math.round(subtotal * memberPct);
                $("#lblMemberPct").text((memberPct * 100).toFixed(0) + "%");
                $("#lblMemberDiscount").text("-" + formatMoney(memberDiscount));
                $("#rowMemberDiscount").attr("style", "display: flex !important;");
            } else {
                memberDiscount = 0;
                $("#rowMemberDiscount").attr("style", "display: none !important;");
            }

            // Chiết khấu Voucher
            if (selectedVoucher) {
                if (subtotal >= selectedVoucher.minOrderValue) {
                    const voucherPct = parseFloat(selectedVoucher.normalizedPercent) || 0;
                    voucherDiscount = subtotal * voucherPct / 100;
                    if (selectedVoucher.maxDiscount > 0 && voucherDiscount > selectedVoucher.maxDiscount) {
                        voucherDiscount = selectedVoucher.maxDiscount;
                    }
                    voucherDiscount = Math.round(voucherDiscount);
                    $("#lblVoucherCode").text(selectedVoucher.code);
                    $("#lblVoucherDiscount").text("-" + formatMoney(voucherDiscount));
                    $("#rowVoucherDiscount").attr("style", "display: flex !important;");
                } else {
                    voucherDiscount = 0;
                    $("#rowVoucherDiscount").attr("style", "display: none !important;");
                    showToast(`Đơn hàng chưa đạt giá trị tối thiểu ${formatMoney(selectedVoucher.minOrderValue)} để dùng voucher này!`, "error");
                    $("#voucherSelect").val("");
                    selectedVoucher = null;
                }
            } else {
                voucherDiscount = 0;
                $("#rowVoucherDiscount").attr("style", "display: none !important;");
            }

            finalTotal = Math.max(0, subtotal - (memberDiscount + voucherDiscount));

            $("#lblSubtotal").text(formatMoney(subtotal));
            $("#lblTotal").text(formatMoney(finalTotal));

            calculateCashChange();
            updateVietQrCode();
        }

        // 4. TRA CỨU HỘI VIÊN & VOUCHER
        function searchCustomer() {
            const phone = $("#customerPhoneInput").val().trim();
            if (!phone) {
                showToast("Vui lòng nhập SĐT hoặc Email khách hàng!", "error");
                return;
            }

            $.ajax({
                url: '/Pos/GetCustomerByPhone',
                type: 'GET',
                data: { phone: phone },
                success: function (data) {
                    if (data.success) {
                        identifiedCustomer = data;
                        $("#custName").text(data.fullName);
                        $("#custTier").text(data.tierName);
                        $("#custPhone").text(data.phone);
                        $("#custPoints").text(data.loyaltyPoints);
                        $("#customerInfoCard").slideDown();

                        // Nạp Vouchers
                        const select = $("#voucherSelect");
                        select.empty();
                        select.append('<option value="">-- Không sử dụng voucher --</option>');
                        if (data.vouchers && data.vouchers.length > 0) {
                            data.vouchers.forEach(v => {
                                select.append(`<option value="${v.code}">${v.code} (${v.description})</option>`);
                            });
                        }
                        showToast(`Đã tìm thấy khách hàng: ${data.fullName}`);
                        calculateTotals();
                    } else {
                        showToast(data.message, "error");
                        clearCustomer();
                    }
                },
                error: function () {
                    showToast("Lỗi hệ thống khi tìm khách hàng!", "error");
                    clearCustomer();
                }
            });
        }

        function clearCustomer() {
            identifiedCustomer = null;
            selectedVoucher = null;
            $("#customerPhoneInput").val("");
            $("#customerInfoCard").slideUp();
            calculateTotals();
        }

        function applyVoucher() {
            const code = $("#voucherSelect").val();
            if (code && identifiedCustomer) {
                selectedVoucher = identifiedCustomer.vouchers.find(v => v.code === code);
            } else {
                selectedVoucher = null;
            }
            calculateTotals();
        }

        // 5. CẤU HÌNH PHƯƠNG THỨC THANH TOÁN
        function setPaymentMethod(method) {
            paymentMethod = method;
            $(".payment-method-btn").removeClass("active");
            $(`.payment-method-btn[data-method="${method}"]`).addClass("active");

            if (method === "Tiền mặt") {
                $("#cashPaymentArea").slideDown();
                $("#qrPaymentArea").slideUp();
                $("#cashReceivedInput").focus();
            } else if (method === "Chuyển khoản") {
                $("#cashPaymentArea").slideUp();
                $("#qrPaymentArea").slideDown();
                updateVietQrCode();
            }
        }

        function calculateCashChange() {
            if (paymentMethod !== "Tiền mặt") return;
            const inputVal = $("#cashReceivedInput").val().replace(/\D/g, "");
            const received = parseInt(inputVal) || 0;
            
            const change = Math.max(0, received - finalTotal);
            $("#lblCashChange").text(formatMoney(change));
        }

        function updateVietQrCode() {
            if (paymentMethod !== "Chuyển khoản") return;
            resetVietQrPreview();
        }

        function resetVietQrPreview() {
            $("#lblQrMessage").text("Chờ tạo đơn");
            $("#vietQrImg").removeAttr("src").hide();
            $("#vietQrPlaceholder").show();
        }

        function showOfficialVietQrCode(transferCode, qrUrl) {
            $("#lblQrMessage").text(transferCode || "Chờ tạo đơn");

            if (qrUrl) {
                $("#vietQrPlaceholder").hide();
                $("#vietQrImg").attr("src", qrUrl).show();
            } else {
                resetVietQrPreview();
            }
        }

        // 6. HOÀN TẤT THANH TOÁN & GỬI EMAIL & IN HÓA ĐƠN
        function processCheckout() {
            if (!activePosBranchId) {
                showBranchRequiredModal();
                return;
            }
            if (cartItems.length === 0) {
                showToast("Giỏ hàng POS trống, hãy quét sản phẩm!", "error");
                return;
            }

            if (paymentMethod === "Tiền mặt") {
                const received = parseInt($("#cashReceivedInput").val().replace(/\D/g, "")) || 0;
                if (received < finalTotal) {
                    showToast("Tiền khách đưa nhỏ hơn tổng số tiền cần thanh toán!", "error");
                    return;
                }
            }

            submitOrderPayload();
        }

        function submitOrderPayload() {
            // Gửi yêu cầu lưu đơn lên Server
            const requestData = {
                customerUserId: identifiedCustomer ? identifiedCustomer.userId : null,
                customerPhone: identifiedCustomer ? (identifiedCustomer.phone || identifiedCustomer.email || $("#customerPhoneInput").val().trim()) : null,
                paymentMethod: paymentMethod,
                discountCode: selectedVoucher ? selectedVoucher.code : null,
                branchId: parseInt(activePosBranchId),
                items: cartItems.map(item => ({
                    productId: item.id,
                    quantity: item.quantity
                }))
            };

            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            // Disable button để tránh nhấn nhiều lần
            $("#btnCheckout").prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo đơn...');

            $.ajax({
                url: '/Pos/CreateInStoreOrder',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                headers: {
                    "RequestVerificationToken": antiForgeryToken
                },
                success: function (res) {
                    $("#btnCheckout").prop("disabled", false).html('<i class="bi bi-printer-fill me-2"></i>THANH TOÁN & IN HÓA ĐƠN');

                    if (res.success) {
                        if (res.requiresVerification) {
                            startPosBankTransferTimer(res.orderId, res.finalTotal, res.transferCode, res.qrUrl);
                            return;
                        }

                        showToast("Thanh toán thành công! Chuẩn bị in hóa đơn...");
                        
                        // Cập nhật hóa đơn in
                        $("#recId").text("#" + res.orderId);
                        $("#recDate").text(res.orderDate);
                        $("#recCustomer").text(res.customerName || (identifiedCustomer ? identifiedCustomer.fullName : "Khách mua trực tiếp"));
                        $("#recMethod").text(res.paymentMethod);
                        
                        const receiptBody = $("#receiptTableBody");
                        receiptBody.empty();
                        cartItems.forEach(item => {
                            const formattedQty = item.isSoldByWeight ? item.quantity : Math.round(item.quantity);
                            receiptBody.append(`
                                <tr>
                                    <td><strong>${item.name}</strong></td>
                                    <td style="text-align: center;">${formattedQty} ${item.unit}</td>
                                    <td style="text-align: right;">${item.discountedPrice.toLocaleString('vi-VN')}</td>
                                    <td style="text-align: right; font-weight: bold;">${(item.quantity * item.discountedPrice).toLocaleString('vi-VN')}</td>
                                </tr>
                            `);
                        });

                        $("#recSubtotal").text(formatMoney(res.subtotal));
                        
                        if (res.memberDiscount > 0) {
                            $("#recMemberPct").text($("#lblMemberPct").text());
                            $("#recMemberDiscount").text("-" + formatMoney(res.memberDiscount));
                            $("#recRowMemberDiscount").show();
                        } else {
                            $("#recRowMemberDiscount").hide();
                        }

                        if (res.voucherDiscount > 0) {
                            $("#recVoucherCode").text(res.discountCode || (selectedVoucher ? selectedVoucher.code : ""));
                            $("#recVoucherDiscount").text("-" + formatMoney(res.voucherDiscount));
                            $("#recRowVoucherDiscount").show();
                        } else {
                            $("#recRowVoucherDiscount").hide();
                        }

                        $("#recTotal").text(formatMoney(res.finalTotal));

                        if (paymentMethod === "Tiền mặt") {
                            const received = parseInt($("#cashReceivedInput").val().replace(/\D/g, "")) || 0;
                            const change = Math.max(0, received - res.finalTotal);
                            $("#recCashReceived").text(received.toLocaleString('vi-VN'));
                            $("#recCashChange").text(change.toLocaleString('vi-VN'));
                            $("#recRowCashDetails").show();
                        } else {
                            $("#recRowCashDetails").hide();
                        }

                        // Gọi hộp thoại in nhiệt của trình duyệt
                        setTimeout(() => {
                            window.print();
                            // Reset giỏ hàng sau khi in xong
                            resetPos();
                        }, 500);

                    } else {
                        showToast(res.message, "error");
                    }
                },
                error: function () {
                    $("#btnCheckout").prop("disabled", false).html('<i class="bi bi-printer-fill me-2"></i>THANH TOÁN & IN HÓA ĐƠN');
                    showToast("Lỗi kết nối khi gửi thanh toán đơn hàng!", "error");
                }
            });
        }

        let posTransferCountdownInterval = null;
        let posAutoCheckInterval = null;
        let posPendingOrderId = null;
        let posSecondsRemaining = 600;

        function startPosBankTransferTimer(orderId, amount, transferCode, qrUrl) {
            posPendingOrderId = orderId;
            posSecondsRemaining = 600;

            // Cập nhật thông tin trên modal
            showOfficialVietQrCode(transferCode, qrUrl);
            $("#posModalAmount").text(formatMoney(amount));
            $("#posModalTransferCode").text(transferCode);
            $("#posModalQrImg").attr("src", qrUrl);
            $("#posModalStatusBox").html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang tự động kiểm tra giao dịch...');

            // Cập nhật đồng hồ đếm ngược lập tức
            updateCountdownUI();

            // Hiển thị modal
            const transferModal = new bootstrap.Modal(document.getElementById('posBankTransferModal'));
            transferModal.show();

            // Xóa các interval cũ nếu có
            clearInterval(posTransferCountdownInterval);
            clearInterval(posAutoCheckInterval);

            // Bắt đầu đếm ngược
            posTransferCountdownInterval = setInterval(() => {
                posSecondsRemaining--;
                updateCountdownUI();
                if (posSecondsRemaining <= 0) {
                    cancelPosPayment(true); // Tự động hủy khi hết hạn
                }
            }, 1000);

            // Bắt đầu kiểm tra tự động mỗi 5 giây
            posAutoCheckInterval = setInterval(checkPosPaymentStatus, 5000);
        }

        function updateCountdownUI() {
            const minutes = Math.floor(posSecondsRemaining / 60);
            const seconds = posSecondsRemaining % 60;
            const displayStr = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            $("#posCountdownTimer").html(`<i class="bi bi-clock-history me-1"></i>${displayStr}`);
        }

        function checkPosPaymentStatus() {
            if (!posPendingOrderId) return;

            $.ajax({
                url: '/Pos/CheckPosBankTransfer',
                type: 'GET',
                data: { orderId: posPendingOrderId },
                success: function (res) {
                    if (res.success) {
                        // Thành công: Xóa các timer và đóng modal
                        clearInterval(posTransferCountdownInterval);
                        clearInterval(posAutoCheckInterval);

                        const modalEl = document.getElementById('posBankTransferModal');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();

                        showToast("Xác nhận chuyển khoản thành công! Chuẩn bị in hóa đơn...");

                        // Cập nhật hóa đơn in
                        $("#recId").text("#" + res.orderId);
                        $("#recDate").text(res.orderDate);
                        $("#recCustomer").text(res.customerName || (identifiedCustomer ? identifiedCustomer.fullName : "Khách mua trực tiếp"));
                        $("#recMethod").text(res.paymentMethod);
                        
                        const receiptBody = $("#receiptTableBody");
                        receiptBody.empty();
                        cartItems.forEach(item => {
                            const formattedQty = item.isSoldByWeight ? item.quantity : Math.round(item.quantity);
                            receiptBody.append(`
                                <tr>
                                    <td><strong>${item.name}</strong></td>
                                    <td style="text-align: center;">${formattedQty} ${item.unit}</td>
                                    <td style="text-align: right;">${item.discountedPrice.toLocaleString('vi-VN')}</td>
                                    <td style="text-align: right; font-weight: bold;">${(item.quantity * item.discountedPrice).toLocaleString('vi-VN')}</td>
                                </tr>
                            `);
                        });

                        $("#recSubtotal").text(formatMoney(res.subtotal));
                        
                        if (res.memberDiscount > 0) {
                            $("#recMemberPct").text($("#lblMemberPct").text());
                            $("#recMemberDiscount").text("-" + formatMoney(res.memberDiscount));
                            $("#recRowMemberDiscount").show();
                        } else {
                            $("#recRowMemberDiscount").hide();
                        }

                        if (res.voucherDiscount > 0) {
                            $("#recVoucherCode").text(res.discountCode || (selectedVoucher ? selectedVoucher.code : ""));
                            $("#recVoucherDiscount").text("-" + formatMoney(res.voucherDiscount));
                            $("#recRowVoucherDiscount").show();
                        } else {
                            $("#recRowVoucherDiscount").hide();
                        }

                        $("#recTotal").text(formatMoney(res.finalTotal));
                        $("#recRowCashDetails").hide();

                        // Gọi in hóa đơn
                        setTimeout(() => {
                            window.print();
                            resetPos();
                        }, 500);
                    } else {
                        $("#posModalStatusBox").html(`<i class="bi bi-info-circle me-1"></i>${res.message || 'Chưa tìm thấy giao dịch.'}`);
                    }
                },
                error: function () {
                    $("#posModalStatusBox").html('<i class="bi bi-exclamation-triangle me-1"></i>Lỗi kết nối kiểm tra thanh toán.');
                }
            });
        }

        function checkPosPaymentNow() {
            $("#btnPosModalCheckNow").prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang kiểm tra...');
            checkPosPaymentStatus();
            setTimeout(() => {
                $("#btnPosModalCheckNow").prop("disabled", false).html('<i class="bi bi-arrow-repeat me-1"></i>Kiểm tra ngay');
            }, 1000);
        }

        function cancelPosPayment(isAutoTimeout = false) {
            if (!posPendingOrderId) return;

            clearInterval(posTransferCountdownInterval);
            clearInterval(posAutoCheckInterval);

            $("#btnPosModalCancel").prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang hủy...');

            $.ajax({
                url: '/Pos/CancelPosOrder',
                type: 'POST',
                data: { orderId: posPendingOrderId },
                success: function (res) {
                    const modalEl = document.getElementById('posBankTransferModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    $("#btnPosModalCancel").prop("disabled", false).html('<i class="bi bi-x-circle me-1"></i>Hủy giao dịch');

                    if (isAutoTimeout) {
                        showToast("Đã hết thời gian 10 phút. Đơn hàng chuyển khoản tự động hủy!", "warning");
                    } else {
                        showToast("Đã hủy giao dịch chuyển khoản POS thành công!", "warning");
                    }

                    posPendingOrderId = null;
                    resetVietQrPreview();
                },
                error: function () {
                    $("#btnPosModalCancel").prop("disabled", false).html('<i class="bi bi-x-circle me-1"></i>Hủy giao dịch');
                    showToast("Có lỗi xảy ra khi hủy đơn hàng chuyển khoản!", "error");
                }
            });
        }

        function resetPos() {
            cartItems = [];
            selectedVoucher = null;
            identifiedCustomer = null;
            renderCart();
            clearCustomer();
            $("#cashReceivedInput").val("");
            $("#lblCashChange").text("0đ");

            setPaymentMethod("Tiền mặt");
            $("#barcodeInput").focus();
        }

        // 7. UTILITIES
        function formatBarcodeText(barcode) {
            if (!barcode) return 'N/A';
            const cleaned = barcode.trim();
            if (cleaned.length === 13) {
                return cleaned.charAt(0) + ' ' + cleaned.substring(1, 7) + ' ' + cleaned.substring(7);
            }
            return cleaned;
        }

        function formatMoney(amount) {
            return Math.round(amount).toLocaleString('vi-VN') + "đ";
        }
    </script>
}
