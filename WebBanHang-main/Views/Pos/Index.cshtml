@inject WebBanHang.Data.ApplicationDbContext Db
@{
    ViewData["Title"] = "Quầy Thanh Toán POS";
    Layout = "_Layout";
}

    <style>
        /* === POS THEME CUSTOMIZATIONS === */
        .pos-container {
            margin-top: 10px;
            font-family: 'Be Vietnam Pro', sans-serif;
        }
        
        .card-premium {
            background: var(--white);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0,0,0,0.06);
            overflow: hidden;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }
        
        html.dark-theme .card-premium {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            border-color: #333;
        }

        .pos-header {
            background: linear-gradient(135deg, var(--green-dark) 0%, var(--green-main) 100%);
            color: #white;
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 15px rgba(44,158,71,0.2);
        }

        .search-results-box {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: var(--white);
            z-index: 1000;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #ddd;
            display: none;
        }

        html.dark-theme .search-results-box {
            border-color: #444;
        }

        .search-result-item {
            padding: 10px 15px;
            cursor: pointer;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: background 0.2s;
        }

        html.dark-theme .search-result-item {
            border-color: #333;
        }

        .search-result-item:hover {
            background: var(--green-light);
            color: var(--green-dark);
        }

        .search-result-item img {
            width: 35px;
            height: 35px;
            border-radius: 4px;
            object-fit: cover;
        }

        .pos-table th {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #888;
            font-weight: 700;
        }

        .pos-table td {
            vertical-align: middle;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            border: 1.5px solid #ececec;
            border-radius: 20px;
            width: fit-content;
            overflow: hidden;
            background: #fafafa;
        }
        
        html.dark-theme .quantity-control {
            border-color: #444;
            background: #242424;
        }

        .quantity-control button {
            border: none;
            background: none;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            cursor: pointer;
            color: var(--gray-text);
            transition: background 0.2s;
        }

        .quantity-control button:hover {
            background: #e8f7ec;
            color: var(--green-dark);
        }

        .quantity-control input {
            border: none;
            width: 35px;
            text-align: center;
            font-size: 13px;
            font-weight: 700;
            background: transparent;
            color: var(--gray-text);
            outline: none;
        }

        .payment-method-btn {
            border: 2px solid #ececec;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            background: var(--white);
            color: var(--gray-text);
            font-weight: 700;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        html.dark-theme .payment-method-btn {
            border-color: #333;
        }

        .payment-method-btn i {
            font-size: 24px;
            color: #888;
        }

        .payment-method-btn.active {
            border-color: var(--green-main);
            background: var(--green-light);
            color: var(--green-dark);
        }

        .payment-method-btn.active i {
            color: var(--green-main);
        }

        /* === PRINTER STYLE (THERMAL RECEIPT FORMAT) === */
        #receiptPrintArea {
            display: none;
            width: 76mm;
            padding: 2mm;
            background: #fff;
            color: #000;
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            line-height: 1.4;
        }

        .receipt-header {
            text-align: center;
            margin-bottom: 4mm;
        }

        .receipt-header h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 900;
        }

        .receipt-divider {
            border-top: 1px dashed #000;
            margin: 2mm 0;
        }

        .receipt-table {
            width: 100%;
            border-collapse: collapse;
        }

        .receipt-table th {
            text-align: left;
            border-bottom: 1px dashed #000;
            font-size: 11px;
        }

        .receipt-table td {
            padding: 1mm 0;
            font-size: 11px;
        }

        .receipt-summary-row {
            display: flex;
            justify-content: space-between;
            margin: 1mm 0;
        }

        @@media print {
            body * {
                visibility: hidden;
            }
            #receiptPrintArea, #receiptPrintArea * {
                visibility: visible;
            }
            #receiptPrintArea {
                display: block !important;
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                top: 0;
                margin: 0;
                padding: 0;
                width: 76mm;
            }
            /* Hướng giấy in nhiệt tự động */
            @@page {
                size: auto;
                margin: 0mm;
            }
        }

        /* Camera reader styling */
        #reader {
            width: 100%;
            max-width: 320px;
            margin: 0 auto;
            border-radius: 8px;
            overflow: hidden;
            background: #000;
            border: 2px solid #ccc;
            transition: all 0.15s ease;
        }

        /* Hiệu ứng nháy quét thành công */
        .scanner-flash {
            border-color: #2c9e47 !important;
            box-shadow: 0 0 20px rgba(44, 158, 71, 0.5) !important;
        }

        /* Bo viền ô nhập mã vạch khi bình thường và hover */
        #barcodeInput {
            border: 2px solid #ced4da !important;
            border-radius: 25px !important;
            transition: all 0.2s ease-in-out;
        }

        #barcodeInput:hover {
            border-color: #a0a0a0 !important;
        }

        #barcodeInput:focus {
            border-color: var(--yellow-sale) !important;
            box-shadow: 0 0 0 0.25rem rgba(255, 214, 0, 0.2) !important;
        }
    </style>

<div class="container-fluid pos-container">
    <!-- Header -->
    <div class="pos-header text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h3 class="mb-0 fw-black"><i class="bi bi-qr-code-scan me-2"></i>Hệ Thống Thanh Toán POS</h3>
            <small class="opacity-75">Bách Hóa XANH - Giao dịch trực tiếp tại quầy</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-success fw-bold py-2 px-3" style="font-size: 13px; height: 38px; display: flex; align-items: center; border-radius: 8px;">
                <i class="bi bi-person-fill-check me-1"></i>Thu ngân: @ViewBag.CashierName
            </span>
            <div class="d-flex align-items-center bg-white text-dark p-1 rounded gap-1" style="border-radius: 8px !important; height: auto; min-height: 38px; padding: 4px 8px !important; flex-wrap: wrap;">
                <span class="text-secondary small fw-bold me-1">Chọn chi nhánh:</span>
                <select id="posProvinceSelect" class="form-select form-select-sm border-0 bg-light fw-bold" style="width: auto; outline: none; box-shadow: none; border-radius: 6px; white-space: nowrap; flex-shrink: 0;">
                    <option value="">-- Tỉnh/TP --</option>
                </select>
                <select id="posDistrictSelect" class="form-select form-select-sm border-0 bg-light fw-bold" style="width: auto; outline: none; box-shadow: none; border-radius: 6px; white-space: nowrap; flex-shrink: 0;" disabled>
                    <option value="">-- Phường/Xã --</option>
                </select>
                <select id="posBranchSelect" class="form-select form-select-sm border-0 bg-light fw-bold" style="width: auto; outline: none; box-shadow: none; border-radius: 6px; white-space: nowrap; flex-shrink: 0;" disabled>
                    <option value="">-- Chi nhánh --</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- CỘT TRÁI: QUÉT MÃ & DANH SÁCH SẢN PHẨM -->
        <div class="col-lg-7">
            <div class="card card-premium">
                <div class="card-body p-4">
                    <!-- Tìm kiếm / Quét mã vạch -->
                    <div class="row g-2 mb-4 position-relative">
                        <div class="col">
                            <div class="search-bar" style="position: relative;">
                                <input type="text" id="barcodeInput" class="form-control py-3 ps-4 pe-4" 
                                       placeholder="Nhập mã vạch sản phẩm" autocomplete="off" autofocus />
                            </div>
                            <!-- Autocomplete Search Results -->
                            <div class="search-results-box" id="searchResults"></div>
                        </div>
                        <div class="col-auto">
                            <button type="button" id="btnToggleCamera" class="btn btn-success py-3 px-4 fw-bold" onclick="toggleCameraScan()">
                                <i class="bi bi-camera-fill me-2"></i>Quét Camera
                            </button>
                        </div>
                    </div>

                    <!-- Camera Scanner Container (Inline) -->
                    <div id="cameraScannerContainer" class="card mb-4 border-success-subtle" style="display: none; border: 1.5px solid var(--green-main); border-radius: 12px; overflow: hidden; background: var(--bs-body-bg);">
                        <div class="card-header bg-success-subtle d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="fw-bold text-success" style="font-size: 14px;"><i class="bi bi-camera-fill me-1"></i>Máy Quét Camera Tự Động</span>
                            <div class="d-flex align-items-center gap-2">
                                <select id="cameraSourceSelect" class="form-select form-select-sm" style="width: auto; max-width: 200px;" onchange="switchCamera(this.value)">
                                    <option value="">Đang tìm camera...</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-success text-white py-0 px-2" onclick="refreshCurrentCamera()" title="Tải lại camera">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                                <button type="button" class="btn-close text-success" onclick="toggleCameraScan(false)" aria-label="Close" style="font-size: 10px;"></button>
                            </div>
                        </div>
                        <div class="card-body text-center p-3">
                            <div id="reader" style="width: 100%; max-width: 320px; margin: 0 auto; border-radius: 8px; overflow: hidden; background: #000; border: 2px solid #ccc;"></div>
                            <p class="text-muted small mb-0 mt-2"><i class="bi bi-info-circle me-1"></i>Máy quét đang hoạt động liên tục. Đưa mã vạch sản phẩm lại gần camera.</p>
                        </div>
                    </div>

                    <!-- Bảng giỏ hàng POS -->
                    <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                        <table class="table table-hover pos-table">
                            <thead>
                                <tr class="text-secondary border-bottom">
                                    <th style="width: 50px;">Ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-end" style="width: 110px;">Đơn giá</th>
                                    <th class="text-center" style="width: 120px;">Số lượng</th>
                                    <th class="text-end" style="width: 120px;">Thành tiền</th>
                                    <th class="text-center" style="width: 50px;">Xóa</th>
                                </tr>
                            </thead>
                            <tbody id="cartTableBody">
                                <!-- Trống mặc định -->
                                <tr id="emptyCartRow">
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="bi bi-upc-scan d-block fs-1 mb-2"></i>
                                        Chưa có sản phẩm nào được quét.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: THÔNG TIN KHÁCH HÀNG & THANH TOÁN -->
        <div class="col-lg-5">
            <!-- 1. Tra cứu hội viên -->
            <div class="card card-premium mb-3">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-person-circle text-success me-2"></i>Tra Cứu Khách Hàng (Tích điểm)</h5>
                </div>
                <div class="card-body">
                    <div class="input-group">
                        <input type="text" id="customerPhoneInput" class="form-control" placeholder="Số điện thoại hoặc Email khách hàng..." />
                        <button class="btn btn-success fw-bold" type="button" onclick="searchCustomer()">
                            <i class="bi bi-search me-1"></i>Tìm
                        </button>
                    </div>

                    <!-- Thông tin khách hàng nếu tìm thấy -->
                    <div id="customerInfoCard" class="mt-3 p-3 rounded bg-light border" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center mb-2" style="min-width: 0;">
                            <span class="fw-bold fs-5 text-success text-truncate me-2" id="custName" style="max-width: 70%;">Nguyễn Văn A</span>
                            <span class="badge bg-warning text-dark fw-black px-2 py-1 fs-6 flex-shrink-0" id="custTier">Hạng Bạc</span>
                        </div>
                        <div class="row text-muted" style="font-size: 13px;">
                            <div class="col-6">
                                <i class="bi bi-telephone-fill me-1"></i><span id="custPhone">0987654321</span>
                            </div>
                            <div class="col-6 text-end">
                                <i class="bi bi-gem me-1"></i>Điểm: <strong class="text-dark" id="custPoints">350</strong>
                            </div>
                        </div>

                        <!-- Danh sách Voucher của khách hàng -->
                        <div class="mt-3 pt-2 border-top">
                            <label class="form-label small fw-bold text-secondary">CHỌN VOUCHER CỦA KHÁCH HÀNG</label>
                            <select id="voucherSelect" class="form-select" onchange="applyVoucher()">
                                <option value="">-- Không sử dụng voucher --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Chi tiết thanh toán -->
            <div class="card card-premium">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-wallet2 text-success me-2"></i>Thông Tin Thanh Toán</h5>
                </div>
                <div class="card-body">
                    <!-- Chi tiết hóa đơn -->
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng tiền hàng:</span>
                        <span class="fw-bold" id="lblSubtotal">0đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-danger" id="rowMemberDiscount" style="display: none !important;">
                        <span class="text-muted">Chiết khấu thành viên (<span id="lblMemberPct">0%</span>):</span>
                        <span class="fw-bold" id="lblMemberDiscount">-0đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-danger" id="rowVoucherDiscount" style="display: none !important;">
                        <span class="text-muted">Voucher giảm giá (<span id="lblVoucherCode">WELCOME</span>):</span>
                        <span class="fw-bold" id="lblVoucherDiscount">-0đ</span>
                    </div>
                    <div class="receipt-divider my-2"></div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold text-success">Khách cần thanh toán:</span>
                        <span class="fs-3 fw-black text-danger" id="lblTotal">0đ</span>
                    </div>

                    <!-- Phương thức thanh toán -->
                    <label class="form-label small fw-bold text-secondary mb-2">HÌNH THỨC THANH TOÁN</label>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <div class="payment-method-btn active" data-method="Tiền mặt" onclick="setPaymentMethod('Tiền mặt')">
                                <i class="bi bi-cash-stack"></i>
                                <span>Tiền mặt</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="payment-method-btn" data-method="Chuyển khoản" onclick="setPaymentMethod('Chuyển khoản')">
                                <i class="bi bi-qr-code"></i>
                                <span>Chuyển khoản</span>
                            </div>
                        </div>
                    </div>

                    <!-- Khu vực tiền mặt -->
                    <div id="cashPaymentArea">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">TIỀN KHÁCH ĐƯA (VNĐ)</label>
                            <input type="text" id="cashReceivedInput" class="form-control py-2 fs-5 fw-bold text-success" placeholder="Nhập số tiền..." oninput="calculateCashChange()" />
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded border mb-4">
                            <span class="fw-bold text-muted">Tiền thừa trả khách:</span>
                            <span class="fs-4 fw-black text-success" id="lblCashChange">0đ</span>
                        </div>
                    </div>

                    <!-- Khu vực chuyển khoản (VietQR) -->
                    <div id="qrPaymentArea" style="display: none;" class="text-center p-3 bg-light rounded border mb-4">
                        <p class="small text-muted mb-2"><i class="bi bi-info-circle-fill text-info me-1"></i>Mã QR chính thức sẽ hiển thị sau khi tạo đơn chuyển khoản</p>
                        <div id="qrCodeContainer" class="d-inline-block p-2 bg-white rounded border mb-2">
                            <!-- VietQR Image -->
                            <img id="vietQrImg" src="" alt="VietQR Code" style="width: 320px; height: 320px; object-fit: contain; display: none;" />
                            <div id="vietQrPlaceholder" class="d-flex align-items-center justify-content-center text-muted small text-center px-3" style="width: 320px; height: 320px;">
                                Chờ tạo đơn chuyển khoản
                            </div>
                        </div>
                        <h6 class="mb-1 fw-bold text-success">Số tài khoản: 34675617 (ACB)</h6>
                        <small class="text-muted">Chủ TK: VO VAN PHU | Nội dung: <span class="fw-bold text-dark" id="lblQrMessage">Chờ tạo đơn</span></small>
                    </div>



                    <!-- Nút thanh toán -->
                    <button type="button" class="btn btn-danger btn-submit py-3 fw-bold fs-5" id="btnCheckout" onclick="processCheckout()">
                        <i class="bi bi-printer-fill me-2"></i>THANH TOÁN & IN HÓA ĐƠN
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: CAMERA SCANNER REMOVED (INLINE SCANNER USED INSTEAD) -->

<!-- MODAL: BARCODE PREVIEW FOR TEST SCANNING -->
<div class="modal fade" id="barcodePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header bg-success text-white py-2 border-0">
                <h6 class="modal-title fw-bold" id="barcodePreviewTitle">Mã Vạch Sản Phẩm</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <svg id="previewBarcodeSvg" style="max-width: 100%;"></svg>
                <p class="small text-muted mt-2 mb-0" id="previewBarcodeName"></p>
            </div>
        </div>
    </div>
</div>

<!-- POS Branch Required Modal -->
<div class="modal fade" id="posBranchRequiredModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="posBranchRequiredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content stock-modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-body p-4 text-center">
                <div class="stock-icon-badge mb-3 bg-warning-subtle text-warning" style="width: 60px; height: 60px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 28px;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                
                <h5 class="fw-bold mb-3 text-warning" id="posBranchRequiredModalLabel">THÔNG BÁO!</h5>
                
                <div class="stock-message-body text-center mb-4">
                    <p class="mb-0 fw-bold text-dark dark-text-light" style="font-size: 14px;">Cần chọn chi nhánh trước khi thanh toán!</p>
                </div>
                
                <div class="d-flex justify-content-center">
                    <button type="button" class="btn btn-warning text-white px-4 py-2 rounded-pill fw-bold" data-bs-dismiss="modal" style="box-shadow: 0 4px 10px rgba(255, 193, 7, 0.2);">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- POS Bank Transfer Countdown Modal -->
<div class="modal fade" id="posBankTransferModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="posBankTransferModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header bg-success text-white py-3 border-0">
                <h5 class="modal-title fw-bold" id="posBankTransferModalLabel"><i class="bi bi-qr-code-scan me-2"></i>Chờ xác nhận chuyển khoản</h5>
            </div>
            <div class="modal-body p-4 text-center">
                <!-- Countdown timer display -->
                <div class="mb-3">
                    <span class="badge bg-danger-subtle text-danger fw-black px-3 py-2 fs-5 rounded-pill" id="posCountdownTimer">
                        <i class="bi bi-clock-history me-1"></i>10:00
                    </span>
                </div>
                
                <p class="small text-muted mb-3"><i class="bi bi-info-circle-fill text-info me-1"></i>Yêu cầu khách hàng quét mã QR bên dưới để thanh toán đơn hàng</p>
                
                <!-- QR Code image -->
                <div class="d-inline-block p-2 bg-white rounded border mb-3">
                    <img id="posModalQrImg" src="" alt="VietQR Code" style="width: 280px; height: 280px; object-fit: contain;" />
                </div>
                
                <!-- Payment info -->
                <div class="text-start bg-light p-3 rounded mb-3" style="font-size: 14px;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Ngân hàng:</span>
