@model IEnumerable<WebBanHang.Models.ComboPromotion>
@{
    ViewData["Title"] = "Quản lý Combo Khuyến Mãi";
    Layout = "_Layout_Admin";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0"><i class="bi bi-tags-fill me-2 text-success"></i>Quản lý Combo Khuyến Mãi</h2>
            <p class="text-muted m-0">Xem và cấu hình các combo giảm giá sản phẩm tự động hoặc tạo từ thuật toán Apriori.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Analyze" class="btn btn-primary fw-bold px-4 py-2" style="border-radius: 8px;">
                <i class="bi bi-cpu me-1"></i> Phân tích Apriori gợi ý Combo
            </a>
        </div>
    </div>

    @if (TempData["ComboMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 8px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["ComboMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ComboError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 8px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ComboError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 my-3 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                    <h5 class="fw-bold">Chưa có combo khuyến mãi nào</h5>
                    <p>Hãy chạy tính năng Phân tích Apriori để tự động đề xuất combo từ dữ liệu mua hàng thực tế.</p>
                    <a asp-action="Analyze" class="btn btn-outline-primary fw-bold mt-2 rounded-pill px-4">Bắt đầu phân tích</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4 py-3" style="font-weight: 700; font-size: 13px;">TÊN COMBO / SẢN PHẨM</th>
                                <th class="py-3 text-center" style="font-weight: 700; font-size: 13px; width: 150px;">MỨC GIẢM GIÁ</th>
                                <th class="py-3 text-center" style="font-weight: 700; font-size: 13px;">SUPPORT / CONFIDENCE</th>
                                <th class="py-3 text-center" style="font-weight: 700; font-size: 13px; width: 120px;">TRẠNG THÁI</th>
                                <th class="py-3 text-center" style="font-weight: 700; font-size: 13px; width: 200px;">HẠN ÁP DỤNG</th>
                                <th class="py-3 text-end pe-4" style="font-weight: 700; font-size: 13px; width: 220px;">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark" style="font-size: 15px;">@c.Name</span>
                                            <span class="text-muted small mt-1">
                                                <i class="bi bi-box-seam me-1"></i> @(c.Product1?.Name ?? "Sản phẩm A") 
                                                <strong class="text-danger mx-1">+</strong> 
                                                <i class="bi bi-box-seam me-1"></i> @(c.Product2?.Name ?? "Sản phẩm B")
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-center">
                                        <form asp-action="UpdateDiscount" method="post" class="d-flex align-items-center justify-content-center gap-1">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <div class="input-group input-group-sm" style="width: 90px;">
                                                <input type="number" name="discountPercent" value="@((c.DiscountPercent * 100).ToString("0"))" min="1" max="100" class="form-control text-center fw-bold" style="border-radius: 6px 0 0 6px;" />
                                                <span class="input-group-text bg-light text-secondary fw-bold">%</span>
                                            </div>
                                            <button type="submit" class="btn btn-success btn-sm" title="Lưu lại" style="border-radius: 6px; padding: 4px 8px;">
                                                <i class="bi bi-save"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="py-3 text-center">
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="badge bg-light text-dark border fw-semibold" style="font-size: 11px;">Support: @((c.Support * 100).ToString("0.##"))%</span>
                                            <span class="badge bg-light text-dark border fw-semibold mt-1" style="font-size: 11px;">Confidence: @((c.Confidence * 100).ToString("0.##"))%</span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge rounded-pill px-3 py-2 @(c.IsActive ? "bg-success" : "bg-secondary")">
                                            @(c.IsActive ? "Đang bật" : "Đang tắt")
                                        </span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <form asp-action="UpdateExpiryDate" method="post" class="d-flex align-items-center justify-content-center gap-1 m-0">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <input type="date" name="expiryDate" value="@(c.ExpiryDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm text-center fw-semibold" style="border-radius: 6px;" />
                                            <button type="submit" class="btn btn-success btn-sm" title="Lưu lại" style="border-radius: 6px; padding: 4px 8px;">
                                                <i class="bi bi-save"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="py-3 text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-action="ToggleActive" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <button type="submit" class="btn @(c.IsActive ? "btn-outline-secondary" : "btn-outline-success") btn-sm fw-bold px-3" style="border-radius: 6px;">
                                                    @(c.IsActive ? "Tắt" : "Bật")
                                                </button>
                                            </form>
                                            <form asp-action="Delete" method="post" class="m-0 delete-combo-form">
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius: 6px;" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 border-top bg-white rounded-bottom-4">
                    <div class="d-flex align-items-center gap-1 text-muted fw-bold small">
                        <span>Trang</span>
                        <input type="number" class="form-control form-control-sm text-center p-0 fw-bold border-success"
                               style="width: 48px; height: 28px; font-size: 13px;"
                               value="@ViewBag.Page" min="1" max="@ViewBag.TotalPages"
                               onkeydown="if(event.key==='Enter'){ event.preventDefault(); window.goToPage(this); }" />
                        <span>/ @ViewBag.TotalPages</span>
                        <button type="button" class="btn btn-sm btn-success py-0 px-2 fw-bold ms-1"
                                style="height: 28px; font-size: 12px; border-radius: 6px;"
                                onclick="window.goToPage(this);">
                            OK
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        @if (ViewBag.Page > 1)
                        {
                            <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.Page - 1)">
                                <i class="bi bi-chevron-left"></i> Trước
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-outline-secondary btn-sm rounded-3 disabled"><i class="bi bi-chevron-left"></i> Trước</span>
                        }

                        @if (ViewBag.Page < ViewBag.TotalPages)
                        {
                            <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.Page + 1)">
                                Sau <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-outline-secondary btn-sm rounded-3 disabled">Sau <i class="bi bi-chevron-right"></i></span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.showCustomConfirm = function (message, onConfirm) {
            document.getElementById('customConfirmModal')?.remove();

            const modal = document.createElement('div');
            modal.id = 'customConfirmModal';
            modal.style.position = 'fixed';
            modal.style.top = '0';
            modal.style.left = '0';
            modal.style.width = '100%';
            modal.style.height = '100%';
            modal.style.backgroundColor = 'rgba(0,0,0,0.5)';
            modal.style.zIndex = '999999';
            modal.style.display = 'flex';
            modal.style.alignItems = 'center';
            modal.style.justifyContent = 'center';
            modal.style.animation = 'fadeIn 0.2s ease-out';

            modal.innerHTML = `
                <div style="background: white; border-radius: 16px; padding: 24px; width: 90%; max-width: 420px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.15); animation: scaleUp 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);">
                    <div style="width: 60px; height: 60px; background: #fff3cd; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 28px; color: #ffc107;"></i>
                    </div>
                    <h5 style="font-weight: 700; color: #333; margin-bottom: 12px; font-family: 'Outfit', sans-serif;">Xác Nhận</h5>
                    <p style="color: #666; font-size: 14px; margin-bottom: 24px; line-height: 1.5; font-family: 'Outfit', sans-serif;">${message}</p>
                    <div style="display: flex; gap: 12px; justify-content: center;">
                        <button type="button" id="btnConfirmCancel" style="background: #e0e0e0; color: #333; border: none; padding: 10px 24px; border-radius: 20px; font-weight: bold; cursor: pointer; transition: all 0.2s; font-family: 'Outfit', sans-serif;">
                            Hủy bỏ
                        </button>
                        <button type="button" id="btnConfirmOk" style="background: #dc3545; color: white; border: none; padding: 10px 24px; border-radius: 20px; font-weight: bold; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(220,53,69,0.2); font-family: 'Outfit', sans-serif;">
                            Đồng ý xóa
                        </button>
                    </div>
                </div>
                <style>
                    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
                    @@keyframes scaleUp { from { transform: scale(0.8); } to { transform: scale(1); } }
                    #btnConfirmCancel:hover { background: #d5d5d5; }
                    #btnConfirmOk:hover { background: #bd2130; transform: translateY(-1px); }
                </style>
            `;

            document.body.appendChild(modal);

            document.getElementById('btnConfirmCancel').addEventListener('click', () => {
                modal.remove();
            });

            document.getElementById('btnConfirmOk').addEventListener('click', () => {
                modal.remove();
                if (onConfirm) onConfirm();
            });
        };

        document.querySelectorAll('.delete-combo-form').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                showCustomConfirm('Bạn có chắc chắn muốn xóa combo này khỏi hệ thống siêu thị không?', () => {
                    form.submit();
                });
            });
        });
    </script>
}
