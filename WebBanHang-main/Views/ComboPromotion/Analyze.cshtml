@model IEnumerable<WebBanHang.Services.AprioriResultItem>
@{
    ViewData["Title"] = "Phân tích Apriori - Đề xuất Combo";
    Layout = "_Layout_Admin";
    var existingComboKeys = ViewBag.ExistingComboKeys as List<string> ?? new List<string>();
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link p-0 fw-bold text-success mb-2 text-decoration-none">
            <i class="bi bi-arrow-left"></i> Quay lại Danh sách Combo
        </a>
        <h2 class="fw-bold text-dark"><i class="bi bi-cpu-fill me-2 text-primary"></i>Phân tích Apriori & Khai phá dữ liệu Đơn hàng</h2>
        <p class="text-muted">Chạy giải thuật Apriori tìm các cặp sản phẩm thường được mua cùng nhau để gợi ý combo khuyến mãi phù hợp.</p>
    </div>

    <!-- Parameter Config Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
        <div class="card-body p-4">
            <form asp-action="Analyze" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary" style="font-size: 13px;">
                        MIN SUPPORT (Độ hỗ trợ tối thiểu)
                        <i class="bi bi-info-circle ms-1 text-muted" title="Tỷ lệ đơn hàng chứa đồng thời cả 2 sản phẩm trên tổng số đơn hàng. Ví dụ 0.02 tức là xuất hiện ít nhất trong 2% số đơn hàng."></i>
                    </label>
                    <input type="number" step="0.001" min="0.001" max="1" name="minSupport" value="@ViewBag.MinSupport" class="form-control" style="border-radius: 8px;" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary" style="font-size: 13px;">
                        MIN CONFIDENCE (Độ tin cậy tối thiểu)
                        <i class="bi bi-info-circle ms-1 text-muted" title="Độ tin cậy khi mua sản phẩm A thì khả năng mua kèm sản phẩm B là bao nhiêu %. Ví dụ 0.20 tức là 20%."></i>
                    </label>
                    <input type="number" step="0.01" min="0.01" max="1" name="minConfidence" value="@ViewBag.MinConfidence" class="form-control" style="border-radius: 8px;" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary fw-bold w-100 py-2" style="border-radius: 8px; height: 38px;">
                        <i class="bi bi-play-fill"></i> Bắt đầu phân tích dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark m-0"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Kết quả Phân tích Đề xuất</h5>
            <span class="badge bg-primary rounded-pill">Tìm thấy @Model.Count() gợi ý hợp lệ</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 my-3 text-muted">
                    <i class="bi bi-search fs-1 d-block mb-3 text-secondary"></i>
                    <h5 class="fw-bold">Không tìm thấy cặp sản phẩm nào phù hợp</h5>
                    <p>Hãy thử hạ mức Min Support hoặc Min Confidence để nới rộng điều kiện phân tích.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4 py-3" style="font-weight: 700; font-size: 13px;">CẶP SẢN PHẨM KHAI PHÁ</th>
                                <th class="py-3 text-center" style="font-weight: 700; font-size: 13px;">SỐ LẦN ĐI KÈM</th>
                                <th class="py-3 text-center" style="font-weight: 700; font-size: 13px;">SUPPORT (ĐỘ HỖ TRỢ)</th>
                                <th class="py-3 text-center" style="font-weight: 700; font-size: 13px;">CONFIDENCE (ĐỘ TIN CẬY)</th>
                                <th class="py-3 text-end pe-4" style="font-weight: 700; font-size: 13px; width: 350px;">THIẾT LẬP COMBO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var key = r.ProductId1 < r.ProductId2 ? $"{r.ProductId1}_{r.ProductId2}" : $"{r.ProductId2}_{r.ProductId1}";
                                var exists = existingComboKeys.Contains(key);

                                <tr class="@(exists ? "bg-light text-muted" : "")">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-dark">@r.ProductName1</span>
                                                <span class="text-muted small">ID: #@r.ProductId1</span>
                                            </div>
                                            <span class="text-primary fw-bold mx-2"><i class="bi bi-arrow-left-right"></i></span>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-dark">@r.ProductName2</span>
                                                <span class="text-muted small">ID: #@r.ProductId2</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-center fw-bold text-secondary">@r.CountTogether lần</td>
                                    <td class="py-3 text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1 fw-bold">@((r.Support * 100).ToString("0.##"))%</span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <div class="d-flex flex-column align-items-center text-start" style="font-size: 12px;">
                                            <div><i class="bi bi-arrow-right-short text-success"></i> 1 &rarr; 2: <strong class="text-dark">@((r.Confidence1To2 * 100).ToString("0.##"))%</strong></div>
                                            <div class="mt-1"><i class="bi bi-arrow-right-short text-success"></i> 2 &rarr; 1: <strong class="text-dark">@((r.Confidence2To1 * 100).ToString("0.##"))%</strong></div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-end pe-4">
                                        @if (exists)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2 fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Đã áp dụng Combo</span>
                                        }
                                        else
                                        {
                                            <form asp-action="CreateCombo" method="post" class="d-flex align-items-center justify-content-end gap-2 m-0">
                                                <input type="hidden" name="productId1" value="@r.ProductId1" />
                                                <input type="hidden" name="productId2" value="@r.ProductId2" />
                                                <input type="hidden" name="support" value="@r.Support" />
                                                <input type="hidden" name="confidence" value="@(Math.Max(r.Confidence1To2, r.Confidence2To1))" />
                                                <input type="hidden" name="name" value="Combo @r.ProductName1 & @r.ProductName2" />
                                                
                                                <div class="input-group input-group-sm" style="width: 130px;">
                                                    <span class="input-group-text bg-white small text-secondary">Giảm</span>
                                                    <input type="number" name="discountPercent" value="10" min="1" max="100" class="form-control text-center fw-bold" />
                                                    <span class="input-group-text bg-light fw-bold">%</span>
                                                </div>

                                                <button type="submit" class="btn btn-success btn-sm fw-bold px-3 py-2" style="border-radius: 6px;">
                                                    <i class="bi bi-plus-circle"></i> Lưu Combo
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
