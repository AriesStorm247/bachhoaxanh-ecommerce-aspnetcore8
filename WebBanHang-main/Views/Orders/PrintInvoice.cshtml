@model WebBanHang.Models.Order
@{
    Layout = null;
    var subtotalAmount = Model.OrderDetails.Sum(x => x.Price * x.Quantity);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hóa đơn #@Model.Id - Bách Hóa Xanh</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS for layout/icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f8;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .receipt-container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            padding: 40px;
            position: relative;
            border: 1px solid #eef2f6;
        }
        .receipt-header {
            text-align: center;
            border-bottom: 2px dashed #e9ecef;
            padding-bottom: 25px;
            margin-bottom: 25px;
        }
        .brand-logo {
            font-size: 24px;
            font-weight: 800;
            color: #008744;
            letter-spacing: -0.5px;
            margin-bottom: 5px;
        }
        .brand-subtitle {
            font-size: 12px;
            color: #888;
            margin-bottom: 0;
        }
        .receipt-title {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
            margin-top: 15px;
            letter-spacing: 0.5px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
            font-size: 13px;
        }
        .info-item label {
            color: #888;
            font-weight: 500;
            margin-bottom: 2px;
            display: block;
        }
        .info-item span {
            font-weight: 600;
            color: #2d3748;
        }
        .product-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }
        .product-table th {
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            padding: 10px 12px;
            border-bottom: 1px solid #e2e8f0;
        }
        .product-table td {
            padding: 12px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
        }
        .summary-section {
            border-top: 2px dashed #e9ecef;
            padding-top: 20px;
            margin-bottom: 25px;
        }
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 14px;
        }
        .summary-row.total {
            font-size: 18px;
            font-weight: 800;
            color: #d93838;
            border-top: 1px solid #e2e8f0;
            padding-top: 12px;
            margin-top: 10px;
        }
        .receipt-footer {
            text-align: center;
            font-size: 12px;
            color: #94a3b8;
            margin-top: 30px;
            border-top: 1px solid #f1f5f9;
            padding-top: 20px;
        }
        .action-bar {
            max-width: 600px;
            margin: 0 auto 20px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        @@media print {
            body {
                background-color: #fff;
                padding: 0;
            }
            .receipt-container {
                box-shadow: none;
                border: none;
                padding: 20px;
                max-width: 100%;
                width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="action-bar no-print">
        <button onclick="window.close();" class="btn btn-outline-secondary btn-sm fw-bold" style="border-radius: 8px;">
            <i class="bi bi-x-circle"></i> Đóng cửa sổ
        </button>
        <button onclick="window.print();" class="btn btn-success btn-sm fw-bold" style="border-radius: 8px;">
            <i class="bi bi-printer"></i> In lại hóa đơn
        </button>
    </div>

    <div class="receipt-container">
        <div class="receipt-header">
            <div class="brand-logo"><i class="bi bi-shop text-success"></i> BÁCH HÓA XANH</div>
            <div class="brand-subtitle">Siêu thị gần nhà, giá tốt tiết kiệm</div>
            <div class="brand-subtitle" style="margin-top: 5px;">
                Địa chỉ: 42/20A Nguyễn Giản Thanh, Phường 15, Quận 10, TP. Hồ Chí Minh<br>
                Hotline: 1900 1908 | Email: contact@bachhoaxanh.com
            </div>
            <h2 class="receipt-title">HÓA ĐƠN BÁN HÀNG</h2>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <label>Mã đơn hàng</label>
                <span>#@Model.Id</span>
            </div>
            <div class="info-item">
                <label>Thời gian</label>
                <span>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="info-item">
                <label>Khách hàng</label>
                <span>@Model.FullName</span>
            </div>
            <div class="info-item">
                <label>Số điện thoại</label>
                <span>@Model.Phone</span>
            </div>
            <div class="info-item" style="grid-column: span 2;">
                <label>Địa chỉ nhận hàng</label>
                <span>@Model.Address</span>
            </div>
            <div class="info-item">
                <label>Phương thức giao hàng</label>
                <span>@(string.IsNullOrEmpty(Model.ShippingMethod) ? "Giao hàng nhanh" : Model.ShippingMethod)</span>
            </div>
            <div class="info-item">
                <label>Trạng thái thanh toán</label>
                <span>@(Model.IsPaid ? "Đã thanh toán" : "Thanh toán khi nhận hàng (COD)")</span>
            </div>
        </div>

        <table class="product-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th class="text-center">SL</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td style="font-weight: 500;">@item.Product.Name</td>
                        <td class="text-center text-muted">@item.Quantity</td>
                        <td class="text-end">@item.Price.ToString("N0") ₫</td>
                        <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="summary-section">
            <div class="summary-row">
                <span class="text-muted">Tạm tính:</span>
                <span class="fw-medium">@subtotalAmount.ToString("N0") ₫</span>
            </div>
            @if (Model.ShippingFee > 0)
            {
                <div class="summary-row">
                    <span class="text-muted">Phí vận chuyển:</span>
                    <span class="fw-medium">+@Model.ShippingFee.ToString("N0") ₫</span>
                </div>
            }
            @if (Model.DiscountAmount > 0)
            {
                <div class="summary-row text-success">
                    <span>Giảm giá @(!string.IsNullOrEmpty(Model.DiscountCode) ? $"({Model.DiscountCode})" : ""):</span>
                    <span>-@Model.DiscountAmount.ToString("N0") ₫</span>
                </div>
            }
            <div class="summary-row total">
                <span>TỔNG CỘNG:</span>
                <span>@Model.TotalAmount.ToString("N0") ₫</span>
            </div>
        </div>

        <div class="receipt-footer">
            <p class="mb-1 fw-semibold text-dark">Cảm ơn quý khách đã mua sắm tại Bách Hóa Xanh!</p>
            <p class="mb-0">Hẹn gặp lại quý khách trong lần mua sắm tiếp theo.</p>
        </div>
    </div>

    <script>
        window.onload = function() {
            window.print();
        }
    </script>
</body>
</html>
