@model WebBanHang.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
    Layout = "_Layout_Admin";
    var subtotalAmount = Model.OrderDetails.Sum(x => x.Price * x.Quantity);
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <a asp-action="History" class="text-decoration-none text-muted fw-bold">
        <i class="bi bi-arrow-left"></i> Quay lại lịch sử
    </a>
    @if (Model.Status != 5)
    {
        <a href="@Url.Action("PrintInvoice", "Orders", new { id = Model.Id })" target="_blank" class="btn btn-outline-success fw-bold px-3 py-2" style="border-radius: 10px;">
            <i class="bi bi-printer-fill me-1"></i> In hóa đơn
        </a>
    }
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-4" style="border-radius:15px;">
            <div class="card-body">
                <h5 class="fw-bold text-success mb-3">THÔNG TIN KHÁCH HÀNG</h5>
                <p class="mb-1 text-muted small">Tên người nhận:</p>
                <h6 class="fw-bold">@Model.FullName</h6>
                
                <p class="mb-1 text-muted small mt-3">Số điện thoại:</p>
                <h6 class="fw-bold text-primary">@Model.Phone</h6>
                
                <p class="mb-1 text-muted small mt-3">Địa chỉ:</p>
                <h6 class="fw-bold">@Model.Address</h6>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="border-radius:15px; overflow:hidden;">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 fw-bold">DANH SÁCH SẢN PHẨM</h5>
            </div>
            <div class="card-body p-0">
                <table class="table align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@item.Product.Image" width="40" class="me-2 rounded border">
                                        <span>@item.Product.Name</span>
                                    </div>
                                </td>
                                <td class="text-center">x @item.Quantity</td>
                                <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("N0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2" class="text-end fw-bold">TẠM TÍNH:</td>
                            <td class="text-end fw-bold">
                                @subtotalAmount.ToString("N0") ₫
                            </td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="2" class="text-end fw-bold text-success">GIẢM GIÁ (@Model.DiscountCode):</td>
                                <td class="text-end fw-bold text-success">-@Model.DiscountAmount.ToString("N0") ₫</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="2" class="text-end fw-bold">TỔNG CỘNG:</td>
                            <td class="text-end fw-bold text-danger fs-5">
                                @Model.TotalAmount.ToString("N0") ₫
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
