<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liên kết tài khoản Google — Bách Hóa Xanh</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { 
            background-color: #0b0b0b; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            min-height: 100vh; 
            margin: 0; 
            color: #ffffff;
        }
        .container-box { 
            width: 440px; 
            background-color: #161616; 
            border-radius: 16px; 
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5); 
            padding: 36px 24px; 
            border: 1px solid #2a2a2a;
        }
        .google-logo { 
            font-size: 24px; 
            font-weight: 700; 
            text-align: center; 
            margin-bottom: 15px; 
            font-family: Arial, sans-serif; 
        }
        .google-logo span:nth-child(1) { color: #4285F4; }
        .google-logo span:nth-child(2) { color: #EA4335; }
        .google-logo span:nth-child(3) { color: #FBBC05; }
        .google-logo span:nth-child(4) { color: #4285F4; }
        .google-logo span:nth-child(5) { color: #34A853; }
        .google-logo span:nth-child(6) { color: #EA4335; }
        
        .title { font-size: 22px; font-weight: 500; text-align: center; color: #e8eaed; margin-bottom: 6px; }
        .subtitle { font-size: 14px; text-align: center; color: #9aa0a6; margin-bottom: 24px; }
        
        .account-list {
            margin-bottom: 20px;
            max-height: 380px;
            overflow-y: auto;
            border-radius: 8px;
            border: 1px solid #2a2a2a;
        }
        
        /* Custom scrollbar */
        .account-list::-webkit-scrollbar {
            width: 6px;
        }
        .account-list::-webkit-scrollbar-track {
            background: #161616;
        }
        .account-list::-webkit-scrollbar-thumb {
            background: #3c4043;
            border-radius: 4px;
        }
        
        .account-item {
            display: flex;
            align-items: center;
            padding: 14px 18px;
            border-bottom: 1px solid #2a2a2a;
            cursor: pointer;
            transition: background-color 0.2s;
            text-decoration: none;
            color: inherit;
        }
        .account-item:last-child {
            border-bottom: none;
        }
        .account-item:hover {
            background-color: #242424;
        }
        
        .avatar-circle {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #ffffff;
            font-size: 16px;
            margin-right: 14px;
            flex-shrink: 0;
        }
        
        .account-info {
            flex-grow: 1;
            line-height: 1.4;
        }
        .account-name {
            font-weight: 500;
            color: #e8eaed;
            font-size: 14px;
        }
        .account-email {
            color: #9aa0a6;
            font-size: 13px;
        }
        
        .use-other-account {
            display: flex;
            align-items: center;
            padding: 14px 18px;
            cursor: pointer;
            transition: background-color 0.2s;
            border-top: 1px solid #2a2a2a;
            color: #8ab4f8;
            font-size: 14px;
            font-weight: 500;
        }
        .use-other-account:hover {
            background-color: #242424;
        }
        .use-other-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #202124;
            color: #8ab4f8;
            font-size: 20px;
            margin-right: 14px;
            flex-shrink: 0;
            border: 1px solid #3c4043;
        }
        
        .btn-google-blue {
            background-color: #8ab4f8;
            color: #202124;
            font-weight: 600;
            border-radius: 6px;
            padding: 10px;
            width: 100%;
            border: none;
            transition: background-color 0.2s;
        }
        .btn-google-blue:hover {
            background-color: #aecbfa;
        }
        
        .form-control-dark {
            background-color: #202124;
            color: #ffffff;
            border: 1px solid #3c4043;
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 15px;
        }
        .form-control-dark:focus {
            background-color: #202124;
            color: #ffffff;
            border-color: #8ab4f8;
            box-shadow: none;
        }
        
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #8ab4f8;
            text-decoration: none;
            font-size: 14px;
        }
        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container-box">
        <div class="google-logo">
            <span>G</span><span>o</span><span>o</span><span>g</span><span>l</span><span>e</span>
        </div>
        <h2 class="title" id="pageTitle">Chọn tài khoản</h2>
        <p class="subtitle" id="pageSubtitle">để tiếp tục liên kết với Bách Hóa Xanh</p>
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 text-start" style="font-size: 13px; border-radius: 6px; background-color: rgba(234, 67, 53, 0.15); border: 1px solid rgba(234, 67, 53, 0.3); color: #f28b82;">
                @TempData["Error"]
            </div>
        }

        <!-- 1. Danh sách tài khoản Google -->
        <div id="accountChooserSection">
            <div class="account-list">
                @foreach (var acc in mockAccounts)
                {
                    <div class="account-item" onclick="submitAccount('@acc.Email')">
                        <div class="avatar-circle" style="background-color: @acc.Color;">
                            @acc.Initial
                        </div>
                        <div class="account-info">
                            <div class="account-name">@acc.Name</div>
                            <div class="account-email">@acc.Email</div>
                        </div>
                    </div>
                }
                
                <div class="use-other-account" onclick="showCustomInput()">
                    <div class="use-other-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <span>Sử dụng một tài khoản khác</span>
                </div>
            </div>
        </div>

        <!-- 2. Form nhập tài khoản khác -->
        <div id="customInputSection" style="display: none;">
            <form method="post" action="/MockAuth/GoogleLink">
                <input type="email" name="email" id="customEmail" class="form-control form-control-dark" placeholder="Email hoặc số điện thoại" required autocomplete="off" />
                <button type="submit" class="btn-google-blue">Xác nhận liên kết</button>
            </form>
            <button class="btn btn-link w-100 text-center mt-3 text-decoration-none" style="color: #8ab4f8; font-size: 14px;" onclick="showAccountChooser()">
                Quay lại chọn tài khoản
            </button>
        </div>

        <!-- Hidden Form for account click -->
        <form id="hiddenLinkForm" method="post" action="/MockAuth/GoogleLink" style="display: none;">
            <input type="hidden" name="email" id="hiddenEmailInput" />
        </form>

        <a href="/CustomerProfile/Edit" class="back-link"><i class="bi bi-arrow-left me-1"></i> Quay lại Hồ sơ</a>
    </div>

    <script>
        function submitAccount(email) {
            document.getElementById('hiddenEmailInput').value = email;
            document.getElementById('hiddenLinkForm').submit();
        }

        function showCustomInput() {
            document.getElementById('accountChooserSection').style.display = 'none';
            document.getElementById('customInputSection').style.display = 'block';
            document.getElementById('pageTitle').innerText = 'Đăng nhập';
            document.getElementById('pageSubtitle').innerText = 'Sử dụng tài khoản Google của bạn';
            document.getElementById('customEmail').focus();
        }

        function showAccountChooser() {
            document.getElementById('customInputSection').style.display = 'none';
            document.getElementById('accountChooserSection').style.display = 'block';
            document.getElementById('pageTitle').innerText = 'Chọn tài khoản';
            document.getElementById('pageSubtitle').innerText = 'để tiếp tục liên kết với Bách Hóa Xanh';
        }
    </script>
</body>
</html>
