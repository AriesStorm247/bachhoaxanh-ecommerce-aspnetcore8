@model IEnumerable<WebBanHang.Models.Discount>
@using WebBanHang.Models
@using WebBanHang.Services

@{
    ViewData["Title"] = "Quản lý mã giảm giá";
    Layout = "_Layout_Admin";

    var now = DateTime.Now;
    var total = Model.Count();
    var active = Model.Count(d => d.IsSee && d.Quantity > 0 && d.StartDate <= now && d.EndDate >= now);
    var scheduled = Model.Count(d => d.IsSee && d.StartDate > now);
    var unavailable = Model.Count(d => !d.IsSee || d.Quantity <= 0 || d.EndDate < now);
}

@functions {
    private static string GetStatusText(Discount discount)
    {
        var now = DateTime.Now;

        if (!discount.IsSee)
        {
            return "Tạm ẩn";
        }

        if (discount.EndDate < now)
        {
            return "Hết hạn";
        }

        if (discount.Quantity <= 0)
        {
            return "Hết lượt";
        }

        if (discount.StartDate > now)
        {
            return "Sắp áp dụng";
        }

        return "Đang áp dụng";
    }

    private static string GetStatusClass(Discount discount)
    {
        var now = DateTime.Now;

        if (!discount.IsSee)
        {
            return "status-hidden";
        }

        if (discount.EndDate < now)
        {
            return "status-expired";
        }

        if (discount.Quantity <= 0)
        {
            return "status-out";
        }

        if (discount.StartDate > now)
        {
            return "status-wait";
        }

        return "status-active";
    }
}

@section Styles {
    <style>
        .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
        .stat-card { background: #fff; border-radius: 13px; padding: 16px 18px; box-shadow: 0 1px 10px rgba(0,0,0,.06); display: flex; align-items: center; gap: 13px; }
        .stat-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
        .si-green { background: var(--green-light); color: var(--green-main); }
        .si-blue { background: #eff6ff; color: #3b82f6; }
        .si-yellow { background: #fff8e1; color: #d97706; }
        .si-red { background: #fff0f0; color: var(--red); }
        .stat-num { font-size: 24px; font-weight: 900; color: #111; line-height: 1; }
        .stat-lbl { font-size: 12px; color: #999; font-weight: 500; margin-top: 3px; }

        .tcard { background: #fff; border-radius: 14px; box-shadow: 0 2px 16px rgba(0,0,0,.07); overflow: hidden; }
        .tcard-head { padding: 16px 22px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0f0f0; flex-wrap: wrap; gap: 12px; }
        .tcard-title { font-size: 15px; font-weight: 800; color: #1a1a1a; display: flex; align-items: center; gap: 7px; }
        .tcard-title i { color: var(--green-main); }
        .toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .search-box { position: relative; }
        .search-box input { padding: 8px 14px 8px 36px; border: 1.5px solid #e8e8e8; border-radius: 20px; font-size: 13px; outline: none; width: 240px; transition: all .2s; }
        .search-box input:focus { border-color: var(--green-main); box-shadow: 0 0 0 3px rgba(44,158,71,.1); }
        .search-box i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #bbb; font-size: 13px; }
        .btn-add { background: linear-gradient(135deg, var(--green-main), var(--green-accent)); color: #fff; border: none; border-radius: 20px; padding: 8px 18px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 3px 10px rgba(44,158,71,.28); }
        .btn-add:hover { color: #fff; transform: translateY(-1px); }

        .ptable { width: 100%; border-collapse: collapse; min-width: 980px; }
        .ptable thead tr { background: #fafafa; border-bottom: 2px solid #f0f0f0; }
        .ptable thead th { padding: 11px 16px; font-size: 11px; font-weight: 800; color: #aaa; text-transform: uppercase; letter-spacing: .8px; }
        .ptable tbody tr { border-bottom: 1px solid #f7f7f7; transition: background .12s; }
        .ptable tbody tr:hover { background: #fafffe; }
        .ptable tbody td { padding: 13px 16px; font-size: 13px; vertical-align: middle; }
        .id-chip { background: #f2f2f2; color: #999; border-radius: 6px; padding: 2px 8px; font-size: 11.5px; font-weight: 700; }
        .code-chip { display: inline-flex; align-items: center; gap: 7px; background: #ecfdf3; color: var(--green-dark); border: 1px solid #c9f0d5; border-radius: 9px; padding: 7px 10px; font-size: 13px; font-weight: 900; letter-spacing: .4px; }
        .money { font-size: 14px; font-weight: 900; color: var(--red); white-space: nowrap; }
        .condition { color: #777; line-height: 1.6; }
        .condition strong { color: #333; }
        .date-range { color: #555; line-height: 1.65; white-space: nowrap; }
        .qty-chip { display: inline-flex; align-items: center; justify-content: center; min-width: 42px; border-radius: 20px; padding: 4px 10px; font-size: 12px; font-weight: 800; background: var(--green-light); color: var(--green-dark); }
        .qty-chip.empty { background: #fff0f0; color: var(--red); }
        .status-badge { display: inline-flex; align-items: center; gap: 6px; border-radius: 20px; padding: 5px 10px; font-size: 12px; font-weight: 800; white-space: nowrap; }
        .status-active { background: var(--green-light); color: var(--green-dark); }
        .status-wait { background: #eff6ff; color: #2563eb; }
        .status-hidden { background: #f2f2f2; color: #666; }
        .status-expired, .status-out { background: #fff0f0; color: var(--red); }

        .actions { display: flex; justify-content: center; gap: 5px; }
        .btn-act { width: 32px; height: 32px; border-radius: 8px; border: none; display: flex; align-items: center; justify-content: center; transition: all .15s; text-decoration: none; }
        .btn-act:hover { transform: scale(1.08); }
        .btn-edit { background: #eff6ff; color: #3b82f6; }
        .btn-detail { background: #fefce8; color: #b45309; }
        .btn-del { background: #fff0f0; color: var(--red); }

        .empty-state { padding: 48px 20px; color: #888; text-align: center; }
        .empty-state i { display: block; font-size: 42px; color: #d8d8d8; margin-bottom: 10px; }

        .modal-bg { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 300; align-items: center; justify-content: center; }
        .modal-bg.open { display: flex; }
        .modal-box { background: #fff; border-radius: 18px; padding: 28px; max-width: 390px; width: 90%; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,.2); }
        .modal-icon { width: 54px; height: 54px; border-radius: 50%; background: #fff0f0; color: var(--red); display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 12px; }
        .modal-title { font-size: 18px; font-weight: 900; color: #222; margin-bottom: 7px; }
        .modal-desc { color: #777; font-size: 13px; margin-bottom: 20px; }
        .modal-btns { display: flex; justify-content: center; gap: 10px; }
        .mbtn-cancel { padding: 10px 20px; border-radius: 20px; border: 1px solid #ddd; background: #fff; cursor: pointer; }
        .mbtn-del { padding: 10px 20px; border-radius: 20px; border: none; background: var(--red); color: #fff; cursor: pointer; }

        @@media (max-width: 980px) {
            .stats-row { grid-template-columns: repeat(2, 1fr); }
        }

        @@media (max-width: 620px) {
            .stats-row { grid-template-columns: 1fr; }
            .search-box input { width: 100%; }
            .toolbar { width: 100%; }
            .btn-add { width: 100%; justify-content: center; }
        }
    </style>
}

<div class="mb-3">
    <button class="btn btn-outline-success" onclick="window.location.href='/'">
        <i class="bi bi-arrow-left-circle"></i>
        Quay lại Trang chủ
    </button>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon si-green"><i class="bi bi-ticket-perforated-fill"></i></div>
        <div>
            <div class="stat-num">@total</div>
            <div class="stat-lbl">Tổng mã giảm giá</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-blue"><i class="bi bi-patch-check-fill"></i></div>
        <div>
            <div class="stat-num">@active</div>
            <div class="stat-lbl">Đang áp dụng</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-yellow"><i class="bi bi-clock-history"></i></div>
        <div>
            <div class="stat-num">@scheduled</div>
            <div class="stat-lbl">Sắp áp dụng</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-red"><i class="bi bi-slash-circle-fill"></i></div>
        <div>
            <div class="stat-num">@unavailable</div>
            <div class="stat-lbl">Không khả dụng</div>
        </div>
    </div>
</div>

<div class="tcard">
    <div class="tcard-head">
        <div class="tcard-title">
            <i class="bi bi-list-ul"></i> Danh sách mã giảm giá
        </div>
        <div class="toolbar">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="searchInput" placeholder="Tìm mã giảm giá..." oninput="filterRows()" />
            </div>
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Thêm mới</a>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="ptable" id="discountTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Mã giảm giá</th>
                    <th>Mức giảm</th>
                    <th>Điều kiện</th>
                    <th>Thời gian</th>
                    <th>Số lượt</th>
                    <th>Trạng thái</th>
                    <th style="text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr data-search="@($"{item.Id} {item.Code} {GetStatusText(item)}")">
                            <td><span class="id-chip">#@item.Id</span></td>
                            <td>
                                <span class="code-chip">
                                    <i class="bi bi-ticket-detailed-fill"></i>
                                    @item.Code
                                </span>
                            </td>
                            <td><span class="money">@DiscountPercent.Format(item.DiscountValue)%</span></td>
                            <td>
                                <div class="condition">
                                    Đơn từ <strong>@item.MinOrderValue.ToString("N0")₫</strong><br />
                                    Tối đa <strong>@(item.MaxDiscount > 0 ? $"{item.MaxDiscount.ToString("N0")}₫" : "Không giới hạn")</strong>
                                </div>
                            </td>
                            <td>
                                <div class="date-range">
                                    <i class="bi bi-calendar2-check text-success"></i> @item.StartDate.ToString("dd/MM/yyyy HH:mm")<br />
                                    <i class="bi bi-calendar2-x text-danger"></i> @item.EndDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td>
                                <span class="qty-chip @(item.Quantity <= 0 ? "empty" : "")">@item.Quantity</span>
                            </td>
                            <td>
                                <span class="status-badge @GetStatusClass(item)">
                                    <i class="bi bi-circle-fill" style="font-size:7px;"></i>
                                    @GetStatusText(item)
                                </span>
                            </td>
                            <td>
                                <div class="actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-act btn-edit" title="Sửa mã">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-act btn-detail" title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <button type="button"
                                            class="btn-act btn-del"
                                            title="Xóa mã"
                                            data-delete-id="@item.Id"
                                            data-delete-code="@item.Code">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="bi bi-ticket-perforated"></i>
                                Chưa có mã giảm giá nào. Hãy thêm mã đầu tiên để dùng trong giỏ hàng.
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center p-3 border-top bg-white rounded-bottom-4">
        <div class="d-flex align-items-center gap-1 text-muted fw-bold small">
            <span>Trang</span>
            <input type="number" class="form-control form-control-sm text-center p-0 fw-bold border-success"
                   style="width: 48px; height: 28px; font-size: 13px;"
                   value="@ViewBag.Page" min="1" max="@ViewBag.TotalPages"
                   onkeydown="if(event.key==='Enter'){ event.preventDefault(); window.goToPage(this); }" />
            <span>/ @ViewBag.TotalPages</span>
            <button type="button" class="btn btn-sm btn-success py-0 px-2 fw-bold ms-1"
                    style="height: 28px; font-size: 12px; border-radius: 6px;"
                    onclick="window.goToPage(this);">
                OK
            </button>
        </div>
        <div class="d-flex gap-2">
            @if (ViewBag.Page > 1)
            {
                <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.Page - 1)">
                    <i class="bi bi-chevron-left"></i> Trước
                </a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm rounded-3 disabled"><i class="bi bi-chevron-left"></i> Trước</span>
            }

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <a class="btn btn-outline-success btn-sm rounded-3 fw-bold"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.Page + 1)">
                    Sau <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm rounded-3 disabled">Sau <i class="bi bi-chevron-right"></i></span>
            }
        </div>
    </div>
</div>

<div class="modal-bg" id="delModal">
    <div class="modal-box">
        <div class="modal-icon"><i class="bi bi-trash3-fill"></i></div>
        <div class="modal-title">Xác nhận xoá</div>
        <p class="modal-desc">Bạn có chắc muốn xoá mã <strong id="delCode"></strong>?</p>
        <div class="modal-btns">
            <button class="mbtn-cancel" type="button" onclick="closeDelete()">Huỷ</button>
            <form asp-action="Delete" method="post" style="display:inline;">
                <input type="hidden" name="id" id="delId" />
                <button type="submit" class="mbtn-del">Xoá ngay</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterRows() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#discountTable tbody tr[data-search]').forEach(row => {
                row.style.display = row.dataset.search.toLowerCase().includes(q) ? '' : 'none';
            });
        }

        document.querySelectorAll('[data-delete-id]').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('delId').value = button.dataset.deleteId;
                document.getElementById('delCode').textContent = button.dataset.deleteCode;
                document.getElementById('delModal').classList.add('open');
            });
        });

        function closeDelete() {
            document.getElementById('delModal').classList.remove('open');
        }

        @if (TempData["Success"] != null) { <text>showToast(@Json.Serialize(TempData["Success"]));</text> }
        @if (TempData["Error"] != null) { <text>showToast(@Json.Serialize(TempData["Error"]), 'error');</text> }
    </script>
}
