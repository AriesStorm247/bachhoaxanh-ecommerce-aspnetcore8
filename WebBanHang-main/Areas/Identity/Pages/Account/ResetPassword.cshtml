@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt mật khẩu mới";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt mật khẩu mới — Bách Hóa Xanh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #0d3320;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-bar {
            padding: 16px 28px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .logo-pill { display: flex; align-items: center; gap: 10px; }
        .logo-box {
            background: #fff; color: #1a7c3e; font-weight: 800;
            font-size: 16px; padding: 5px 12px; border-radius: 8px; letter-spacing: 2px;
        }
        .logo-name { color: rgba(255,255,255,0.8); font-size: 13px; }

        .main {
            flex: 1; display: flex; align-items: center;
            justify-content: center; padding: 40px 16px;
        }

        .card-wrap {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px; padding: 44px 40px;
            width: 100%; max-width: 440px;
            backdrop-filter: blur(12px);
        }

        .card-icon {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #1a7a2e, #38b558);
            border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 22px; font-size: 28px; color: #fff;
            box-shadow: 0 6px 24px rgba(44,158,71,0.35);
        }

        .card-title { color: #fff; font-size: 22px; font-weight: 800; text-align: center; margin-bottom: 8px; }
        .card-sub { color: rgba(255,255,255,0.5); font-size: 13px; text-align: center; line-height: 1.6; margin-bottom: 28px; }

        .field-label {
            color: rgba(255,255,255,0.7); font-size: 12px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.6px;
            margin-bottom: 7px; display: block;
        }

        .inp-wrap { position: relative; margin-bottom: 20px; }
        .inp-icon {
            position: absolute; left: 14px; top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.35); font-size: 16px; pointer-events: none;
        }
        .inp-toggle {
            position: absolute; right: 14px; top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.3); font-size: 16px;
            cursor: pointer; background: none; border: none; padding: 0;
            transition: color .2s;
        }
        .inp-toggle:hover { color: rgba(255,255,255,0.7); }

        .form-control {
            background: rgba(255,255,255,0.07);
            border: 1.5px solid rgba(255,255,255,0.15);
            border-radius: 12px;
            color: #fff !important;
            caret-color: #fff;
            padding: 13px 42px; font-size: 15px; width: 100%;
            transition: border-color .2s, box-shadow .2s;
        }
        .form-control::placeholder { color: rgba(255,255,255,0.25); }
        .form-control:focus {
            outline: none; border-color: #38b558;
            box-shadow: 0 0 0 4px rgba(56,181,88,.18);
            background: rgba(255,255,255,0.1);
            color: #fff !important;
        }
        .form-control:-webkit-autofill,
        .form-control:-webkit-autofill:hover,
        .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: #fff !important;
            -webkit-box-shadow: 0 0 0 1000px rgba(26,90,46,0.95) inset !important;
            box-shadow: 0 0 0 1000px rgba(26,90,46,0.95) inset !important;
            caret-color: #fff;
        }

        /* Password strength bar */
        .strength-bar { height: 4px; border-radius: 2px; background: rgba(255,255,255,0.1); margin-top: 8px; overflow: hidden; }
        .strength-fill { height: 100%; border-radius: 2px; transition: width .3s, background .3s; width: 0; }
        .strength-label { font-size: 11px; margin-top: 4px; margin-bottom: 16px; }

        .btn-save {
            width: 100%;
            background: linear-gradient(135deg, #1a7a2e, #38b558);
            border: none; color: #fff; border-radius: 12px;
            padding: 14px; font-size: 15px; font-weight: 800;
            cursor: pointer; transition: transform .15s, box-shadow .15s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            margin-top: 4px;
        }
        .btn-save:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(44,158,71,.4); }

        .alert-error {
            background: rgba(220,53,69,0.15); border: 1px solid rgba(220,53,69,0.35);
            border-radius: 10px; color: #ff8a96;
            padding: 12px 16px; font-size: 13px; margin-bottom: 18px;
        }
        .alert-error:empty { display: none; }

        .requirements {
            background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px; padding: 12px 16px; margin-bottom: 20px;
            font-size: 12px; color: rgba(255,255,255,0.45); line-height: 1.8;
        }
        .requirements li { list-style: none; display: flex; align-items: center; gap: 6px; }
        .req-ok { color: #38b558; }
        .req-fail { color: rgba(255,255,255,0.3); }

        .links { text-align: center; margin-top: 22px; }
        .links a { color: rgba(255,255,255,0.4); font-size: 13px; text-decoration: none; transition: color .2s; }
        .links a:hover { color: #5cd17a; }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="logo-pill">
            <div class="logo-box">BHX</div>
            <span class="logo-name">Bách Hóa XANH</span>
        </div>
        <a href="/" style="color:rgba(255,255,255,0.5); font-size:13px; text-decoration:none;">
            <i class="bi bi-house-door-fill"></i> Trang chủ
        </a>
    </div>

    <div class="main">
        <div class="card-wrap">
            <div class="card-icon">
                <i class="bi bi-lock-fill"></i>
            </div>
            <div class="card-title">Đặt mật khẩu mới</div>
            <div class="card-sub">Tạo mật khẩu mới mạnh mẽ cho tài khoản của bạn.</div>

            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <ul class="requirements" id="reqList">
                <li id="reqLen"><i class="bi bi-circle req-fail"></i> Ít nhất 8 ký tự</li>
                <li id="reqUpper"><i class="bi bi-circle req-fail"></i> Có chữ hoa (A–Z)</li>
                <li id="reqDigit"><i class="bi bi-circle req-fail"></i> Có chữ số (0–9)</li>
                <li id="reqSpecial"><i class="bi bi-circle req-fail"></i> Có ký tự đặc biệt (!@@#$%...)</li>
                <li id="reqMatch"><i class="bi bi-circle req-fail"></i> Xác nhận khớp mật khẩu</li>
            </ul>

            <form method="post" id="resetForm">
                <label class="field-label" for="Input_Password">Mật khẩu mới</label>
                <div class="inp-wrap">
                    <i class="bi bi-lock-fill inp-icon"></i>
                    <input asp-for="Input.Password" id="Input_Password" class="form-control"
                           type="password" placeholder="Nhập mật khẩu mới" autocomplete="new-password" />
                    <button type="button" class="inp-toggle" onclick="togglePwd('Input_Password', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                <div class="strength-label" id="strengthLabel" style="color:rgba(255,255,255,0.35);"></div>
                <span asp-validation-for="Input.Password" style="color:#ff8a96; font-size:12px; display:block; margin-bottom:10px;"></span>

                <label class="field-label" for="Input_ConfirmPassword">Xác nhận mật khẩu</label>
                <div class="inp-wrap">
                    <i class="bi bi-lock-fill inp-icon"></i>
                    <input asp-for="Input.ConfirmPassword" id="Input_ConfirmPassword" class="form-control"
                           type="password" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                    <button type="button" class="inp-toggle" onclick="togglePwd('Input_ConfirmPassword', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" style="color:#ff8a96; font-size:12px; display:block; margin-bottom:16px;"></span>

                <button type="submit" class="btn-save" id="saveBtn">
                    <i class="bi bi-check2-circle"></i>
                    <span>Lưu mật khẩu mới</span>
                </button>
            </form>

            <div class="links">
                <a href="/Identity/Account/Login">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                </a>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(id, btn) {
            var inp = document.getElementById(id);
            var icon = btn.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                inp.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function setReq(id, ok) {
            var el = document.getElementById(id);
            var icon = el.querySelector('i');
            icon.className = ok ? 'bi bi-check-circle-fill req-ok' : 'bi bi-circle req-fail';
        }

        var pwdInput = document.getElementById('Input_Password');
        var confirmInput = document.getElementById('Input_ConfirmPassword');
        var fill = document.getElementById('strengthFill');
        var strengthLabel = document.getElementById('strengthLabel');

        function evalStrength(p) {
            var score = 0;
            if (p.length >= 6) score++;
            if (p.length >= 10) score++;
            if (/[A-Z]/.test(p)) score++;
            if (/[0-9]/.test(p)) score++;
            if (/[^A-Za-z0-9]/.test(p)) score++;
            return score;
        }

        pwdInput.addEventListener('input', function() {
            var p = this.value;
            setReq('reqLen', p.length >= 8);
            setReq('reqUpper', /[A-Z]/.test(p));
            setReq('reqDigit', /[0-9]/.test(p));
            setReq('reqSpecial', /[^A-Za-z0-9]/.test(p));
            setReq('reqMatch', p && p === confirmInput.value);

            var score = evalStrength(p);
            var pct = (score / 5) * 100;
            var colors = ['#e05260','#e07b52','#e0b352','#8bc34a','#38b558'];
            var labels = ['Rất yếu','Yếu','Trung bình','Mạnh','Rất mạnh'];
            fill.style.width = pct + '%';
            fill.style.background = colors[score - 1] || '#e05260';
            strengthLabel.textContent = p ? labels[score - 1] || '' : '';
            strengthLabel.style.color = colors[score - 1] || 'rgba(255,255,255,0.35)';
        });

        confirmInput.addEventListener('input', function() {
            setReq('reqMatch', this.value && this.value === pwdInput.value);
        });

        document.getElementById('resetForm').addEventListener('submit', function() {
            var btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
        });
    </script>
</body>
</html>
