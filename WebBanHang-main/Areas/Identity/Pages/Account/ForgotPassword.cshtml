@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu — Bách Hóa Xanh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #0d3320;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-bar {
            padding: 16px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .logo-pill { display: flex; align-items: center; gap: 10px; }
        .logo-box {
            background: #fff;
            color: #1a7c3e;
            font-weight: 800;
            font-size: 16px;
            padding: 5px 12px;
            border-radius: 8px;
            letter-spacing: 2px;
        }
        .logo-name { color: rgba(255,255,255,0.8); font-size: 13px; }

        .main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }

        .card-wrap {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 44px 40px;
            width: 100%;
            max-width: 440px;
            backdrop-filter: blur(12px);
        }

        .card-icon {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #1a7a2e, #38b558);
            border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 22px;
            font-size: 28px;
            color: #fff;
            box-shadow: 0 6px 24px rgba(44,158,71,0.35);
        }

        .card-title {
            color: #fff;
            font-size: 22px;
            font-weight: 800;
            text-align: center;
            margin-bottom: 8px;
        }

        .card-sub {
            color: rgba(255,255,255,0.5);
            font-size: 13px;
            text-align: center;
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .field-label {
            color: rgba(255,255,255,0.7);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 7px;
            display: block;
        }

        .inp-wrap { position: relative; margin-bottom: 20px; }
        .inp-icon {
            position: absolute;
            left: 14px; top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.35);
            font-size: 16px;
            pointer-events: none;
        }

        .form-control {
            background: rgba(255,255,255,0.07);
            border: 1.5px solid rgba(255,255,255,0.15);
            border-radius: 12px;
            color: #fff !important;
            padding: 13px 14px 13px 42px;
            font-size: 15px;
            width: 100%;
            transition: border-color .2s, box-shadow .2s;
            caret-color: #fff;
        }
        .form-control::placeholder { color: rgba(255,255,255,0.25); }
        .form-control:focus {
            outline: none;
            border-color: #38b558;
            box-shadow: 0 0 0 4px rgba(56,181,88,.18);
            background: rgba(255,255,255,0.1);
            color: #fff !important;
        }
        .form-control:-webkit-autofill,
        .form-control:-webkit-autofill:hover,
        .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: #fff !important;
            -webkit-box-shadow: 0 0 0 1000px rgba(26,90,46,0.95) inset !important;
            box-shadow: 0 0 0 1000px rgba(26,90,46,0.95) inset !important;
            caret-color: #fff;
        }

        .btn-send {
            width: 100%;
            background: linear-gradient(135deg, #1a7a2e, #38b558);
            border: none;
            color: #fff;
            border-radius: 12px;
            padding: 14px;
            font-size: 15px;
            font-weight: 800;
            cursor: pointer;
            transition: transform .15s, box-shadow .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 4px;
            letter-spacing: 0.3px;
        }
        .btn-send:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(44,158,71,.4); }
        .btn-send:active { transform: none; }

        .links {
            text-align: center;
            margin-top: 22px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .links a {
            color: rgba(255,255,255,0.45);
            font-size: 13px;
            text-decoration: none;
            transition: color .2s;
        }
        .links a:hover { color: #5cd17a; }

        .alert-error {
            background: rgba(220, 53, 69, 0.15);
            border: 1px solid rgba(220, 53, 69, 0.35);
            border-radius: 10px;
            color: #ff8a96;
            padding: 12px 16px;
            font-size: 13px;
            margin-bottom: 18px;
        }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="logo-pill">
            <div class="logo-box">BHX</div>
            <span class="logo-name">Bách Hóa XANH</span>
        </div>
        <a href="/" style="color:rgba(255,255,255,0.5); font-size:13px; text-decoration:none;">
            <i class="bi bi-house-door-fill"></i> Trang chủ
        </a>
    </div>

    <div class="main">
        <div class="card-wrap">
            <div class="card-icon">
                <i class="bi bi-key-fill"></i>
            </div>
            <div class="card-title">Quên mật khẩu?</div>
            <div class="card-sub">
                Nhập email đã đăng ký. Chúng tôi sẽ gửi mã xác thực 6 số về email của bạn.
            </div>

            <form method="post" id="forgotForm">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-error">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <span asp-validation-summary="All"></span>
                    </div>
                }

                <div>
                    <label class="field-label" for="Input_Email">Địa chỉ Email</label>
                    <div class="inp-wrap">
                        <i class="bi bi-envelope-fill inp-icon"></i>
                        <input asp-for="Input.Email" id="Input_Email" class="form-control"
                               autocomplete="email" placeholder="email@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" style="color:#ff8a96; font-size:12px;"></span>
                </div>

                <button type="submit" class="btn-send" id="sendBtn">
                    <i class="bi bi-send-fill"></i>
                    <span>Gửi mã xác thực</span>
                </button>
            </form>

            <div class="links">
                <a href="/Identity/Account/Login"><i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập</a>
                <a href="/"><i class="bi bi-house-door me-1"></i>Về Trang chủ</a>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('forgotForm').addEventListener('submit', function () {
            var btn = document.getElementById('sendBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi...';
        });
    </script>
</body>
</html>
