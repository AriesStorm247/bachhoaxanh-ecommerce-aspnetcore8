@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — Bách Hóa Xanh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #0d3320;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== TOP BAR ===== */
        .top-bar {
            padding: 16px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .logo-pill { display: flex; align-items: center; gap: 10px; }
        .logo-box {
            background: #fff;
            color: #1a7c3e;
            font-weight: 800;
            font-size: 16px;
            padding: 5px 12px;
            border-radius: 8px;
            letter-spacing: 2px;
        }
        .logo-name { color: rgba(255,255,255,0.8); font-size: 13px; }
        .top-bar-right { color: rgba(255,255,255,0.4); font-size: 12px; }

        /* ===== MAIN LAYOUT ===== */
        .main {
            flex: 1;
            display: flex;
            align-items: stretch;
            min-height: 580px;
        }

        /* ===== LEFT PANEL ===== */
        .left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 48px 52px;
            color: #fff;
        }
        .left-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 12px;
            color: rgba(255,255,255,0.7);
            margin-bottom: 28px;
            width: fit-content;
        }
        .left-dot {
            width: 7px; height: 7px;
            border-radius: 50%;
            background: #4ade80;
        }
        .left-h1 {
            font-size: 36px;
            font-weight: 700;
            line-height: 1.25;
            margin-bottom: 16px;
        }
        .left-h1 span { color: #4ade80; }
        .left-sub {
            font-size: 14px;
            color: rgba(255,255,255,0.5);
            line-height: 1.7;
            margin-bottom: 36px;
            max-width: 340px;
        }
        .feature-list { display: flex; flex-direction: column; gap: 14px; }
        .feature-item { display: flex; align-items: center; gap: 12px; }
        .feature-icon {
            width: 34px; height: 34px;
            border-radius: 8px;
            background: rgba(74,222,128,0.12);
            border: 1px solid rgba(74,222,128,0.2);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            font-size: 15px;
        }
        .feature-text { font-size: 13px; color: rgba(255,255,255,0.6); }

        /* ===== RIGHT PANEL ===== */
        .right-panel {
            width: 460px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 28px;
            background: rgba(255,255,255,0.03);
            border-left: 1px solid rgba(255,255,255,0.06);
        }

        /* ===== CARD ===== */
        .card {
            background: #fff;
            border-radius: 20px;
            width: 100%;
            max-width: 380px;
            overflow: hidden;
            border: none !important;
        }
        .card-head {
            background: #1a7c3e;
            padding: 28px 28px 22px;
        }
        .card-head h2 {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 4px;
        }
        .card-head p {
            font-size: 13px;
            color: rgba(255,255,255,0.65);
        }
        .card-body { padding: 26px 28px 30px; }

        /* ===== FORM ===== */
        .form-label {
            font-size: 11px;
            font-weight: 700;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
        }
        .input-wrap { position: relative; }
        .input-wrap .icon {
            position: absolute;
            left: 13px; top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: #bbb;
        }
        .form-control {
            border-radius: 10px;
            border: 1.5px solid #eee;
            padding: 11px 14px 11px 38px;
            font-size: 14px;
            background: #fafafa;
            transition: all 0.2s;
        }
        .form-control:focus {
            border-color: #1a7c3e;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(26,124,62,0.1);
            outline: none;
        }

        /* ===== REMEMBER + FORGOT ===== */
        .row-check {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .form-check-input { accent-color: #1a7c3e; }
        .form-check-label { font-size: 12px; color: #666; }
        .forgot { font-size: 12px; color: #1a7c3e; text-decoration: none; }
        .forgot:hover { text-decoration: underline; }

        /* ===== BUTTON ===== */
        .btn-bhx {
            width: 100%;
            background: #1a7c3e;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 13px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: 0.4px;
            transition: background 0.2s;
            margin-bottom: 18px;
        }
        .btn-bhx:hover { background: #155f30; color: #fff; }

        /* ===== DIVIDER + LINKS ===== */
        .divider-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }
        .divider-line { flex: 1; height: 1px; background: #f0f0f0; }
        .divider-text { font-size: 11px; color: #bbb; }
        .login-links { display: flex; flex-direction: column; gap: 9px; text-align: center; }
        .login-links a { font-size: 12px; color: #1a7c3e; text-decoration: none; }
        .login-links a:hover { text-decoration: underline; }

        /* ===== FOOTER ===== */
        .bhx-footer {
            background: rgba(0,0,0,0.2);
            text-align: center;
            padding: 14px;
            color: rgba(255,255,255,0.3);
            font-size: 11px;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            .left-panel { display: none; }
            .right-panel { width: 100%; border-left: none; }
        }

        /* ===== ADMIN 3-STEP VERIFICATION ===== */
        .admin-verify-box {
            background: linear-gradient(135deg, #fff8f8 0%, #fff 100%);
            border: 1.5px solid #ffcdd2 !important;
            border-radius: 12px;
        }
        .step-progress {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }
        .step-dot {
            width: 28px; height: 28px;
            border-radius: 50%;
            background: #e0e0e0;
            color: #aaa;
            font-size: 11px;
            font-weight: 800;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            transition: all 0.35s ease;
        }
        .step-dot.active  { background: #1a7c3e; color: #fff; box-shadow: 0 0 0 3px rgba(26,124,62,0.18); }
        .step-dot.done    { background: #4ade80; color: #fff; }
        .step-connector {
            flex: 1; height: 3px;
            background: #e0e0e0;
            margin: 0 5px;
            border-radius: 2px;
            transition: background 0.35s ease;
        }
        .step-connector.done { background: #4ade80; }
        .step-label-row {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #777;
            margin-bottom: 10px;
        }
        .step-label-row .step-num { color: #1a7c3e; }
        .admin-next-btn {
            width: 100%;
            background: #1a7c3e;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 9px 14px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 6px;
        }
        .admin-next-btn:hover { background: #155f30; }
        .admin-next-btn:disabled { background: #aaa; cursor: not-allowed; }
        .step-error {
            font-size: 12px;
            color: #e53935;
            margin-top: 5px;
            display: none;
        }
        .passcode-hint {
            font-size: 11px;
            color: #888;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
    </style>
</head>
<body>

    <div class="top-bar">
        <div class="logo-pill">
            <div class="logo-box">BHX</div>
            <span class="logo-name">Bách Hóa Xanh</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a href="/" class="btn btn-outline-light btn-sm rounded-pill px-3" style="font-size: 12px; font-weight: 700; border: 1.5px solid rgba(255,255,255,0.35); color: rgba(255,255,255,0.9); text-decoration: none; display: inline-flex; align-items: center; gap: 5px; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'; this.style.borderColor='rgba(255,255,255,0.6)'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.borderColor='rgba(255,255,255,0.35)'; this.style.color='rgba(255,255,255,0.9)';">
                <i class="bi bi-house-door"></i> Trang chủ
            </a>
            <span class="top-bar-right d-none d-sm-inline">Cần hỗ trợ? 1900 1908</span>
        </div>
    </div>

    <div class="main">

        <!-- LEFT -->
        <div class="left-panel">
            <div class="left-tag">
                <div class="left-dot"></div>
                Hệ thống đang hoạt động
            </div>
            <h1 class="left-h1">
                Chào mừng trở lại<br>với <span>Bách Hóa Xanh</span>
            </h1>
            <p class="left-sub">
                Đăng nhập để quản lý đơn hàng, theo dõi ưu đãi và mua sắm tiện lợi hơn mỗi ngày.
            </p>
            <div class="feature-list">
                <div class="feature-item">
                    <div class="feature-icon">💳</div>
                    <span class="feature-text">Thanh toán nhanh chóng &amp; bảo mật</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">🛒</div>
                    <span class="feature-text">Hàng ngàn sản phẩm tươi ngon mỗi ngày</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">🎁</div>
                    <span class="feature-text">Ưu đãi dành riêng cho thành viên</span>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="right-panel">
            <div class="card">
                <div class="card-head">
                    <h2>Đăng nhập</h2>
                    <p>Vui lòng nhập thông tin tài khoản</p>
                </div>
                <div class="card-body">
                    <form id="account" method="post">
                        @if (TempData["LockoutMessage"] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 p-3" style="border-radius:10px; font-size:13px; background:rgba(220,53,69,0.15); border:1px solid rgba(220,53,69,0.35); color:#ff8a96;">
                                <i class="bi bi-lock-fill"></i>
                                <span>@TempData["LockoutMessage"]</span>
                            </div>
                        }
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success d-flex align-items-center gap-2 mb-3 p-3" style="border-radius:10px; font-size:13px; background:rgba(56,181,88,0.12); border:1px solid rgba(56,181,88,0.3); color:#5cd17a;">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@TempData["SuccessMessage"]</span>
                            </div>
                        }
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <div class="input-wrap">
                                <span class="icon">✉</span>
                                <input asp-for="Input.Email" class="form-control"
                                       autocomplete="username" placeholder="example@email.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                            <div class="input-wrap">
                                <span class="icon">🔒</span>
                                <input asp-for="Input.Password" class="form-control"
                                       autocomplete="current-password" placeholder="••••••••" />
                            </div>
                        </div>

                        <div id="admin-verification-container"
                             style="display: @(ViewData["IsAdminLogin"]?.ToString() == "true" ? "block" : "none");"
                             class="mt-3 p-3 admin-verify-box">

                            <h6 class="fw-bold mb-3" style="color:#c62828; font-size:13px;">
                                <i class="bi bi-shield-lock-fill me-1"></i> Xác minh bảo mật Admin
                            </h6>

                            <!-- ─ Step progress indicator ─────────────────────────────── -->
                            <div class="step-progress">
                                <div class="step-dot active" id="step-dot-1">1</div>
                                <div class="step-connector"  id="step-bar-1"></div>
                                <div class="step-dot"        id="step-dot-2">2</div>
                                <div class="step-connector"  id="step-bar-2"></div>
                                <div class="step-dot"        id="step-dot-3">3</div>
                            </div>

                            <!-- ─ Bước 1: Toán học ────────────────────────────────── -->
                            <div id="verify-step-1">
                                <div class="step-label-row">
                                    <span class="step-num">Bước 1</span> / 3 — Câu hỏi toán học
                                </div>
                                <label class="form-label" style="font-size:12px; font-weight:700; color:#555;">
                                    Câu hỏi:
                                    <span id="math-question-text" class="fw-bold" style="color:#1a7c3e;">
                                        @ViewData["MathQuestion"]
                                    </span>
                                </label>
                                <input type="number" id="math-answer" class="form-control"
                                       placeholder="Nhập kết quả" autocomplete="off" />
                                <div class="step-error" id="step1-error"></div>
                                <button type="button" class="admin-next-btn" id="btn-step1-next">
                                    Tiếp theo &nbsp;<i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- ─ Bước 2: Captcha ─────────────────────────────────── -->
                            <div id="verify-step-2" style="display:none;">
                                <div class="step-label-row">
                                    <span class="step-num">Bước 2</span> / 3 — Mã Captcha
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div id="captcha-svg-container">
                                        @if (ViewData["CaptchaSvg"] != null)
                                        {
                                            @Html.Raw(ViewData["CaptchaSvg"])
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            id="btn-refresh-captcha" style="height:38px;"
                                            title="Làm mới captcha">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                                <input type="text" id="captcha-answer" class="form-control text-uppercase"
                                       placeholder="Nhập mã captcha" autocomplete="off" />
                                <div class="step-error" id="step2-error"></div>
                                <button type="button" class="admin-next-btn" id="btn-step2-next">
                                    Tiếp theo &nbsp;<i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- ─ Bước 3: Mật mã bảo mật ─────────────────────────── -->
                            <div id="verify-step-3" style="display:none;">
                                <div class="step-label-row">
                                    <span class="step-num">Bước 3</span> / 3 — Mật mã bảo mật
                                </div>
                                <label class="form-label" style="font-size:12px; font-weight:700; color:#555;">
                                    Nhập mật mã 6 chữ số
                                </label>
                                <input type="text" id="admin-passcode" name="AdminPasscode"
                                       class="form-control" maxlength="6"
                                       placeholder="••••••" autocomplete="one-time-code"
                                       inputmode="numeric" pattern="[0-9]{6}" style="-webkit-text-security: disc; text-security: disc;" />
                                <div class="step-error" id="step3-error"></div>
                                <div class="passcode-hint">
                                    <i class="bi bi-info-circle"></i>
                                    Nhập mật mã rồi nhấn nút Đăng nhập ngay bên dưới
                                </div>
                            </div>

                        </div>

                        <div class="row-check mb-3">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label asp-for="Input.RememberMe" class="form-check-label">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>
                            <a asp-page="./ForgotPassword" class="forgot">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn-bhx">
                            ➜ &nbsp;Đăng nhập ngay
                        </button>
                    </form>

                    <div class="divider-row">
                        <div class="divider-line"></div>
                        <span class="divider-text">hoặc</span>
                        <div class="divider-line"></div>
                    </div>

                    <div class="d-flex flex-column gap-2 mb-4">
                        <a href="javascript:void(0);" onclick="openOAuthPopup('/MockAuth/GoogleLogin')" class="btn btn-light border d-flex align-items-center justify-content-center gap-2 py-2 fw-bold shadow-sm" style="border-radius: 10px; font-size: 14px; color: #444; background: #fff; border: 1px solid #ddd !important; text-decoration: none;">
                            <i class="bi bi-google text-danger fs-5"></i> Đăng nhập bằng Google
                        </a>
                        <a href="javascript:void(0);" onclick="openOAuthPopup('/MockAuth/FacebookLogin')" class="btn btn-primary d-flex align-items-center justify-content-center gap-2 py-2 fw-bold shadow-sm" style="border-radius: 10px; font-size: 14px; background: #1877F2; border: none; color: #fff; text-decoration: none;">
                            <i class="bi bi-facebook fs-5"></i> Đăng nhập bằng Facebook
                        </a>
                    </div>

                    <div class="login-links">
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                            Chưa có tài khoản? Đăng ký ngay
                        </a>
                        <a asp-page="./ResendEmailConfirmation">
                            Gửi lại email xác nhận
                        </a>
                        <hr style="border-top: 1px dashed rgba(0,0,0,0.12); margin: 6px 0;" />
                        <a href="/" style="font-weight: 700; color: #1a7c3e; display: inline-flex; align-items: center; justify-content: center; gap: 5px;">
                            <i class="bi bi-arrow-left-circle"></i> Quay về Trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="bhx-footer">© 2025 Bách Hóa Xanh. Bảo lưu mọi quyền.</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openOAuthPopup(url) {
            const width = 500;
            const height = 650;
            const left = (window.innerWidth - width) / 2 + window.screenX;
            const top = (window.innerHeight - height) / 2 + window.screenY;
            
            window.isRedirecting = false;
            const popup = window.open(
                url,
                'OAuthPopup',
                `width=${width},height=${height},top=${top},left=${left},resizable=yes,scrollbars=yes,status=yes`
            );
            
            const timer = setInterval(() => {
                if (!popup || popup.closed) {
                    clearInterval(timer);
                    // Check if parent needs redirection or reload
                    if (!window.isRedirecting) {
                        window.location.reload();
                    }
                }
            }, 1000);
        }

        $(document).ready(function () {
            sessionStorage.removeItem('adminSessionActive');
            sessionStorage.removeItem('promoPopupShown');
            sessionStorage.removeItem('currentUserEmail');

            var emailInput       = $('#Input_Email');
            var container        = $('#admin-verification-container');
            var mathText         = $('#math-question-text');
            var captchaContainer = $('#captcha-svg-container');
            var lastValidEmail   = "";
            var isAdminUser      = false;
            var isVerificationVisible = false;

            // ────────── Step navigation ────────────────────────────────────────────
            function goToStep(s) {
                for (var i = 1; i <= 3; i++) {
                    var $dot = $('#step-dot-' + i);
                    $dot.removeClass('active done');
                    if (i < s)       { $dot.addClass('done').html('<i class="bi bi-check"></i>'); }
                    else if (i === s){ $dot.addClass('active').text(i); }
                    else             { $dot.text(i); }
                }
                for (var j = 1; j <= 2; j++) {
                    $('#step-bar-' + j).toggleClass('done', j < s);
                }
                $('#verify-step-1').toggle(s === 1);
                $('#verify-step-2').toggle(s === 2);
                $('#verify-step-3').toggle(s === 3);
            }

            function showAdminVerificationIfNeeded() {
                var password = $('#Input_Password').val();
                if (isAdminUser && password && password.length >= 8) {
                    if (!isVerificationVisible) {
                        $('#Input_Password').attr('autocomplete', 'new-password');
                        container.slideDown();
                        goToStep(1);
                        isVerificationVisible = true;
                        
                        if ($('#hidden-admin-email').length === 0) {
                            $('<input>').attr({
                                type: 'hidden',
                                id: 'hidden-admin-email',
                                name: 'Input.Email'
                            }).appendTo('#account');
                        }
                        $('#hidden-admin-email').val(lastValidEmail);
                        emailInput.attr('name', 'DummyEmail');
                    }
                } else {
                    container.slideUp();
                    isVerificationVisible = false;
                    $('#hidden-admin-email').remove();
                    emailInput.attr('name', 'Input.Email');
                }
            }

            // ────────── Form submit ───────────────────────────────────────────────
            $('#account').on('submit', function (e) {
                if (isAdminUser) {
                    var password = $('#Input_Password').val();
                    if (password && password.length >= 8) {
                        if (!isVerificationVisible) {
                            e.preventDefault();
                            showAdminVerificationIfNeeded();
                            return false;
                        }
                    }
                }

                if (isVerificationVisible && lastValidEmail !== "") {
                    emailInput.val(lastValidEmail);
                    if ($('#hidden-admin-email').length > 0) {
                        $('#hidden-admin-email').val(lastValidEmail);
                    }
                }
                sessionStorage.setItem('adminSessionActive', 'true');
            });

            // ────────── Check admin email ────────────────────────────────────
            function checkAdminEmail() {
                var email = emailInput.val();
                if (!email) {
                    isAdminUser = false;
                    container.slideUp();
                    isVerificationVisible = false;
                    lastValidEmail = "";
                    $('#hidden-admin-email').remove();
                    emailInput.attr('name', 'Input.Email');
                    return;
                }

                if (lastValidEmail === email) {
                    return;
                }

                $.getJSON('?handler=CheckAdmin&email=' + encodeURIComponent(email), function (data) {
                    if (data.isAdmin) {
                        isAdminUser = true;
                        lastValidEmail = email;
                        
                        mathText.text(data.mathQuestion);
                        captchaContainer.html(data.captchaSvg);
                        $('#math-answer').val('');
                        $('#captcha-answer').val('');
                        $('#admin-passcode').val('');
                        
                        showAdminVerificationIfNeeded();
                    } else {
                        isAdminUser = false;
                        lastValidEmail = "";
                        container.slideUp();
                        isVerificationVisible = false;
                        $('#hidden-admin-email').remove();
                        emailInput.attr('name', 'Input.Email');
                        $('#Input_Password').attr('autocomplete', 'current-password');
                    }
                });
            }

            emailInput.on('blur change input', function () {
                var isFocused = (document.activeElement === emailInput[0]);
                if (!isFocused && lastValidEmail !== "") {
                    if (emailInput.val() !== lastValidEmail) {
                        emailInput.val(lastValidEmail);
                    }
                    return;
                }
                
                var val = $(this).val();
                
                if (lastValidEmail !== "" && isFocused) {
                    lastValidEmail = val;
                    if ($('#hidden-admin-email').length > 0) {
                        $('#hidden-admin-email').val(val);
                    }
                }
                
                if (val && val.indexOf('@@') > 0) {
                    checkAdminEmail();
                } else {
                    if (isFocused) {
                        isAdminUser = false;
                        container.slideUp();
                        isVerificationVisible = false;
                        lastValidEmail = "";
                        $('#hidden-admin-email').remove();
                        emailInput.attr('name', 'Input.Email');
                    }
                }
            });

            $('#Input_Password').on('blur change', function () {
                showAdminVerificationIfNeeded();
            });

            if (emailInput.val() && emailInput.val().indexOf('@@') > 0) {
                checkAdminEmail();
            }

            // If returned from POST with admin box visible, start at step 1
            if (container.is(':visible')) {
                goToStep(1);
                lastValidEmail = emailInput.val();
                isAdminUser = true;
                isVerificationVisible = true;
                if ($('#hidden-admin-email').length === 0) {
                    $('<input>').attr({
                        type: 'hidden',
                        id: 'hidden-admin-email',
                        name: 'Input.Email'
                    }).appendTo('#account');
                }
                $('#hidden-admin-email').val(lastValidEmail);
                emailInput.attr('name', 'DummyEmail');
                $('#Input_Password').attr('autocomplete', 'new-password');
            }

            // ────────── Step 1: Validate math ─────────────────────────────────
            $('#btn-step1-next').click(function () {
                var ans = $.trim($('#math-answer').val());
                if (!ans) {
                    $('#step1-error').text('Vui lòng nhập kết quả.').show();
                    return;
                }
                $('#step1-error').hide();
                var $btn = $(this).prop('disabled', true).text('Kiểm tra...');

                $.getJSON('?handler=ValidateStep1&answer=' + encodeURIComponent(ans), function (data) {
                    if (data.valid) {
                        goToStep(2);
                        $('#captcha-answer').val('').focus();
                    } else {
                        $('#step1-error').text(data.message || 'Kết quả không đúng.').show();
                        $('#math-answer').val('').focus();
                    }
                }).always(function () {
                    $btn.prop('disabled', false).html('Tiếp theo &nbsp;<i class="bi bi-arrow-right"></i>');
                });
            });

            $('#math-answer').on('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); $('#btn-step1-next').click(); }
            });

            // ────────── Step 2: Captcha ──────────────────────────────────────
            $('#btn-refresh-captcha').click(function () {
                $.getJSON('?handler=RefreshCaptcha', function (data) {
                    captchaContainer.html(data.captchaSvg);
                    $('#captcha-answer').val('').focus();
                });
            });

            $('#btn-step2-next').click(function () {
                var ans = $.trim($('#captcha-answer').val());
                if (!ans) {
                    $('#step2-error').text('Vui lòng nhập mã captcha.').show();
                    return;
                }
                $('#step2-error').hide();
                var $btn = $(this).prop('disabled', true).text('Kiểm tra...');

                $.getJSON('?handler=ValidateStep2&answer=' + encodeURIComponent(ans), function (data) {
                    if (data.valid) {
                        goToStep(3);
                        $('#admin-passcode').val('').focus();
                    } else {
                        if (data.captchaSvg) captchaContainer.html(data.captchaSvg);
                        $('#step2-error').text(data.message || 'Mã captcha không đúng.').show();
                        $('#captcha-answer').val('').focus();
                    }
                }).always(function () {
                    $btn.prop('disabled', false).html('Tiếp theo &nbsp;<i class="bi bi-arrow-right"></i>');
                });
            });

            $('#captcha-answer').on('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); $('#btn-step2-next').click(); }
            });

            // ────────── Step 3: Passcode Enter triggers submit ────────────────
            $('#admin-passcode').on('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); $('#account').submit(); }
            });
        });
    </script>
</body>
</html>