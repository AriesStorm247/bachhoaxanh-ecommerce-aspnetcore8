@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    @if (Model.IsPermanent)
    {
        <p class="text-danger">Tài khoản của bạn đã bị khóa vĩnh viễn, vui lòng liên hệ qua email: Anhmuoi270280@gmail.com để biết thêm chi tiết</p>
    }
    else
    {
        <p class="text-danger">This account has been locked out, please try again later.</p>
    }
</header>
